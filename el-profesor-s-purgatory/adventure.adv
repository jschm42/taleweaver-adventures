  "npcs": [
    {
      "id": "VALDERRAMA",
      "entity_type": "NPC",
      "name": "Señor Valderrama",
      "description": "A slender man in a sharp tweed jacket with suede elbow patches, dark circles under his eyes, and a mustache trimmed with geometric precision. He clutches a mug of cold espresso like a shield against bad syntax.",
      "appearance": "middle-aged Hispanic professor, tweed jacket, neat mustache, tired eyes, holding coffee mug",
      "current_scene_id": "ROOM_404",
      "spatial_position": "standing behind the lectern near the endless green chalkboard",
