  "protagonist": {
    "name": "Mateo Vance",
    "role": "Chronically Unprepared Spanish 101 Student",
    "description": "A sleep-deprived sophomore wearing a wrinkled hoodie and carrying a persistent aura of academic panic. You fell asleep during a lecture on the past subjunctive and woke up in a surreal linguistic nightmare.",
    "goal": "Collect all three Badges of Approval from the portal simulations, bind them into an Approval Portfolio, and pass Señor Valderrama's oral exam to wake up.",
    "character": "Resourceful, sarcastic under pressure, prone to panic-guessing verb endings, deeply motivated by the desire to never see another conjugation chart.",
