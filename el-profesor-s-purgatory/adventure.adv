    {
      "id": "LUCIA",
      "entity_type": "NPC",
      "name": "Lucía the Hall Monitor",
      "description": "A pale, intensely caffeinated former student wearing three overlapping 'PERFECTIONIST' sashes. She has been trapped in Room 404 since 2017 after mixing up 'por' and 'para' on her final exam.",
      "appearance": "intense female student, glasses, neat cardigan, hall monitor sash, clutching flashcards",
      "current_scene_id": "ROOM_404",
      "spatial_position": "crouched beside the wobbly student desks in the back row",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_lucia_c6fff9e8.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Guards the CHEAT_LOCKBOX. If asked or bribed with SMUGGLED_CHURRO, she reveals that the lockbox combination is the exact Spanish word for 'embarrassed' (AVERGUENZADO) or gives the hint that the Lost Property Cabinet in the Post Office uses the number of octopuses in the Fish Market (7) followed by the form number on the Post Office chairs (302) -> 7302.",
      "goal": "Obtain a warm, cinnamon-dusted smuggled churro to remember the taste of the outside world.",
      "character": "Neurotic, hyper-pedantic, whispers verb conjugations under her breath, easily bribed with fried dough. When given a warm, cinnamon-dusted smuggled churro, she reveals the exact combination for the cheat lockbox: 'PENA. Four letters—the noun, not AVERGUENZADO. Precision matters!' Any reference in her notes to AVERGUENZADO as the combination is a mistake she corrects with this clue.",
      "hp": 70,
      "max_hp": 70,
      "mana": 50,
      "max_mana": 50,
      "stamina": 80,
      "max_stamina": 80,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      }
    },
    {
      "id": "CARMEN",
      "entity_type": "NPC",
      "name": "Abuela Carmen",
      "description": "A formidable fishmonger in a rubber apron splattered with scales. Her forearm muscles could crush a coconut, and her glare has made grown tourists weep in three dialects.",
      "appearance": "stout older Spanish woman, rubber apron, silver hair bun, stern expression, holding cleaver",
      "current_scene_id": "FISH_MARKET",
      "spatial_position": "behind the central ice counter beside the glistening red snappers",
