  "scenes": [
    {
      "id": "ROOM_404",
      "label": "Room 404: The Chalkboard Hub",
      "description": "A surreal, windowless classroom suspended in an academic void. The green chalkboard stretches impossibly wide, covered in jagged diagrams of irregular preterite stems. Three shimmering portals hum along the walls: a sea-foam green rift smelling of salt and scales, a fluorescent yellow rift echoing with ticket dispensers, and a velvet-red rift radiating soap-opera tension. A fourth heavy oak door at the back is sealed by a glowing grammatical ward.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_873dd443.jpg",
      "decorative_objects": [
        "endless green chalkboard",
        "wobbly student desks",
        "clock reading SIEMPRE",
        "overhead projector",
        "withered potted cactus",
        "motivational poster of Don Quixote"
      ],
      "on_enter_scene_script": "if tw.player.has_item('SURVIVAL_BADGE') and tw.player.has_item('POSTAL_BADGE') and tw.player.has_item('DRAMA_BADGE') and not tw.vars.get('all_badges_hint', False):\n    tw.vars.set('all_badges_hint', True)\n    tw.story.show_message('Valderrama raises an eyebrow: You have all three badges. Combine them into your Approval Portfolio so we can finish this.')",
      "on_enter_scene_text": "The fluorescent tubes buzz overhead in judgmental harmony.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "FISH_MARKET",
      "label": "El Mercado de Mariscos",
      "description": "A deafening, wet stone market hall somewhere on a hyper-saturated Spanish coast. Crushed ice covers the tiled floor, and the air is thick with the tang of lemon, brine, and aggressive commerce. Suspended from the iron rafters are exactly 7 gilded ceramic octopuses. A massive stall dominated by glistening red snappers sits center stage, flanked by a brass bargaining bell and a weathered wooden crate.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_094c67db.jpg",
      "decorative_objects": [
        "7 gilded ceramic octopuses hanging from rafters",
        "crushed ice piles",
        "wet terracotta floor tiles",
        "strings of dried garlic",
        "neon sign shaped like a prawn",
        "scales and gutting knives"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A wave of salty air and rapid-fire coastal dialect hits you like a wet mackerel.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "POST_OFFICE",
      "label": "La Oficina de Correos",
      "description": "A brutalist temple of Madrid bureaucracy. Endless rows of beige plastic chairs face a thick plexiglass counter where numbers flash on a broken LED board in non-sequential order. The air smells of dry paper, old glue, and crushed optimism. On the wall, a pneumatic dispatch console hums beside a heavy steel strongbox bolted to the marble counter. A metal door at the rear leads to the sorting annex.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_4e6f59d0.jpg",
      "decorative_objects": [
        "broken LED queue display",
        "rows of beige plastic chairs",
        "chained ballpoint pens",
        "stacks of Form 302-B",
        "flickering fluorescent tube",
        "framed portrait of a stern postmaster"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A ticket dispenser clicks somewhere in the distance, followed by a collective groan from unseen ghosts.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SORTING_ANNEX",
      "label": "El Anexo de Clasificación",
      "description": "The claustrophobic backroom of the post office, stacked floor-to-ceiling with canvas mailbags from 1984 and pneumatic brass tubes that hiss unpredictably. In the corner sits a rusted Lost Property Cabinet secured with a four-digit dial lock, and a cluttered sorting table dusted with dried sealing wax.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_98dd0cac.jpg",
      "decorative_objects": [
        "canvas mailbags from 1984",
        "hissing brass pneumatic tubes",
        "wooden pigeonhole shelves",
        "spilled rubber stamps",
        "dusty desk lamp"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Pneumatic canisters rattle through the overhead pipes like caffeinated squirrels.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "TELENOVELA_CHURCH",
      "label": "La Iglesia de las Lágrimas",
      "description": "A candlelit baroque chapel dialed up to maximum melodrama. Wind machines blow rose petals down the aisle despite the room being completely indoors. Dramatic string music swells from nowhere. Near the altar stands a velvet-draped reliquary chest, a live broadcast objection microphone on a brass stand, and a panicked groom sweating through his tuxedo.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_f55c28db.jpg",
      "decorative_objects": [
        "hidden indoor wind machines",
        "swirling red rose petals",
        "towering brass candelabra",
        "stained glass window of a weeping heart",
        "velvet kneeler",
        "dramatic spotlight"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "An invisible orchestra hits a scandalous minor chord as wind machines ruffle your hair.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "WAKING_DESK",
      "label": "The Sunlit Lecture Hall (Reality)",
      "description": "The oppressive neon gloom of Purgatory dissolves into warm afternoon sunlight streaming through tall university windows. The chalkboard holds normal, non-glowing homework assignments. Your backpack rests beside a normal wooden desk, and the door to the campus quad stands wide open.",
      "image_url": "assets/el-profesors-purgatory-ar-66ymz4e4_scene_4047ee70.jpg",
      "decorative_objects": [
        "sunlit glass windows",
        "normal wooden lecture desk",
        "chalk tray with white dust",
        "wall clock showing 3:15 PM",
        "open door to the quad"
      ],
      "on_enter_scene_script": "tw.vars.set('escaped_purgatory', True)",
      "on_enter_scene_text": "Warm afternoon sunlight floods your vision as the surreal nightmare finally breaks!",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
