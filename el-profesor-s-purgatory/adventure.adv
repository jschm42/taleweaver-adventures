  "sequences": [
    {
      "id": "SEQ_1_HUB_AND_MARKET",
      "order": 1,
      "title": "Chapter 1: Cold Coffee and Fresh Snapper",
      "description": "The player awakens in Room 404 under Señor Valderrama's watchful gaze, learns the rules of linguistic purgatory, optionally unlocks the Perfectionist's Lockbox or gets the Smuggled Churro, and enters the Fish Market portal to win the first badge.",
      "walkthrough": "1. Read the ##CLASS_HANDBOOK in your inventory to learn the 4-letter word 'PENA' (embarrassment/shame) and the rules for combining badges.\n2. (Optional Side Quest) Unlock ##CHEAT_LOCKBOX in ROOM_404 using code 'PENA' to obtain ##CHEAT_SHEET, or unlock ##VENDING_NICHE with ##CAFETERIA_TOKEN to get ##SMUGGLED_CHURRO for Lucía.\n3. Enter FISH_MARKET via the sea-foam green portal.\n4. Read ##MARKET_SIGN (or ##CHEAT_SHEET) to learn the polite courtesy word 'QUISIERA' (and note the 7 gilded ceramic octopuses on the rafters).\n5. Operate ##BARGAINING_BELL (or unlock ##FISH_CRATE directly) with code 'QUISIERA' to open ##FISH_CRATE.\n6. Take ##SURVIVAL_BADGE (and ##RED_SNAPPER) from ##FISH_CRATE to complete the sequence.",
      "end_condition": "",
      "required_item_id": "SURVIVAL_BADGE",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 1: Survive El Mercado de Mariscos and claim the Sello de Supervivencia.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the Sello de Supervivencia in hand, one portal's trial is complete!"
    },
    {
      "id": "SEQ_2_POST_OFFICE",
      "order": 2,
      "title": "Chapter 2: Circular 302 and the Pneumatic Tube",
      "description": "The player tackles the bureaucratic nightmare of La Oficina de Correos, explores the Sorting Annex to properly label a parcel, and optionally recovers Valderrama's lost red grading pen.",
      "walkthrough": "1. Return to ROOM_404 and enter POST_OFFICE through the fluorescent yellow portal.\n2. Read ##POSTAL_SIGN and pick up ##BLANK_PARCEL from the waiting chairs.\n3. Go through the employee door into SORTING_ANNEX and pick up ##ADDRESS_LABEL from the sorting table.\n4. (Optional Side Quest) Unlock ##LOST_PROPERTY_CABINET in SORTING_ANNEX using code '7302' (7 gilded octopuses from the Fish Market + Circular 302 from the Post Office sign/chairs) and take ##RED_PEN.\n5. Combine ##BLANK_PARCEL and ##ADDRESS_LABEL to craft ##ADDRESSED_PARCEL.\n6. Return to POST_OFFICE and operate ##DISPATCH_SWITCH (or unlock ##RECEIPT_STRONGBOX) while holding ##ADDRESSED_PARCEL.\n7. Take ##POSTAL_BADGE from ##RECEIPT_STRONGBOX to complete the sequence.",
      "end_condition": "",
      "required_item_id": "POSTAL_BADGE",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 2: Navigate La Oficina de Correos and earn the Sello de Correos.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "Doña Inés stamps your soul with bureaucratic approval. Two badges down, one to go!"
    },
    {
      "id": "SEQ_3_TELENOVELA",
      "order": 3,
      "title": "Chapter 3: Tears in the Subjunctive Mood",
      "description": "The player steps into the velvet-red portal to interrupt Alejandro's melodramatic telenovela wedding using the present subjunctive.",
      "walkthrough": "1. Return to ROOM_404 and enter TELENOVELA_CHURCH through the velvet-red portal.\n2. Pick up and read ##WEDDING_RUBRIC on the front pew (or check ##CLASS_HANDBOOK) to learn that the required 4-letter present subjunctive form of 'casarse' is 'CASE'.\n3. Activate ##OBJECTION_MICROPHONE (or unlock ##DRAMA_RELIQUARY directly) using the code 'CASE'.\n4. Open ##DRAMA_RELIQUARY and take ##DRAMA_BADGE to complete the sequence.",
      "end_condition": "",
      "required_item_id": "DRAMA_BADGE",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 3: Stop the wedding in La Iglesia de las Lágrimas with flawless subjunctive grammar!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The invisible studio audience erupts into applause as you claim the third badge!"
    },
    {
      "id": "SEQ_4_FINAL_EXAM",
      "order": 4,
      "title": "Chapter 4: The Final Oral Exam",
      "description": "With all three badges collected, the player binds them into the Approval Portfolio, presents it at Room 404's sealed oak door, and steps out into the sunlit lecture hall to wake up.",
      "walkthrough": "1. Combine ##SURVIVAL_BADGE, ##POSTAL_BADGE, and ##DRAMA_BADGE to construct ##APPROVAL_PORTFOLIO.\n2. Return to ROOM_404 (if not already there).\n3. Unlock the heavy oak door leading to WAKING_DESK using ##APPROVAL_PORTFOLIO.\n4. Traverse the unlocked oak door into WAKING_DESK to complete the adventure and wake up!",
      "end_condition": "",
      "required_item_id": "APPROVAL_PORTFOLIO",
      "required_scene_id": "WAKING_DESK",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Final Chapter: Combine the three badges into your Approval Portfolio and unlock the oak door in Room 404!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You step through the oak doorway into the warm afternoon sun—free from Spanish Purgatory!"
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_VALDERRAMA_PEN_REACTION",
      "name": "Valderrama Reacts to His Red Pen",
      "trigger": "on_enter_scene",
      "target_id": "ROOM_404",
      "target": null,
      "code": "if tw.player.has_item('RED_PEN') and not tw.vars.get('pen_praised', False):\n    tw.vars.set('pen_praised', True)\n    tw.player.modify_xp(50)\n    tw.story.show_message('Señor Valderrama spots his Red Grading Pen in your hand. A single tear of pure academic joy rolls down his cheek. \"Mi bolígrafo... Excelente trabajo, Señor Vance. (+50 XP)\"')",
      "description": "Grants bonus XP and narration when returning to Room 404 with Valderrama's Red Pen."
    },
    {
      "id": "SCRIPT_LUCIA_CHURRO_HINT",
      "name": "Lucia Reacts to the Smuggled Churro",
      "trigger": "on_interact",
      "target_id": "LUCIA",
      "target": null,
      "code": "if tw.player.has_item('SMUGGLED_CHURRO') and not tw.vars.get('churro_shared', False):\n    tw.vars.set('churro_shared', True)\n    tw.story.show_message('Lucía inhales the cinnamon aroma of your Smuggled Churro and whispers frantically: \"The lockbox code under my desk is PENA! And the Post Office locker code is 7302!\"')",
      "description": "Lucia gives away the exact lockbox and cabinet codes when interacted with while holding the Smuggled Churro."
    },
    {
      "id": "SCRIPT_SNAPPER_IN_CLASS",
      "name": "Bringing a Fish to Class",
      "trigger": "on_enter_scene",
      "target_id": "ROOM_404",
      "target": null,
      "code": "if tw.player.has_item('RED_SNAPPER') and not tw.vars.get('fish_commented', False):\n    tw.vars.set('fish_commented', True)\n    tw.story.show_message('Señor Valderrama pinches the bridge of his nose as the smell of your Prized Red Snapper fills Room 404. \"I asked for a badge, Señor Vance, not bouillabaisse.\"')",
      "description": "Humorous reaction from Valderrama when the player brings the Red Snapper into Room 404."
    }
  ]
}