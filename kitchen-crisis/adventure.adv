  "protagonist": {
    "name": "Alex Miller",
    "role": "The Only Semi-Functional Miller",
    "description": "A sleep-deprived young adult wearing a faded band t-shirt and worn sneakers. Armed only with common sense and a desperate desire to stay in Grandma Edith's will, Alex is the sole defense against total domestic collapse.",
    "goal": "Bake the Legendary Casserole, pacify the chaotic family, lock out Neighbor Kevin, and set the fine china before Grandma Edith arrives at 7:00 PM.",
    "character": "Pragmatic, sarcastic, resourceful under absurd domestic pressure, and fiercely motivated by inheritance money.",
    "appearance": "young adult, messy hair, faded black band t-shirt, worn jeans, tired eyes, determined expression",
