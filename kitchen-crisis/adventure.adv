      "on_protagonist_enters_scene_text": "'We need to pivot the paradigm before seven o'clock!' Mom barks at her phone, before glaring at you. 'Alex! Why isn't the table set?!'"
    },
    {
      "id": "GRANDPA_JOE",
      "entity_type": "NPC",
      "name": "Grandpa Joe",
      "description": "An octogenarian veteran wearing fuzzy tartan slippers and a cardigan, practically fused into the living room cushions. He cups a hand to his ear while yelling commentary at the television screen.",
      "appearance": "elderly man, white hair, thick spectacles, brown knit cardigan, tartan slippers, grumpy expression",
      "current_scene_id": "LIVING_ROOM",
      "spatial_position": "sunk deep into the center of the plaid ##COUCH",
      "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_grandpa-joe_8ed93c21.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "LIVING_ROOM"
      ],
      "notes": "Refuses to lower the TV volume or budge from the couch cushions until given WORKING_REMOTE. Once given WORKING_REMOTE, he turns down the volume and shifts aside, allowing access to the couch cushions or revealing secrets.",
      "goal": "Switch the TV channel to Channel 4 ('Victory at Sea') and adjust the volume once he has a working remote. He freely allows the player to search the couch cushions from the outset, grumbling that any loose batteries they find had better go toward fixing his remote; receiving the working remote is never a prerequisite for searching. His old 'remote first' instruction applies only to changing the channel and volume, not to searching the cushions or taking the loose batteries.",
      "character": "Cantankerous, half-deaf, nostalgic, surprisingly sharp about family secrets and historical dates.",
      "hp": 60,
      "max_hp": 60,
      "mana": 0,
      "max_mana": 0,
      "stamina": 50,
      "max_stamina": 50,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 0
      },
      "on_protagonist_enters_scene_text": "'WHAT?! SPEAK UP! THIS STUPID CLICKER IS DEAD AND I'M STUCK ON COMMERCIALS!' Grandpa Joe bellows over the roaring TV."
    },
    {
      "id": "NEIGHBOR_KEVIN",
      "entity_type": "NPC",
      "name": "Neighbor Kevin",
      "description": "A lanky man in a neon tracksuit with an unsettlingly wide grin. He hovers near the kitchen back door holding an empty Tupperware container, hoping to 'borrow' half of the family dinner.",
      "appearance": "lanky man, thirties, neon teal tracksuit, wide goofy grin, receding blonde hair",
      "current_scene_id": "KITCHEN",
      "spatial_position": "loitering shamelessly beside the kitchen back door",
