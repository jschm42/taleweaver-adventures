  "adventure": {
    "origin_id": "0265025e-583b-410c-a962-20a9558cd795",
    "title": "Kitchen Crisis",
    "teaser": "One hour until Grandma Edith arrives. The casserole is frozen, the microwave is on fire. Good luck.",
    "cover_appearance": "chaotic suburban kitchen, smoking microwave, frozen casserole dish, wall clock at 6 PM, warm comic",
    "version": "3.0.0",
    "creator": "Jean Schmitz",
    "copyright": "Copyright (c) 2026 by Jean Schmitz",
    "license": "CC BY-NC 4.0",
    "license_url": "https://creativecommons.org/licenses/by-nc/4.0/",
    "language": "English",
    "original_prompt": "It's 6:00 PM at the Miller household. In exactly one hour, Grandma Edith — the matriarch with a clipboard for a soul — will ring the doorbell expecting a hot Legendary Casserole, a functional family, and the fine china. Right now, the casserole is frozen solid, the microwave is smoking, Dad is 'optimizing' the sink with a banana, Mom is having a corporate breakdown over speakerphone, Grandpa is welded to the couch demanding war documentaries at lethal volume, and Neighbor Kevin keeps materializing through the back door like a sitcom poltergeist. You — the only semi-functional Miller — must thaw the casserole, neutralize the chaos, pacify Grandpa with the TV remote (which needs batteries hidden in the couch cushions), and lock Kevin out before the doorbell rings. Survive the evening, get your allowance, and maybe stay in the will.",
    "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_cover_7cf9b000.jpg",
    "rule_enforcement_mode": "story",
    "time_per_turn": 5,
