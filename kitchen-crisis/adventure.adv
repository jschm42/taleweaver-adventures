    {
      "id": "DAD_ARTHUR",
      "entity_type": "NPC",
      "name": "Dad (Arthur Miller)",
      "description": "A middle-aged man in a stained 'Kiss the Cook' apron and khaki shorts. He is currently elbow-deep in the kitchen sink, convinced that a ripe Cavendish ##BANANA acts as a natural gasket seal for the garbage disposal.",
