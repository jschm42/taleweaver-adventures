  "sequences": [
    {
      "id": "SEQ_1_SMOKE_AND_TOOLS",
      "order": 1,
      "title": "Chapter 1: Smoke in the Kitchen",
      "description": "Alex begins in the Front Hallway at 6:00 PM and must head into the Kitchen to stop the smoking microwave, retrieve Dad's ##WRENCH, and open the jammed Junk Drawer to find the ##OVEN Plug and WD-40.",
      "walkthrough": "1. Read the ##CHORE_LIST in your starting inventory for an overview of the four household objectives.\n2. Move south from HALLWAY to KITCHEN.\n3. Interact with the ##SMOKING_MICROWAVE to switch it from SMOKING to OFF.\n4. Pick up the ##WRENCH lying on the kitchen floor by Dad.\n5. Use the ##WRENCH to unlock the jammed ##JUNK_DRAWER.\n6. Take the ##OVEN_PLUG and ##WD40_CAN from inside the ##JUNK_DRAWER.",
      "end_condition": "",
      "required_item_id": "OVEN_PLUG",
      "required_scene_id": "KITCHEN",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "tw.vars.get('microwave_off') == True",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "The clock strikes 6:00 PM! First priority: get into the kitchen before the microwave sets off the fire department.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the microwave silenced and the Oven Plug in hand, you are ready to tackle the casserole and the rest of the house!"
    },
    {
      "id": "SEQ_2_OPERATION_CASSEROLE",
      "order": 2,
      "title": "Chapter 2: Baking the Legendary Casserole",
      "description": "With the ##OVEN Plug recovered from the Junk Drawer, Alex must retrieve the backup Frozen Casserole from the ##FRIDGE, read the ##FRIDGE Note for the first half of the Lockbox PIN, and combine the Frozen Casserole with the ##OVEN Plug to bake the Hot Casserole.",
      "walkthrough": "1. In the KITCHEN, read the ##FRIDGE_NOTE on the front of the ##FRIDGE to learn the first two digits of the Hallway Lockbox PIN ('19') and the crafting hint.\n2. Open the ##FRIDGE and take the ##FROZEN_CASSEROLE (plus optional ##COLD_COFFEE and ##LEFTOVER_PIE).\n3. Combine ##FROZEN_CASSEROLE and ##OVEN_PLUG to craft and reveal the ##HOT_CASSEROLE, then pick up the ##HOT_CASSEROLE.",
      "end_condition": "",
      "required_item_id": "HOT_CASSEROLE",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Time to rescue dinner! Check the fridge for the backup casserole and get that oven running.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The aroma of bubbling Legendary Casserole fills the kitchen! Two major crises remain: Grandpa's TV and Neighbor Kevin."
    },
    {
      "id": "SEQ_3_SILENCING_THE_LIVING_ROOM",
      "order": 3,
      "title": "Chapter 3: Sonic Warfare in the Living Room",
      "description": "Alex heads into the Booming Living Room to find the missing pieces of the TV remote, assemble the Working Remote to pacify Grandpa Joe, and read Grandpa's TV Guide to learn both the second half of the Hallway Lockbox PIN ('44') and the China Cabinet riddle solution ('CLOCK').",
      "walkthrough": "1. Move from KITCHEN to HALLWAY, then west into LIVING_ROOM.\n2. Read the ##TV_GUIDE_MAGAZINE on the coffee table to learn the last two digits of the Hallway Lockbox PIN ('44', making the full code '1944') and the 5-letter riddle password for the China Cabinet ('CLOCK').\n3. Search the plaid ##COUCH to take the ##LOOSE_BATTERIES wedged in the cushions.\n4. Pick up the ##DEAD_REMOTE from beside MITTENS_THE_CAT by the radiator.\n5. Combine ##DEAD_REMOTE and ##LOOSE_BATTERIES to craft the ##WORKING_REMOTE, pacifying Grandpa Joe and restoring peace to the living room.",
      "end_condition": "",
      "required_item_id": "WORKING_REMOTE",
      "required_scene_id": "LIVING_ROOM",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "The living room walls are shaking from Grandpa's war documentary. Find the remote and batteries before Grandma hears it from three blocks away!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "Peace and quiet at last! Grandpa Joe is happily watching Channel 4 at a reasonable volume."
    },
    {
      "id": "SEQ_4_LOCKDOWN_AND_FINE_CHINA",
      "order": 4,
      "title": "Chapter 4: Banishing Kevin & Setting the China",
      "description": "In the final stretch before 7:00 PM, Alex unlocks the Hallway Lockbox using the 4-digit PIN (1944) to get the Spare Key, locks the Kitchen Back Door to keep Neighbor Kevin out, and enters the Dining Room to unlock the China Cabinet (code: CLOCK) and set the table with the Fine China.",
      "walkthrough": "1. Return to the HALLWAY and unlock the ##HALL_LOCKBOX using the 4-digit code '1944' (from the ##FRIDGE Note '19' + TV Guide '44').\n2. Take the ##SPARE_KEY from inside the ##HALL_LOCKBOX.\n3. Head into the KITCHEN and interact with the ##BACK_DOOR switch using the ##SPARE_KEY to switch it from UNLOCKED to LOCKED, banishing Neighbor Kevin.\n4. Enter the DINING_ROOM (either via the butler's pantry from the Kitchen, or by unlocking the Hallway French doors with the ##WD40_CAN).\n5. Unlock the ##CHINA_CABINET using the 5-letter riddle answer 'CLOCK'.\n6. Pick up the ##EMPTY_PLATE (Heirloom Fine China Plates) from the ##CHINA_CABINET to set the table and complete all preparations before Grandma Edith rings the doorbell!",
      "end_condition": "",
      "required_item_id": "EMPTY_PLATE",
      "required_scene_id": "DINING_ROOM",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.vars.get('casserole_baked') == True and tw.vars.get('grandpa_pacified') == True",
      "completion_guard_expression": "tw.vars.get('casserole_baked') == True and tw.vars.get('grandpa_pacified') == True and tw.vars.get('kevin_locked_out') == True and tw.vars.get('table_set') == True",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Only minutes remain until 7:00 PM! Unlock the hallway key safe, lock Kevin out of the kitchen, and set the fine china in the dining room!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "DING-DONG! Right as the last porcelain plate touches the mahogany table, Grandma Edith rings the front doorbell. The house is quiet, the casserole is hot, and your spot in the will is secure!"
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_INIT_CRISIS",
      "name": "Initialize Domestic Crisis Timer",
      "trigger": "on_init",
      "target_id": null,
      "target": null,
      "code": "tw.vars.set('minutes_left', 60)\ntw.vars.set('microwave_off', False)\ntw.vars.set('casserole_baked', False)\ntw.vars.set('grandpa_pacified', False)\ntw.vars.set('kevin_locked_out', False)\ntw.vars.set('table_set', False)",
