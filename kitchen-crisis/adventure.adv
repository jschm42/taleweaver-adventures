  "scenes": [
    {
      "id": "HALLWAY",
      "label": "Front Hallway",
      "description": "A narrow suburban entryway wallpapered in faded floral patterns. The heavy front door stands at the north end like a sealed vault gate awaiting Grandma Edith's fateful knock at 7:00 PM. Framed family photos line the walls alongside a small wall-mounted key lockbox and a cluttered side table. Passages lead west into the booming living room, east into the tense dining room, and south toward the smoke-filled kitchen.",
      "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_scene_12b53285.jpg",
      "decorative_objects": [
        "grandfather clock showing 6:00 PM",
        "framed family portraits",
        "frayed welcome mat",
        "brass coat rack",
        "floral wallpaper",
        "heavy front door"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The grandfather clock ticks loudly, reminding you of Grandma Edith's impending arrival.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "KITCHEN",
      "label": "Disaster Kitchen",
      "description": "The epicenter of the Miller family crisis. Grey smoke curls lazily from a blackened microwave on the counter. By the sink, tools and tropical fruit are scattered in a bizarre engineering project. A massive stainless-steel ##FRIDGE hums in the corner next to a classic gas ##OVEN and a cluttered junk drawer. At the back of the room, a screen door leads out to the backyard, its brass deadbolt gleaming.",
      "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_scene_ed9f3d40.jpg",
      "decorative_objects": [
        "greasy linoleum floor",
        "granite countertop",
        "dripping kitchen sink",
        "magnetic knife strip",
        "floral dish towels",
        "overhead fluorescent light"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The smell of scorched aluminum foil and warm banana fills your nostrils.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "LIVING_ROOM",
      "label": "Booming Living Room",
      "description": "The air in this room physically vibrates from the massive television set blasting a black-and-white naval battle documentary at ear-splitting volume. A sagging plaid ##COUCH dominates the center of the room, surrounded by a shag rug, a dusty coffee table, and a towering bookshelf. An orange tabby cat lounges near the radiator, completely unbothered by the sonic artillery.",
      "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_scene_ebaa1a29.jpg",
      "decorative_objects": [
        "blaring CRT television",
        "green shag carpet",
        "oak coffee table",
        "brick fireplace",
        "potted fern",
        "warm radiator"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A deafening cannonade from the TV documentary rattles your fillings.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "DINING_ROOM",
      "label": "High-Stress Dining Room",
      "description": "A formal room dominated by a polished mahogany dining table and an imposing glass-fronted china cabinet. Papers, spreadsheets, and coffee mugs are strewn across one end of the table like a miniature corporate war room. A framed needlepoint sampler hangs crookedly on the wall above a sideboard, while a heavy velvet curtain conceals a recessed wall alcove.",
      "image_url": "assets/kitchen-crisis-argon-copy-zylczspv_scene_e40c7e19.jpg",
      "decorative_objects": [
        "polished mahogany dining table",
        "crystal chandelier",
        "framed needlepoint sampler",
        "velvet window drapes",
        "mahogany chairs",
        "brass candlestick holders"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The sharp clicks of frantic pacing echo across the hardwood floor.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
