    {
      "id": "SCRIPT_KITCHEN_SMOKE_HAZARD",
      "name": "Microwave Smoke Hazard",
      "trigger": "on_turn_end",
      "target_id": null,
      "target": null,
      "code": "if tw.scene.id == 'KITCHEN' and not tw.vars.get('microwave_off', False):\n    tw.player.damage(5)\n    tw.story.show_message('Thick grey smoke from the sparking microwave makes your eyes water! (-5 HP — shut off the SMOKING_MICROWAVE!)')",
      "description": "Deals minor stress/smoke damage each turn spent in the kitchen while the microwave is still smoking."
    },
    {
      "id": "SCRIPT_KEVIN_COMMENTARY",
      "name": "Neighbor Kevin Pesters Player",
      "trigger": "on_enter_scene",
      "target_id": "KITCHEN",
      "target": null,
      "code": "if not tw.vars.get('kevin_locked_out', False):\n    tw.npcs.say('NEIGHBOR_KEVIN', 'Ooh, is that tuna casserole I smell, or burnt wiring? Either way, save me a corner piece!')\nelse:\n    tw.story.show_message('Outside the locked back door, Neighbor Kevin waves wistfully through the glass before wandering back to his yard.')",
      "description": "Triggers Neighbor Kevin's sitcom commentary when entering the kitchen depending on whether the back door is locked."
    }
