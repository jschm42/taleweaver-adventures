  "scenes": [
    {
      "id": "DUSTY_ENTRYWAY",
      "label": "Dusty Entryway",
      "description": "A vaulted stone chamber choked with fallen masonry and thick cobwebs. At the northern wall stands a massive circular Vault Door forged of blackened iron and brass, featuring a deep heart-shaped indentation in its center. A rough stone archway to the south descends into damp shadows.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_8dc80131.jpg",
      "decorative_objects": [
        "collapsed ceiling shaft high above",
        "carved stone gargoyle heads",
        "shattered oil lanterns",
        "piles of limestone rubble",
        "faded alchemical mural"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Dust swirls around your boots as the massive Vault Door looms silently to the north.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "VERMIN_PITS",
      "label": "Vermin Pits",
      "description": "A sunken, foul-smelling cistern where green alchemical sludge seeps from cracked pipes along the walls. Mutated bones and shredded cloth litter the slick floor. Corridors branch north back toward the entryway, east toward the smell of woodsmoke, and west toward a rusted iron grate.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_6399a236.jpg",
      "decorative_objects": [
        "cracked铜-green drainage pipes",
        "gnawed animal bones",
        "puddles of luminescent green ooze",
        "rusted wall chains",
        "broken wooden scaffolding"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The stench of wet fur and mutagenic waste hits your nostrils.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "FUNGAL_GROTTO",
      "label": "Bioluminescent Fungal Grotto",
      "description": "A damp natural cavern annexed by the alchemist for cultivating subterranean flora. Towering stalks of glowing blue mushrooms cast an eerie twilight over stone planter beds and a trickle of mineral-rich water.",
      "image_url": "assets/05bbbffa-74f2-41d2-9fee-0800afc21590_scene_44639175.jpg",
      "decorative_objects": [
        "three towering azure mushroom stalks",
        "cracked stone planter troughs",
        "trickling mineral spring",
        "glowing spore clouds",
        "rusted gardening trowel"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Soft blue spores drift lazily through the cool, humid air.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SCAVENGER_ENCAMPMENT",
      "label": "Scavenger Encampment",
      "description": "Awide subterranean plaza where goblin scavengers have pitched crude hide tents around a sputtering firepit. Stolen crates and salvaged alchemical glassware are heaped in messy piles. Passages lead west to the pits, south to the fortified barracks, and north toward a heavy brass-bound door.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_abfacdd8.jpg",
      "decorative_objects": [
        "sputtering campfire with roasting spit",
        "patchwork leather tents",
        "heaps of bent brass gears",
        "painted goblin totem poles",
        "empty potion bottles"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Smoke from the goblin firepit curls toward the vaulted ceiling.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "GOBLIN_BARRACKS",
      "label": "Goblin Barracks",
      "description": "Formerly the guards' quarters of the Folly, this long hall is crammed with lice-ridden straw bunks, weapon racks, and a makeshift quartermaster's booth. To the east, a skull-adorned archway leads to the Inner Sanctum, blocked by a heavy portcullis controlled by wall mechanisms.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_e1b9c108.jpg",
      "decorative_objects": [
        "four iron wall sconces burning with pitch",
        "rickety wooden bunk beds",
        "crudely painted靶 target board",
        "scattered dice and bone tokens",
        "dented iron helmets"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The smell of unwashed goblin and cheap ale hangs thick in the barracks.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "ALCHEMIST_LABORATORY",
      "label": "Alchemist's Laboratory",
      "description": "Master Argon's private sanctum of science and madness. Copper alembics, coiled glass condensers, and shelves of preserved specimens line the walls. A spectral chill permeates the room, centering around a grand distillation table in the middle of the floor.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_f6236876.jpg",
      "decorative_objects": [
        "seven brass alembic stills on the central bench",
        "shattered homunculus incubation tube",
        "chalkboard covered in arcane equations",
        "mounted two-headed bat specimen",
        "hanging astrolabe"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The air hums with residual arcane energy and the faint scent of ozone.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "INNER_SANCTUM",
      "label": "Inner Sanctum",
      "description": "A grand, domed ritual chamber at the heart of the Folly. Chieftain Grothak has turned the raised alchemical dais into a crude throne piled with skulls and velvet cushions. Ruby light pulses from braziers flanking the dais.",
      "image_url": "assets/the-alchemists-folly-argo-gzjnuzzg_scene_bb979103.jpg",
      "decorative_objects": [
        "throne of scrap iron and velvet",
        "twin crimson flame braziers",
        "cracked marble ritual circle",
        "tattered tapestries of Master Argon",
        "piles of tarnished copper coins"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Crimson firelight dances across the domed ceiling as Grothak's domain opens before you.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SURFACE",
      "label": "Sunlit Surface Outcrop",
      "description": "Beyond the massive Vault Door lies a mossy stone staircase ascending into a pine-scented mountain ravine. Fresh wind sweeps across the cliffside, and warm sunlight banishes the damp chill of the Alchemist's Folly forever.",
      "image_url": "assets/scene_1345d0f0_surface_surface_surface_0aed5e71-ccc8-4e2a-805e-0398e654469a_scene_e4ad9e5b.jpg",
      "decorative_objects": [
        "ancient pine trees",
        "moss-covered boundary stones",
        "clear mountain stream",
        "wheel of an abandoned wagon"
      ],
      "on_enter_scene_script": "tw.story.show_message('You step out into the blinding, glorious light of the surface world!')",
      "on_enter_scene_text": "Fresh mountain air fills your lungs as the Vault Door grinds open behind you.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
