      "on_defeat_script": "tw.vars.set('grothak_defeated', True)\ntw.player.give_item('CRIMSON_TEAR')\ntw.story.show_message('Grothak crashes to the dais! You wrench the glowing Crimson Tear from his iron chain.')",
      "on_defeat_text": "'Impossible... the Tear... was supposed to make me immortal...' Grothak wheezes as his throne room falls silent.",
