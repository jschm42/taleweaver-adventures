    {
      "id": "GOBLIN_SCOUT_SNIKT",
      "entity_type": "NPC",
      "name": "Goblin Scout Snikt",
      "description": "A wiry, nervous goblin wearing oversized brass goggles on his forehead and a patchwork cloak. He keeps glancing anxiously toward the Vermin Pits.",
      "appearance": "skinny goblin scout, brass goggles on forehead, tattered cloak, big pointed ears, nervous grin",
      "current_scene_id": "SCAVENGER_ENCAMPMENT",
      "spatial_position": "warming his hands by the sputtering firepit",
      "image_url": "assets/npc_7bf73f6d_goblin-scout-snikt_goblin-scout-snikt_goblin-scout-snikt_0aed5e71-ccc8-4e2a-805e-0398e654469a_goblin-scout-snikt_9a8c0a8b.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows that the Scavenger Chest is unlocked with a 4-digit code calculated from the Folly's architecture: first two digits are the number of azure mushroom stalks in the Fungal Grotto multiplied by the seven brass alembic stills in the Laboratory (3 * 7 = 21), and the last two digits are written on the Goblin Ledger (45), making 2145. Will gladly explain this or hand over his Picklock Set if persuaded, intimidated, or given Goblin Grunt Rations.",
      "goal": "Survive his scouting shift without getting eaten by Bitey or beaten by Chieftain Grothak, and maybe trade information for shiny gear or rations.",
      "character": "Cowardly, talkative, easily bribed or intimidated, and resentful of Quartermaster Snaggle.",
