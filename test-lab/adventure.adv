    {
      "id": "TRAINING_GUARD",
      "entity_type": "NPC",
      "name": "Training Guard Harlan",
      "description": "A disciplined, broad-shouldered guard wearing padded brigandine and a dented training helm. Before combat he calmly explains that the sparring bout only begins when you attack him. In a fight he uses melee strikes and defensive stances.",
      "appearance": "broad-shouldered human guard, dented iron training helm, padded brigandine, training sword and buckl",
      "current_scene_id": "COMBAT_ARENA",
      "spatial_position": "standing on the west side of the padded combat mat",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_training-guard_80389636.jpg",
