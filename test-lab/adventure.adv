  "scripts": [
    {
      "id": "SCRIPT_SOCIAL_POISON_TICK",
      "name": "Social Hall Ongoing Poison Tick",
      "trigger": "on_logic_pass_done",
      "target": "*",
      "code": "if tw.vars.get(\"social_hall_poison_active\", False) and tw.scene.id == \"SOCIAL_HALL\":\n    living = [npc for npc in tw.scene.npcs if not npc.is_defeated and not npc.is_hidden]\n    if living:\n        for npc in living:\n            npc.damage(6)\n        tw.story.system(\n            \"Ongoing poison tick: the lingering green test-toxin deals 6 poison damage to all NPCs in the Conversation Hall.\"\n        )\n        tick_count = tw.vars.get(\"social_poison_tick_idx\", 0)\n        speaker_npc = living[tick_count % len(living)]\n        tw.vars.set(\"social_poison_tick_idx\", tick_count + 1)\n        tw.npcs.say_directed(\n            speaker_npc.id,\n            \"coughs or sparks and complains in character about the ongoing poison fumes still draining everyone's health until someone presses the heal button on the Test Panel\",\n        )\n",
      "priority": 100,
      "is_active": true
    }
  ],
  "init_script": "tw.vars.set(\"vera_greeted\", True)\ntw.story.direct(\n    \"Narrate how Vera the Reception Bot\u2014a thoroughly exhausted, sarcastic chrome android slumped behind the reception desk\u2014lets out a loud, static-laced mechanical sigh as Alex Vale arrives in the Entry Hall, tapping her clipboard with a metallic finger.\"\n)\ntw.npcs.say_directed(\n    \"RECEPTION_BOT\",\n    \"in an extremely annoyed, deadpan sarcastic tone, welcomes Alex to the Test-Lab, briefly explains that this is not a dramatic fantasy quest but a modular QA testing facility where each room tests a different engine feature (NPC conversations, locks and crafting, switches, riddles, combat, and teleporters), and tells Alex to click the FAQ Info Console on her desk for details instead of asking her questions\",\n)\n\n\ndef rooster_crow(event=None):\n    rooster = tw.npcs.get(\"NPC_ROOSTER\")\n    if rooster.is_with_player:\n        rooster.say(\"KIKERIKIII! COCK-A-DOODLE-DOO! 06:00 AM! Dawn has broken over the timeline!\")\n        tw.story.direct(\"Barnaby the Chrono-Rooster flaps his brass clockwork wings vigorously, his pendulum tail clicking as his loud morning crow echoes through the lab.\")\n    else:\n        tw.story.direct(\"From down the corridor toward the Time Machine Lab, the faint, metallic crowing of a mechanical rooster echoes through the facility.\")\n\n\ndef cat_meow(event=None):\n    cat = tw.npcs.get(\"NPC_CAT\")\n    if cat.is_with_player:\n        cat.say(\"MREEEOW! MIAUUUU! It is 18:00! Dusk has fallen! Where is my temporal salmon?!\")\n        tw.story.direct(\"Schr\u00f6dinger the Dusk Cat stretches lazily on the warm tachyon coil, purring like a miniature turbine before letting out a demanding evening meow.\")\n    else:\n        tw.story.direct(\"From the direction of the Time Machine Lab, a faint, muffled feline meow echoes through the facility.\")\n\n\ndef paradox_alarm(event=None):\n    tw.story.system(\"=== TEMPORAL PARADOX ALERT ===\")\n    chronos = tw.npcs.get(\"PROF_CHRONOS\")\n    if chronos.is_with_player:\n        tw.story.direct(\"Amber strobe lights flash across the vaulted ceiling as an emergency klaxon sounds in the Time Machine Lab!\")\n        chronos.say_directed(\"in a comically panicked scholarly voice, yells that the ten-minute paradox countdown has reached zero and checks three pocket watches at once to make sure reality hasn't folded in half\")\n    else:\n        tw.story.direct(\"An emergency klaxon wails faintly in the distance from the Time Machine Lab, accompanied by the muffled scholarly panic of Professor Chronos.\")\n\n\nif not tw.time.has_timer(\"ROOSTER_MORNING\"):\n    tw.time.every(\"24h\", rooster_crow, timer_id=\"ROOSTER_MORNING\", start=1320)\n\nif not tw.time.has_timer(\"CAT_EVENING\"):\n    tw.time.every(\"24h\", cat_meow, timer_id=\"CAT_EVENING\", start=600)"
}