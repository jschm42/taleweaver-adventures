  "npcs": [
    {
      "id": "BRAM",
      "entity_type": "NPC",
      "name": "Bram Ironhand",
      "description": "A broad mechanic with a braided beard, burn scars, and a battered leather apron. Blunt and protective, he is quick to admit a mistake when shown solid evidence. He insists he had the key in his pocket all morning and finds Nora's certainty irritating.",
      "appearance": "broad-shouldered mechanic, braided beard, burn scars on forearms, battered leather apron",
      "current_scene_id": "SOCIAL_HALL",
      "spatial_position": "seated on the east side of the round oak table",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_bram_fe3ecf86.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'Ask me straight. I'll answer straight.'",
      "goal": "Defend his account that he held the key all morning while staying open to concrete proof.",
      "character": "Blunt, practical, protective, and honest; dislikes pedantic nitpicking.",
      "hp": 80,
      "max_hp": 80,
      "mana": 0,
      "max_mana": 0,
      "stamina": 80,
      "max_stamina": 80,
      "voice": "onwK4e9ZLuTAKqWW03F9",
      "is_attackable": false,
      "is_killable": true,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 40
      },
      "on_interact_script": "on_social_npc_interact('BRAM')",
      "on_receive_item_script": "on_social_npc_receive_item('BRAM', received_item_ids)"
    },
    {
      "id": "GARGOYLE_GRIMSBY",
      "entity_type": "NPC",
      "name": "Grimsby the Gargoyle",
      "description": "An animated stone gargoyle bust mounted above the secret door. Once the paranoid guild master's guardian, now his riddle keeper. Grimsby poses the casket riddle, judges every pull of the lever and breathes poison gas on apprentices who get it wrong.",
      "appearance": "weathered grey stone gargoyle bust, curled horns, cracked sneering jaw, mossy ears",
      "current_scene_id": "ALCHEMY_LAB",
      "spatial_position": "mounted on the wall above the secret door",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_gargoyle-grimsby_96753d09.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Watch apprentices fail the guild master's casket riddle and mock them for it.",
      "character": "Sarcastic, condescending, darkly humorous; bored after centuries on the wall; secretly pleased when someone is clever, but would never admit it.",
      "hp": 200,
      "max_hp": 200,
      "voice": "custom:cPoqAvGWCPfCfyPMwe4z",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "attack_mode": "PASSIVE",
        "special_actions": []
      },
      "on_interact_script": "if tw.vars.get(\"lab_solved\"):\n    tw.npcs.say(LAB_GARGOYLE, \"You solved it. Once. By luck. Go away and let me brood.\")\nelse:\n    tw.dialog.tree(LAB_GARGOYLE_TALK, speaker=\"Grimsby the Gargoyle\")"
    },
    {
      "id": "GRANDMA",
      "entity_type": "NPC",
      "name": "Grandma Gertrude",
      "description": "A gnarly, cantankerous old grandmother in a floral bathrobe and thick knitted slippers, sitting stubbornly in a plush floral TV armchair with knitting needles in one hand and a crumpled TV guide in the other.",
      "appearance": "gnarly old grandma in floral TV armchair, hair curlers, thick glasses, knitted shawl",
      "current_scene_id": "TELEPORT_LAB",
      "spatial_position": "sitting in her plush floral TV armchair on the raised metal platform",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_grandma_074ac262.jpg",
      "is_hidden": true,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Get back to her living room television before her favorite show is over.",
      "character": "Grumpy, bewildered, sharp-tongued, and deeply outraged about being interrupted right in the middle of her favorite television show.",
      "hp": 45,
      "max_hp": 45,
      "mana": 0,
      "max_mana": 0,
      "stamina": 40,
      "max_stamina": 40,
      "voice": "pFZP5JQG7iQjIQuC4Bku",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_receive_item_script": "tw.npcs.say_directed('GRANDMA', 'squints through her bifocals, taps the item against the arm of her recliner, and grumbles that unless it can switch the television back to the Great Lab Baking Championship, it is entirely useless to her')"
    },
    {
      "id": "LAB_RAT",
      "entity_type": "NPC",
      "name": "Lab Rat",
      "description": "A slightly singed, bewildered white laboratory rat with twitching whiskers and a tiny numbered brass ear tag, smelling faintly of ozone after an unintended trip through the teleporter.",
      "appearance": "small white laboratory rat, twitching pink nose, slightly singed fur, tiny brass ear tag",
      "current_scene_id": "TELEPORT_LAB",
      "spatial_position": "crouching in the center of the raised metal platform",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_lab-rat_e18d4070.jpg",
      "is_hidden": true,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Find a quiet corner away from sparking electrodes and hopefully a crumb of cheese.",
      "character": "Timid, bewildered, and perpetually sniffing for cheese; squeaks indignantly when exposed to interdimensional physics.",
      "hp": 10,
      "max_hp": 10,
      "mana": 0,
      "max_mana": 0,
      "stamina": 20,
      "max_stamina": 20,
      "voice": "N2lVS1w4EtoT3dr4eOWO",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_receive_item_script": "tw.npcs.say_directed('LAB_RAT', 'sniffs the item with rapid whisker twitches, emits a high-pitched appreciative squeak, and nudges it closer to its nest')"
    },
    {
      "id": "NORA",
      "entity_type": "NPC",
      "name": "Nora Quill",
      "description": "An older archivist in ink-stained sleeves, with a meticulous bun and round spectacles. Precise, courteous, and skeptical, she asks for sources and speaks in carefully qualified sentences. She believes the workshop door was open earlier and distrusts Bram's memory.",
      "appearance": "older woman archivist, meticulous gray bun, round spectacles, ink-stained sleeves, vest",
      "current_scene_id": "SOCIAL_HALL",
      "spatial_position": "seated on the north side of the round oak table",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_nora_513a7e06.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'I wrote down what I saw, not what I thought I saw.'",
      "goal": "Verify exact observations about the workshop door and record accurate testimony.",
      "character": "Precise, courteous, skeptical, and methodical; speaks in carefully qualified sentences.",
      "hp": 60,
      "max_hp": 60,
      "mana": 20,
      "max_mana": 20,
      "stamina": 60,
      "max_stamina": 60,
      "voice": "XB0fDUnXU5powFXDhCwa",
      "is_attackable": false,
      "is_killable": true,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
