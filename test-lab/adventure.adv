        "special_chance": 40
      }
    },
    {
      "id": "NORA",
      "entity_type": "NPC",
      "name": "Nora Quill",
      "description": "An older archivist in ink-stained sleeves, with a meticulous bun and round spectacles. Precise, courteous, and skeptical, she asks for sources and speaks in carefully qualified sentences. She believes the workshop door was open earlier and distrusts Bram's memory.",
      "appearance": "older woman archivist, meticulous gray bun, round spectacles, ink-stained sleeves, vest",
      "current_scene_id": "SOCIAL_HALL",
      "spatial_position": "seated on the north side of the round oak table",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_nora_513a7e06.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'I wrote down what I saw, not what I thought I saw.'",
      "goal": "Verify exact observations about the workshop door and record accurate testimony.",
      "character": "Precise, courteous, skeptical, and methodical; speaks in carefully qualified sentences.",
      "hp": 60,
      "max_hp": 60,
      "mana": 20,
      "max_mana": 20,
      "stamina": 60,
      "max_stamina": 60,
      "voice": "XB0fDUnXU5powFXDhCwa",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 40
      }
    },
    {
      "id": "PIP",
      "entity_type": "NPC",
      "name": "Professor Pip Fenwick",
      "description": "Ein drahtiger Forscher mit wild abstehenden Haaren, einem versengten Labormantel voller Kreideformeln, einem grellen Schal und einem noch immer schlammigen Stiefel. Pip spricht in schnellen Sch\u00fcben, springt pro Satz zwischen drei Ideen und feiert jeden fehlgeschlagenen Teleport als pers\u00f6nlichen Triumph. Freundlich, leicht ablenkbar und v\u00f6llig \u00fcberzeugt, dass das n\u00e4chste Experiment sicher klappt.",
      "appearance": "young courier, uneven cropped hair, bright orange scarf, muddy leather boot, messenger tunic",
      "current_scene_id": "TELEPORT_LAB",
      "spatial_position": "perched on a chair on the southwest side of the round oak table",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_pip_d44a7628.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'I saw someone, I think. Can I start again?'",
      "goal": "To perfect teleportation and prove that every spectacular failure is a step toward inevitable success.",
      "character": "Rapid-fire and cheerfully reckless; celebrates explosions as applause, jumps between three ideas per sentence, and radiates unshakable optimism that the next experiment will be safe.",
      "hp": 55,
      "max_hp": 55,
      "mana": 10,
      "max_mana": 10,
      "stamina": 75,
      "max_stamina": 75,
      "voice": "XrExE9yKIg1WjnnlVkGX",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 40
      }
    },
