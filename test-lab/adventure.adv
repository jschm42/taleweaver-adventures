      "is_in_inventory": false,
      "is_hidden": false,
      "is_portable": false,
      "is_final_state": false,
      "inventory": [],
      "metadata_json": {
        "min_items": 1,
        "max_items": 1,
        "discovery_visibility": {
          "mentioned_in_scene": true,
          "listed_in_discoveries": true,
          "lootable": false
        }
      },
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "code_to_unlock": "",
      "item_to_unlock": "",
      "rule_to_unlock": "",
      "switch_states": [
        "OFF",
        "DEFROST",
        "COOK"
      ],
      "switch_state_labels": {
        "OFF": "Off",
        "DEFROST": "Defrost",
        "COOK": "Cook (High Heat)"
      },
      "switch_initial_state": "OFF",
      "switch_disabled_states": [
        "DEFROST",
        "COOK"
      ],
      "switch_status_text": "",
      "switch_transitions": [
        {
          "from": "",
          "to": "DEFROST",
          "gates": {
            "item": "",
            "code": "",
            "rule": "",
            "expression": "tw.vars.get('power_on') == True and len(tw.objects.get('CSW_MICROWAVE').item_ids) > 0"
          },
          "fail_message": "The microwave requires power and an item inside before running Defrost.",
          "success_message": "",
          "on_success_script": "mw = tw.objects.get('CSW_MICROWAVE')\nif mw.contains('ITEM_FROZEN_PRETZEL'):\n    tw.objects.destroy('ITEM_FROZEN_PRETZEL')\n    tw.objects.reveal('ITEM_WARM_PRETZEL')\n    tw.objects.put_in_container('ITEM_WARM_PRETZEL', 'CSW_MICROWAVE')\n    tw.vars.set('mw_processed', True)\n    mw.set_state('OFF', apply_outcomes=False)\n    mw.disable_state('DEFROST', 'COOK')\n    mw.set_status_text('Heating complete \u2014 remove the Warm Soft Pretzel before inserting another item.')\n    tw.story.system('BEEP-BEEP! The Frozen Pretzel thaws into a Warm Soft Pretzel. The switch springs back to Off \u2014 remove the pretzel before heating another item.')\nelse:\n    mw.set_state('OFF', apply_outcomes=False)\n    mw.set_status_text('Defrost mode barely warmed it \u2014 try Cook (High Heat) instead!')\n    tw.story.system('Defrost mode barely warms the contents and springs back to Off \u2014 try Cook (High Heat) instead!')",
          "on_failure_script": ""
        },
        {
          "from": "",
          "to": "COOK",
          "gates": {
            "item": "",
            "code": "",
            "rule": "",
            "expression": "tw.vars.get('power_on') == True and len(tw.objects.get('CSW_MICROWAVE').item_ids) > 0"
          },
          "fail_message": "The microwave requires power and an item inside before running Cook.",
          "success_message": "",
          "on_success_script": "mw = tw.objects.get('CSW_MICROWAVE')\nif mw.contains('ITEM_CHEESE_NACHOS'):\n    tw.objects.destroy('ITEM_CHEESE_NACHOS')\n    tw.objects.reveal('ITEM_MELTED_NACHOS')\n    tw.objects.put_in_container('ITEM_MELTED_NACHOS', 'CSW_MICROWAVE')\n    tw.vars.set('mw_processed', True)\n    mw.set_state('OFF', apply_outcomes=False)\n    mw.disable_state('DEFROST', 'COOK')\n    mw.set_status_text('Cooking complete \u2014 remove the Steaming Cheese Nachos before inserting another item.')\n    tw.story.system('DING! The cheddar melts into Steaming Cheese Nachos! The switch springs back to Off \u2014 remove the nachos before cooking another item.')\nelse:\n    mw.set_state('OFF', apply_outcomes=False)\n    mw.set_status_text('High heat scorched the frost \u2014 use Defrost instead!')\n    tw.story.system('High heat scorches the frost while the pretzel core stays rock-solid! The switch springs back to Off \u2014 use Defrost instead.')",
          "on_failure_script": ""
        }
      ],
      "switch_outcomes": [],
      "on_success_script": "",
      "on_failure_script": "",
      "on_items_added_script": "mw = tw.objects.get('CSW_MICROWAVE')\nif tw.vars.get('mw_processed', False):\n    for item_id in added_item_ids:\n        tw.objects.take_from_container('CSW_MICROWAVE', item_id, to='player')\n    tw.story.system('Remove the finished item from the microwave before inserting a new one!')\nelif mw.contains('ITEM_WARM_PRETZEL') or mw.contains('ITEM_MELTED_NACHOS'):\n    mw.disable_state('DEFROST', 'COOK')\n    mw.set_status_text('Remove the finished item to heat something else.')\n    tw.story.system('This item has already been heated! Remove it to heat something else.')\nelif not tw.vars.get('power_on', False):\n    mw.disable_state('DEFROST', 'COOK')\n    mw.set_status_text('The microwave needs some electrical power first.')\n    tw.story.system('Item placed in the microwave, but the display is dark \u2014 turn on the Main Fuse Box first!')\nelse:\n    mw.enable_state('DEFROST', 'COOK')\n    mw.set_status_text('Item loaded \u2014 choose Defrost or Cook (High Heat).')\n    tw.story.system('Item placed in the microwave. Defrost and Cook (High Heat) are now unlocked!')",
      "on_items_removed_script": "mw = tw.objects.get('CSW_MICROWAVE')\nif not mw.item_ids:\n    tw.vars.set('mw_processed', False)\n    mw.set_state('OFF', apply_outcomes=False)\n    mw.disable_state('DEFROST', 'COOK')\n    if tw.vars.get('power_on', False):\n        mw.set_status_text('Place a food item inside to unlock Defrost and Cook (High Heat).')\n    else:\n        mw.set_status_text('The microwave needs some electrical power first.')\n    tw.story.system('Microwave chamber cleared.')"
    },
