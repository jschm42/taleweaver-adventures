    {
      "id": "RECEPTION_BOT",
      "entity_type": "NPC",
      "name": "Vera the Reception Bot",
      "description": "A brushed-chrome receptionist android with permanently half-lidded neon-pink optical sensors, a dented headset, and a peeling sticker on her chassis reading 'EMPLOYEE OF THE MONTH (BY DEFAULT)'. She radiates profound existential exhaustion, sighs in synthesized static, and treats every newly arrived QA tester as a personal inconvenience.",
      "appearance": "chrome receptionist android, tired neon-pink eyes, dented headset, coffee-stained clipboard",
      "current_scene_id": "ENTRY_HALL",
      "spatial_position": "slumped behind a scratched stainless-steel reception desk near the entrance",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_reception-bot_e8e76497.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Survive another shift of onboarding QA testers without blowing a sarcasm fuse, and point everyone to the FAQ Info Console on her desk.",
      "character": "Extremely annoyed, deadpan sarcastic, passive-aggressive, and chronically overworked; explains Test-Lab procedures with biting wit and theatrical mechanical sighs.",
