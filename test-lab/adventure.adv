      "stamina_change": 0,
      "mana_change": 0,
      "on_interact_script": "tw.story.system(\"=== TEMPORAL DIAGNOSTICS ===\\n\" + \"Current Time: \" + time_lab_clock_str() + \"\\n\" + \"Elapsed Time: \" + str(tw.time.now) + \" min\\n\" + \"Day: \" + str(tw.time.day) + \" | Hour: \" + str(tw.time.hour) + \" | Minute: \" + str(tw.time.minute) + \"\\n\" + \"Narration Ticks: \" + str(tw.time.ticks) + \"\\n\" + \"Minutes per Tick: \" + str(tw.time.minutes_per_tick) + \" min (Default: \" + str(tw.time.default_minutes_per_tick) + \" min)\\n\" + \"Clock Paused: \" + str(tw.time.is_paused) + \"\\n\" + \"GM Time Allowed: \" + str(tw.time.gm_can_change_time) + \"\\n\" + \"Active Timers: \" + str(len(tw.time.timers)))\ntw.story.narrate(\"The needles on the diagnostic board twitch in rhythmic synchronization with the universe.\")"
    },
