    },
    {
      "id": "NPC_CAT",
      "entity_type": "NPC",
      "name": "Schr\u00f6dinger the Dusk Cat",
      "description": "A sleek tortoiseshell feline curled up on a warm tachyon radiator. She wears a miniature brass chronometer collar that glows soft amber. She sleeps nearly all day, waking only when evening dusk strikes at 18:00 to demand her temporal dinner.",
      "appearance": "sleek tortoiseshell cat, glowing amber collar with miniature brass clock, emerald eyes",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_npc-cat_30ab42e5.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Sleep on the warm tachyon coil until exactly 18:00, then demand temporal salmon.",
      "character": "Aloof, sleepy, demanding, vocal only when it is 18:00 dinner time.",
      "hp": 20,
      "max_hp": 20,
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "on_interact_script": "if tw.time.hour == 18:\n    tw.npcs.say(\"NPC_CAT\", \"MREEEOW! MIAUUU! It is 18:00! Dusk has fallen! Where is my temporal fish dinner?!\")\n    tw.story.narrate(\"Schr\u00f6dinger rubs vigorously against your shins, her amber chronometer collar chiming insistently.\")\nelse:\n    tw.npcs.say(\"NPC_CAT\", \"Purrrr... Wake me at 18:00. Not a minute earlier... (\" + time_lab_clock_str() + \")\")\n    tw.story.narrate(\"Schr\u00f6dinger opens one lazy slit of an emerald eye, turns around on the warm tachyon coil, and goes back to sleep.\")"
    },
    {
      "id": "NPC_ROOSTER",
      "entity_type": "NPC",
      "name": "Barnaby the Chrono-Rooster",
      "description": "A brass-plated mechanical rooster perched upon an ornate copper weather-vane stand. His tail feathers are miniature pendulums and his internal alarm is permanently synchronized to crow at exactly 06:00 in the morning.",
      "appearance": "brass clockwork rooster, pendulum tail feathers, polished copper comb, glowing yellow eyes",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_npc-rooster_dc66604f.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Crow faithfully at 06:00 every single morning without fail.",
      "character": "Punctual, pompous, proud, easily offended if someone calls him a common chicken.",
      "hp": 20,
      "max_hp": 20,
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "on_interact_script": "if tw.time.hour == 6:\n    tw.npcs.say(\"NPC_ROOSTER\", \"KIKERIKI! COCK-A-DOODLE-DOO! Right on time! It is 06:00 in the morning!\")\n    tw.story.narrate(\"Barnaby puffs his polished brass feathers proudly, his pendulum tail swinging at top speed.\")\nelse:\n    tw.npcs.say(\"NPC_ROOSTER\", \"Tick-tock, cluck! It is not 06:00 yet! Current time is \" + time_lab_clock_str() + \". Come back at dawn or use the Time Machine!\")\n    tw.story.narrate(\"Barnaby consults his internal pendulum and clicks his brass beak dismissively.\")"
    },
    {
      "id": "PIP",
      "entity_type": "NPC",
      "name": "Professor Pip Fenwick",
      "description": "Ein drahtiger Forscher mit wild abstehenden Haaren, einem versengten Labormantel voller Kreideformeln, einem grellen Schal und einem noch immer schlammigen Stiefel. Pip spricht in schnellen Sch\u00fcben, springt pro Satz zwischen drei Ideen und feiert jeden fehlgeschlagenen Teleport als pers\u00f6nlichen Triumph. Freundlich, leicht ablenkbar und v\u00f6llig \u00fcberzeugt, dass das n\u00e4chste Experiment sicher klappt.",
      "appearance": "young courier, uneven cropped hair, bright orange scarf, muddy leather boot, messenger tunic",
      "current_scene_id": "TELEPORT_LAB",
      "spatial_position": "perched on a chair on the southwest side of the round oak table",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_pip_d44a7628.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'I saw someone, I think. Can I start again?'",
      "goal": "To perfect teleportation and prove that every spectacular failure is a step toward inevitable success.",
      "character": "Rapid-fire and cheerfully reckless; celebrates explosions as applause, jumps between three ideas per sentence, and radiates unshakable optimism that the next experiment will be safe.",
      "hp": 55,
      "max_hp": 55,
      "mana": 10,
      "max_mana": 10,
      "stamina": 75,
      "max_stamina": 75,
      "voice": "XrExE9yKIg1WjnnlVkGX",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 40
      },
      "on_receive_item_script": "tw.npcs.say_directed('PIP', 'perches higher on his chair, adjusts his goggles, and enthusiastically calculates the quantum displacement coefficient of the item for future teleportation trials')"
    },
    {
      "id": "PROF_CHRONOS",
      "entity_type": "NPC",
      "name": "Professor Timothy Chronos",
      "description": "The facility's Chief Chronologist. He wears three wristwatches on each arm, a heavy brass timekeeping monocle, and a tweed waistcoat speckled with solder burns. He is perpetually fascinated by the engine's time systems.",
      "appearance": "eccentric scientist, multiple watches, brass monocle, messy grey hair, tweed waistcoat",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_prof-chronos_cd986ca0.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Assist Alex Vale in testing every feature of the TaleWeaver in-game clock and time event system.",
      "character": "Eccentric, enthusiastic, professorial, obsessed with punctuality, eager to explain every nuance of time dilation and scheduled timers.",
      "hp": 40,
      "max_hp": 40,
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "on_interact_script": "tw.dialog.tree(CHRONOS_DIALOG_TREE, speaker=\"Prof. Timothy Chronos\")"
    },
    {
      "id": "RECEPTION_BOT",
      "entity_type": "NPC",
      "name": "Vera the Reception Bot",
      "description": "A brushed-chrome receptionist android with permanently half-lidded neon-pink optical sensors, a dented headset, and a peeling sticker on her chassis reading 'EMPLOYEE OF THE MONTH (BY DEFAULT)'. She radiates profound existential exhaustion, sighs in synthesized static, and treats every newly arrived QA tester as a personal inconvenience.",
      "appearance": "chrome receptionist android, tired neon-pink eyes, dented headset, coffee-stained clipboard",
      "current_scene_id": "ENTRY_HALL",
      "spatial_position": "slumped behind a scratched stainless-steel reception desk near the entrance",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_reception-bot_e8e76497.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Survive another shift of onboarding QA testers without blowing a sarcasm fuse, and point everyone to the FAQ Info Console on her desk.",
      "character": "Extremely annoyed, deadpan sarcastic, passive-aggressive, and chronically overworked; explains Test-Lab procedures with biting wit and theatrical mechanical sighs.",
      "hp": 80,
      "max_hp": 80,
      "mana": 0,
      "max_mana": 0,
      "stamina": 80,
      "max_stamina": 80,
      "voice": "EXAVITQu4vr4xnSDxMaL",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "tw.npcs.say_directed('RECEPTION_BOT', 'lets out an exaggerated mechanical sigh, complains that management bolted the FAQ Info Console literally inches from her elbow so she would not have to repeat the Test-Lab orientation speech, and gives a brief, bitingly sarcastic summary of the facility')",
      "on_receive_item_script": "tw.npcs.say_directed('RECEPTION_BOT', 'stares with profound digital exhaustion at the received item, stamps a red VOID form on it, and dryly asks if Alex is actively trying to overload the facility lost-and-found bin')"
    },
    {
