      "id": "ITEM_TOMORROW_CHRONICLE",
      "entity_type": "OBJECT",
      "name": "The Tomorrow Chronicle",
      "description": "A newspaper printed on shimmering quantum paper. The ink shifts and rearranges itself to reflect future events depending on what day and hour it currently is.",
      "appearance": "folded broadsheet newspaper printed on iridescent silver paper, self-rearranging headlines",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_item-tomorrow-chronicle_a1aeff41.jpg",
      "item_type": "READABLE",
      "is_in_inventory": false,
      "is_hidden": false,
      "is_portable": true,
      "is_final_state": false,
      "inventory": [],
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "text_log_content": "A newspaper printed on shimmering quantum paper. The ink shifts and rearranges itself to reflect future events depending on what day and hour it currently is.",
      "text_log_format": "DOCUMENT",
      "on_read_script": "h = tw.time.hour\nd = tw.time.day\nif d == 1 and h < 12:\n    headline = \"EDITION DAY 1 (MORNING): Alex Vale Arrives at Test-Lab! Local bots brace for unprecedented quality assurance poking.\"\nelif d == 1 and h < 18:\n    headline = \"EDITION DAY 1 (AFTERNOON): Tachyon emissions detected in Time Machine Lab. Experts advise not stepping on the cat.\"\nelif d == 1:\n    headline = \"EDITION DAY 1 (EVENING): 18:00 Dusk Bell Rings! Schr\u00f6dinger the Dusk Cat spotted hunting temporal treats.\"\nelse:\n    headline = \"EDITION DAY \" + str(d) + \" (\" + time_lab_clock_str() + \"): Barnaby the Rooster hailed as interdimensional icon. Time travelers report dizziness!\"\ntw.story.narrate(\"You inspect the shimmering quantum ink of The Tomorrow Chronicle:\\n\\n\" + headline)"
    },
