      "switch_transitions": [
        {
          "to": "CHANNEL-SPORT",
          "gates": {},
          "on_success_script": "if tw.switches.get_state(\"SW_TV\", \"OFF\") == \"OFF\":\n    tw.switches.set_state(\"SW_TV\", \"ON\")\n    \ntw.story.system(\"The TV flickers and switches to the Sports Channel.\")\n    \nsports = tw.llm.ask(\n    \"Write a short sports commentary like on a TV sports show.\",\n    model=\"simple\",\n)\ntw.story.narrate_raw(sports or \"Just static noise.\")"
        },
        {
          "to": "CHANNEL-NEWS",
          "gates": {},
          "on_success_script": "if tw.switches.get_state(\"SW_TV\", \"OFF\") == \"OFF\":\n    tw.switches.set_state(\"SW_TV\", \"ON\")\n\ntw.story.system(\"The TV flickers and switches to the News Channel.\")\n    \nnews = tw.llm.ask(\n    \"Write some absurd news commentary like in a TV broadcast.\",\n    model=\"simple\",\n)\ntw.story.narrate_raw(news or \"Just static noise.\")"
        },
        {
          "to": "CHANNEL-SITCOM",
          "gates": {},
          "on_success_script": "if tw.switches.get_state(\"SW_TV\", \"OFF\") == \"OFF\":\n    tw.switches.set_state(\"SW_TV\", \"ON\")\n\ntw.story.system(\"The TV flickers and switches to the Sitcom Channel.\")\n    \nsitcom = tw.llm.ask(\n    \"Write some funny sitcom lines like in a TV broadcast.\",\n    model=\"simple\",\n)\ntw.story.narrate_raw(sitcom or \"Just static noise.\")"
        },
        {
          "to": "OFF",
          "gates": {},
          "on_success_script": "if tw.switches.get_state(\"SW_TV\", \"OFF\") == \"ON\":\n    tw.switches.set_state(\"SW_TV\", \"OFF\")"
        }
      ],
