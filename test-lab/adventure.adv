      "id": "CHRONOMETER_BOARD",
      "entity_type": "OBJECT",
      "name": "Master Chronometer Diagnostic Display",
      "description": "A large glass-faced wall panel providing real-time telemetry on the TaleWeaver temporal engine.",
      "appearance": "large glass wall display, brass bezel, glowing numerical dials, synchronized sweep hands",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_chronometer-board_c9df33cd.jpg",
      "item_type": "STATIC",
      "is_in_inventory": false,
