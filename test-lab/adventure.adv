    {
      "id": "ARENA_RAT",
      "entity_type": "NPC",
      "name": "Arena Rat",
      "description": "A scrawny, red-eyed rat bred in the cellars below the Combat Lab. Alone it is a nuisance; in a swarm it is a stress test. This hidden template is cloned by the Arena Combat Console.",
      "appearance": "scrawny grey rat with red eyes and a chewed ear",
      "current_scene_id": "COMBAT_LAB",
