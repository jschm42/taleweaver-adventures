    {
      "id": "GUILD_DIARY",
      "entity_type": "OBJECT",
      "name": "Guild Master's Diary",
      "description": "An open parchment diary next to the caskets, written in an irritated hand.",
      "current_scene_id": "RIDDLE_LAB",
      "spatial_position": "open on the oak table next to the caskets",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_guild-diary_0cfd278b.jpg",
