    {
      "id": "NPC_CAT",
      "entity_type": "NPC",
      "name": "Schr\u00f6dinger the Dusk Cat",
      "description": "A sleek tortoiseshell feline curled up on a warm tachyon radiator. She wears a miniature brass chronometer collar that glows soft amber. She sleeps nearly all day, waking only when evening dusk strikes at 18:00 to demand her temporal dinner.",
      "appearance": "sleek tortoiseshell cat, glowing amber collar with miniature brass clock, emerald eyes",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_npc-cat_30ab42e5.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Sleep on the warm tachyon coil until exactly 18:00, then demand temporal salmon.",
      "character": "Aloof, sleepy, demanding, vocal only when it is 18:00 dinner time.",
      "hp": 20,
      "max_hp": 20,
      "voice": "bICR68fw9p7rUiAEAgn6",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "if tw.time.hour == 18:\n    tw.npcs.say(\"NPC_CAT\", \"MREEEOW! MIAUUU! It is 18:00! Dusk has fallen! Where is my temporal fish dinner?!\")\n    tw.story.narrate(\"Schr\u00f6dinger rubs vigorously against your shins, her amber chronometer collar chiming insistently.\")\nelse:\n    tw.npcs.say(\"NPC_CAT\", \"Purrrr... Wake me at 18:00. Not a minute earlier... (\" + time_lab_clock_str() + \")\")\n    tw.story.narrate(\"Schr\u00f6dinger opens one lazy slit of an emerald eye, turns around on the warm tachyon coil, and goes back to sleep.\")"
    },
    {
      "id": "NPC_ROOSTER",
      "entity_type": "NPC",
      "name": "Barnaby the Chrono-Rooster",
      "description": "A brass-plated mechanical rooster perched upon an ornate copper weather-vane stand. His tail feathers are miniature pendulums and his internal alarm is permanently synchronized to crow at exactly 06:00 in the morning.",
      "appearance": "brass clockwork rooster, pendulum tail feathers, polished copper comb, glowing yellow eyes",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_npc-rooster_dc66604f.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Crow faithfully at 06:00 every single morning without fail.",
      "character": "Punctual, pompous, proud, easily offended if someone calls him a common chicken.",
      "hp": 20,
      "max_hp": 20,
      "voice": "Vs5CmVCVJwW4odQS2pVf",
      "is_attackable": true,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "if tw.time.hour == 6:\n    tw.npcs.say(\"NPC_ROOSTER\", \"KIKERIKI! COCK-A-DOODLE-DOO! Right on time! It is 06:00 in the morning!\")\n    tw.story.narrate(\"Barnaby puffs his polished brass feathers proudly, his pendulum tail swinging at top speed.\")\nelse:\n    tw.npcs.say(\"NPC_ROOSTER\", \"Tick-tock, cluck! It is not 06:00 yet! Current time is \" + time_lab_clock_str() + \". Come back at dawn or use the Time Machine!\")\n    tw.story.narrate(\"Barnaby consults his internal pendulum and clicks his brass beak dismissively.\")"
    },
    {
      "id": "PIP",
      "entity_type": "NPC",
      "name": "Professor Pip Fenwick",
      "description": "Ein drahtiger Forscher mit wild abstehenden Haaren, einem versengten Labormantel voller Kreideformeln, einem grellen Schal und einem noch immer schlammigen Stiefel. Pip spricht in schnellen Sch\u00fcben, springt pro Satz zwischen drei Ideen und feiert jeden fehlgeschlagenen Teleport als pers\u00f6nlichen Triumph. Freundlich, leicht ablenkbar und v\u00f6llig \u00fcberzeugt, dass das n\u00e4chste Experiment sicher klappt.",
      "appearance": "young courier, uneven cropped hair, bright orange scarf, muddy leather boot, messenger tunic",
      "current_scene_id": "TELEPORT_LAB",
      "spatial_position": "perched on a chair on the southwest side of the round oak table",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_pip_d44a7628.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
