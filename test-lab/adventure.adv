    {
      "id": "ITEM_PARADOX_HOURGLASS",
      "entity_type": "OBJECT",
      "name": "Paradox Hourglass",
      "description": "A delicate glass hourglass filled with luminescent violet sand that flows upward against gravity. Flipping it gently warps local causality.",
      "appearance": "ornate brass-framed hourglass, glowing violet sand defying gravity by drifting upward",
      "current_scene_id": "TIME_MACHINE_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_item-paradox-hourglass_85933d9a.jpg",
      "item_type": "PICKABLE",
      "is_in_inventory": false,
      "is_hidden": false,
