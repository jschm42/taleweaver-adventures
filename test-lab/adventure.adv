    {
      "id": "BRAM",
      "entity_type": "NPC",
      "name": "Bram Ironhand",
      "description": "A broad mechanic with a braided beard, burn scars, and a battered leather apron. Blunt and protective, he is quick to admit a mistake when shown solid evidence. He insists he had the key in his pocket all morning and finds Nora's certainty irritating.",
      "appearance": "broad-shouldered mechanic, braided beard, burn scars on forearms, battered leather apron",
      "current_scene_id": "SOCIAL_HALL",
      "spatial_position": "seated on the east side of the round oak table",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_bram_fe3ecf86.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "SOCIAL_HALL"
      ],
      "notes": "Sample line: 'Ask me straight. I'll answer straight.'",
      "goal": "Defend his account that he held the key all morning while staying open to concrete proof.",
      "character": "Blunt, practical, protective, and honest; dislikes pedantic nitpicking.",
      "hp": 80,
      "max_hp": 80,
      "mana": 0,
      "max_mana": 0,
      "stamina": 80,
      "max_stamina": 80,
      "voice": "Vs5CmVCVJwW4odQS2pVf",
      "is_attackable": false,
      "is_killable": true,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE",
        "special_chance": 40
      },
      "on_interact_script": "on_social_npc_interact('BRAM')",
      "on_receive_item_script": "on_social_npc_receive_item('BRAM', received_item_ids)"
    },
    {
      "id": "EDGAR_JANITOR",
      "entity_type": "NPC",
      "name": "Caretaker Edgar",
      "description": "The facility's long-suffering head custodian. Clad in faded blue denim overalls and yellow rubber gloves, clutching a galvanized steel bucket and a dripping industrial mop. Constantly scolds anyone tracking dirt onto his freshly wiped sparring mats, and wields his mop with alarming two-handed martial fury.",
      "appearance": "grumpy janitor in blue denim overalls, yellow rubber gloves, gumboots, wet yarn mop and bucket",
      "current_scene_id": "COMBAT_LAB",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_edgar-janitor_5105e2e2.jpg",
      "is_hidden": false,
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Mop the combat arena spotless and beat anyone with muddy boots until they learn floor hygiene.",
      "character": "Grumpy, obsessive about clean floors, sarcastic, complains constantly about muddy shoes and reckless combatants while swinging his wet mop with surprising two-handed fury.",
      "hp": 65,
      "max_hp": 65,
      "mana": 20,
      "max_mana": 20,
      "stamina": 90,
      "max_stamina": 90,
      "voice": "1BfrkuYXmEwp8AWqSLWk",
      "is_attackable": true,
      "is_killable": true,
      "inventory": [
