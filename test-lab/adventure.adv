      "is_final_state": false,
      "inventory": [],
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "on_interact_script": "tw.time.rewind(15)\ntw.player.heal(10)\nflips = tw.vars.get(\"hourglass_flips\", 0) + 1\ntw.vars.set(\"hourglass_flips\", flips)\ntw.story.narrate(\"You invert the Paradox Hourglass. Violet sand trickles upward with a crystalline chime! Local time rewinds by 15 minutes to \" + time_lab_clock_str() + \", and a soothing temporal wash restores 10 HP.\")\nif flips >= 3 and not tw.vars.get(\"hourglass_awarded\", False):\n    tw.vars.set(\"hourglass_awarded\", True)\n    tw.awards.grant(\"AWARD_CHRONO_PIONEER\")"
