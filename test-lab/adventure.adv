    {
      "id": "CSW_BEVERAGE_DISPENSER",
      "entity_type": "OBJECT",
      "name": "Beverage Dispenser",
      "description": "A retro glass-front beverage dispenser humming in the corner. A plaque reads: 'Put a Vending Coin inside, then flip the dispenser switch to Dispense Drink to unlock your cola.'",
      "appearance": "retro glass-front beverage dispenser vending machine with glowing buttons",
      "current_scene_id": "SWITCH_LAB",
      "image_url": "assets/4195cdbe_csw-beverage-dispenser.webp",
      "item_type": "CONTAINER_SWITCH",
