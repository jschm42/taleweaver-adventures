      "inventory": [
        "ITEM_COLD_COLA"
      ],
      "metadata_json": {
        "max_items": 2,
        "discovery_visibility": {
          "mentioned_in_scene": true,
          "listed_in_discoveries": true,
          "lootable": false
        }
      },
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "code_to_unlock": "",
      "item_to_unlock": "",
      "rule_to_unlock": "",
      "switch_states": [
        "STANDBY",
        "DISPENSE"
      ],
      "switch_state_labels": {
        "STANDBY": "Standby",
        "DISPENSE": "Dispense Drink"
      },
      "switch_initial_state": "STANDBY",
      "switch_disabled_states": [
        "DISPENSE"
      ],
      "switch_status_text": "",
      "switch_transitions": [
        {
          "from": "STANDBY",
          "to": "DISPENSE",
          "gates": {
            "item": "",
            "code": "",
            "rule": "",
            "expression": "tw.vars.get('power_on') == True and tw.vars.get('dispenser_paid') == True"
          },
          "fail_message": "The dispenser needs power and a Vending Coin before dispensing.",
          "success_message": "",
          "on_success_script": "disp = tw.objects.get('CSW_BEVERAGE_DISPENSER')\ntw.objects.destroy('ITEM_VENDING_COIN')\ntw.objects.unlock('ITEM_COLD_COLA')\ndisp.set_state('STANDBY', apply_outcomes=False)\ndisp.disable_state('DISPENSE')\ndisp.set_status_text('Drink dispensed! Take your Ice-Cold Cola from the tray.')\ntw.story.system('CLUNK-FIZZ! The delivery flap unlocks \u2014 you can now take the Ice-Cold Cola!')",
          "on_failure_script": ""
        }
      ],
      "switch_outcomes": [],
      "on_success_script": "",
      "on_failure_script": "",
      "on_items_added_script": "disp = tw.objects.get('CSW_BEVERAGE_DISPENSER')\nif not tw.vars.get('power_on', False):\n    for item_id in added_item_ids:\n        if item_id != 'ITEM_COLD_COLA':\n            tw.objects.take_from_container('CSW_BEVERAGE_DISPENSER', item_id, to='player')\n    tw.story.system('The Beverage Dispenser has no power! Activate the Main Fuse Box first.')\nelif 'ITEM_VENDING_COIN' in added_item_ids:\n    tw.objects.lock('ITEM_VENDING_COIN')\n    tw.vars.set('dispenser_paid', True)\n    disp.enable_state('DISPENSE')\n    disp.set_status_text('Coin accepted \u2014 press Dispense Drink to unlock the Ice-Cold Cola.')\n    tw.story.system(\"CLINK! The dispenser accepts your Vending Coin \u2014 'Dispense Drink' is now unlocked!\")\nelse:\n    for item_id in added_item_ids:\n        if item_id != 'ITEM_COLD_COLA':\n            tw.objects.take_from_container('CSW_BEVERAGE_DISPENSER', item_id, to='player')\n    tw.story.system('The coin slot rejects that item \u2014 only a Vending Coin fits.')"
    },
    {
      "id": "CSW_FUSE_BOX",
      "entity_type": "OBJECT",
      "name": "Main Fuse Box",
      "description": "A wall-mounted steel breaker box. Needs one Ceramic Fuse and one Insulated Power Cable inside before the main power switch can be turned on.",
      "current_scene_id": "SWITCH_LAB",
      "image_url": "assets/0fd2814d_csw-fuse-box.webp",
      "item_type": "CONTAINER_SWITCH",
      "is_in_inventory": false,
      "is_hidden": false,
      "is_portable": false,
      "is_final_state": false,
      "inventory": [],
      "metadata_json": {
        "min_items": 2,
        "max_items": 2,
        "discovery_visibility": {
          "mentioned_in_scene": true,
          "listed_in_discoveries": true,
          "lootable": false
        }
      },
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "code_to_unlock": "",
      "item_to_unlock": "",
      "rule_to_unlock": "",
      "switch_states": [
        "OFF",
        "ON"
      ],
      "switch_state_labels": {
        "OFF": "Power Off",
        "ON": "Power On"
      },
      "switch_initial_state": "OFF",
      "switch_disabled_states": [
        "ON"
      ],
      "switch_status_text": "",
      "switch_transitions": [
        {
          "from": "OFF",
          "to": "ON",
          "gates": {
            "item": "",
            "code": "",
            "rule": "",
            "expression": "{'ITEM_FUSE_A', 'ITEM_COPPER_CABLE'}.issubset(set(tw.objects.get('CSW_FUSE_BOX').item_ids))"
          },
          "fail_message": "Both the Ceramic Fuse and the Insulated Power Cable must be installed in the Fuse Box first.",
          "success_message": "",
          "on_success_script": "fb = tw.objects.get('CSW_FUSE_BOX')\ntw.vars.set('power_on', True)\ntw.flags.set('LAB_POWER_RESTORED', True)\nfb.disable_state('OFF')\nfb.set_status_text('Main power is active and permanently latched.')\ntw.objects.lock('ITEM_FUSE_A')\ntw.objects.lock('ITEM_COPPER_CABLE')\ntw.switches.enable_state('SW_TV', 'ON')\ntw.switches.clear_status_text('SW_TV')\ntw.switches.enable_state('ITEM_WORKING_REMOTE', 'CHANNEL-SPORT', 'CHANNEL-NEWS', 'CHANNEL-SITCOM')\ntw.switches.clear_status_text('ITEM_WORKING_REMOTE')\ndisp = tw.objects.get('CSW_BEVERAGE_DISPENSER')\nif tw.vars.get('dispenser_paid', False):\n    disp.enable_state('DISPENSE')\n    disp.set_status_text('Coin accepted \u2014 press Dispense Drink to unlock the Ice-Cold Cola.')\nelse:\n    disp.set_status_text('Insert a Vending Coin into Slot 2 to unlock Dispense Drink.')\nmw = tw.objects.get('CSW_MICROWAVE')\nif len(mw.item_ids) > 0 and not tw.vars.get('mw_processed', False):\n    mw.enable_state('DEFROST', 'COOK')\n    mw.set_status_text('Item loaded \u2014 choose Defrost or Cook (High Heat).')\nelse:\n    mw.set_status_text('Place a food item inside to unlock Defrost and Cook (High Heat).')\npm = tw.objects.get('ITEM_POPCORN_MACHINE')\nif {'ITEM_RAW_CORN', 'ITEM_BUTTER', 'ITEM_SUGAR'}.issubset(set(pm.item_ids)):\n    pm.enable_state('POP')\n    pm.set_status_text('All 3 ingredients loaded \u2014 switch to Pop Corn!')\nelse:\n    pm.set_status_text('Insert Raw Corn, Popcorn Butter, and Sugar into the 3 slots to unlock Pop Corn.')\ntw.story.system('CLUNK-HUMMM! The main breaker latches permanently into Power On! Electricity surges through the TV Room \u2014 all appliances and switches are now powered.')",
          "on_failure_script": ""
        }
      ],
      "switch_outcomes": [],
      "on_success_script": "",
      "on_failure_script": "",
      "on_items_added_script": "fb = tw.objects.get('CSW_FUSE_BOX')\nrequired = {'ITEM_FUSE_A', 'ITEM_COPPER_CABLE'}\ncurrent = set(fb.item_ids)\nif required.issubset(current):\n    fb.enable_state('ON')\n    fb.set_status_text('Both components installed \u2014 switch to Power On to energize the room.')\n    tw.story.system('The Ceramic Fuse and Insulated Power Cable are seated in place. Power On is now unlocked!')\nelse:\n    fb.disable_state('ON')\n    fb.set_status_text('Insert the Ceramic Fuse and Insulated Power Cable into the 2 slots to unlock Power On.')\n    tw.story.system('Fuse box status: ' + str(len(current)) + '/2 required components installed.')",
      "on_items_removed_script": "fb = tw.objects.get('CSW_FUSE_BOX')\nrequired = {'ITEM_FUSE_A', 'ITEM_COPPER_CABLE'}\nif not tw.vars.get('power_on', False) and not required.issubset(set(fb.item_ids)):\n    fb.disable_state('ON')\n    fb.set_status_text('Insert the Ceramic Fuse and Insulated Power Cable into the 2 slots to unlock Power On.')"
    },
