  "sequences": [
    {
      "id": "SEQ_ENTRY_HALL",
      "order": 1,
      "title": "Reception & Orientation",
      "description": "Check in at the reception desk in the Entry Hall and review facility test protocols with Vera.",
      "walkthrough": "Talk to Vera the Reception Bot at the front desk or read the FAQ info console.",
      "end_condition": "Alex Vale leaves the reception and enters any of the test facilities.",
      "exp_reward": 25,
      "activation_scene_id": "ENTRY_HALL",
