    {
      "id": "ITEM_POPCORN_MACHINE",
      "entity_type": "OBJECT",
      "name": "Popcorn Machine",
      "description": "A glass-kettle cinema popcorn machine. Needs electrical power and all 3 ingredients (Raw Corn, Popcorn Butter, and Sugar) inside to pop a batch of Delicious Popcorn.",
      "current_scene_id": "SWITCH_LAB",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_item-popcorn-machine_c8775334.jpg",
      "item_type": "CONTAINER_SWITCH",
      "is_in_inventory": false,
      "is_hidden": false,
      "is_portable": false,
      "is_final_state": false,
      "stat_modifier_strength": 0,
      "inventory": [],
      "metadata_json": {
        "min_items": 3,
        "max_items": 3,
        "discovery_visibility": {
          "mentioned_in_scene": true,
          "listed_in_discoveries": true,
          "lootable": false
        }
      },
      "hp_change": 0,
      "stamina_change": 0,
      "mana_change": 0,
      "code_to_unlock": "",
      "item_to_unlock": "",
      "rule_to_unlock": "",
      "switch_states": [
        "OFF",
        "POP"
      ],
      "switch_state_labels": {
        "OFF": "Off",
        "POP": "Pop Corn"
      },
      "switch_initial_state": "OFF",
      "switch_disabled_states": [
        "POP"
      ],
      "switch_status_text": "",
      "switch_transitions": [
        {
          "from": "OFF",
          "to": "POP",
          "gates": {
            "item": "",
            "code": "",
            "rule": "",
            "expression": "tw.vars.get('power_on') == True and {'ITEM_RAW_CORN', 'ITEM_BUTTER', 'ITEM_SUGAR'}.issubset(set(tw.objects.get('ITEM_POPCORN_MACHINE').item_ids))"
          },
          "fail_message": "The Popcorn Machine needs power and all 3 ingredients (Raw Corn, Popcorn Butter, and Sugar) inside.",
          "success_message": "",
          "on_success_script": "pm = tw.objects.get('ITEM_POPCORN_MACHINE')\ntw.objects.destroy('ITEM_RAW_CORN')\ntw.objects.destroy('ITEM_BUTTER')\ntw.objects.destroy('ITEM_SUGAR')\ntw.objects.reveal('ITEM_POPCORN')\ntw.objects.put_in_container('ITEM_POPCORN', 'ITEM_POPCORN_MACHINE')\npm.set_state('OFF', apply_outcomes=False)\npm.disable_state('POP')\npm.set_status_text('Fresh popcorn ready! Take the Delicious Popcorn from the kettle.')\ntw.story.system('POP-POP-POP! Golden, sugar-glazed Delicious Popcorn fills the kettle! The switch springs back to Off \u2014 take your popcorn!')",
          "on_failure_script": ""
        }
      ],
      "switch_outcomes": [],
      "on_success_script": "",
      "on_failure_script": "",
      "on_items_added_script": "pm = tw.objects.get('ITEM_POPCORN_MACHINE')\nrequired = {'ITEM_RAW_CORN', 'ITEM_BUTTER', 'ITEM_SUGAR'}\nif pm.contains('ITEM_POPCORN'):\n    for item_id in added_item_ids:\n        if item_id != 'ITEM_POPCORN':\n            tw.objects.take_from_container('ITEM_POPCORN_MACHINE', item_id, to='player')\n    tw.story.system('Take the finished Delicious Popcorn from the kettle first!')\nelse:\n    rejected = [iid for iid in added_item_ids if iid not in required]\n    for iid in rejected:\n        tw.objects.take_from_container('ITEM_POPCORN_MACHINE', iid, to='player')\n    if rejected:\n        tw.story.system('Only Raw Corn, Popcorn Butter, and Sugar belong in the Popcorn Machine.')\n    current = set(pm.item_ids)\n    if required.issubset(current):\n        if tw.vars.get('power_on', False):\n            pm.enable_state('POP')\n            pm.set_status_text('All 3 ingredients loaded \u2014 switch to Pop Corn!')\n            tw.story.system(\"All 3 popcorn ingredients are in the kettle. 'Pop Corn' is now unlocked!\")\n        else:\n            pm.disable_state('POP')\n            pm.set_status_text('The popcorn machine needs some electrical power first.')\n            tw.story.system('All 3 ingredients are in the kettle, but the machine has no electrical power yet!')\n    else:\n        pm.disable_state('POP')\n        if tw.vars.get('power_on', False):\n            pm.set_status_text('Loaded ' + str(len(current)) + '/3 ingredients \u2014 add Raw Corn, Popcorn Butter, and Sugar to unlock Pop Corn.')\n        else:\n            pm.set_status_text('The popcorn machine needs some electrical power first.')\n        tw.story.system('Popcorn kettle: ' + str(len(current)) + '/3 required ingredients loaded.')",
      "on_items_removed_script": "pm = tw.objects.get('ITEM_POPCORN_MACHINE')\nrequired = {'ITEM_RAW_CORN', 'ITEM_BUTTER', 'ITEM_SUGAR'}\ncurrent = set(pm.item_ids)\nif not required.issubset(current):\n    pm.disable_state('POP')\n    if tw.vars.get('power_on', False):\n        pm.set_status_text('Insert Raw Corn, Popcorn Butter, and Sugar into the 3 slots to unlock Pop Corn.')\n    else:\n        pm.set_status_text('The popcorn machine needs some electrical power first.')"
    },
