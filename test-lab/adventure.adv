  "start_scene_id": "ENTRY_HALL",
  "scenes": [
    {
      "id": "ENTRY_HALL",
      "label": "Test-Lab entry hall",
      "description": "Entry hall of the test lab. A narrow room of stainless steel panels, hazard-striped floor tape and a flickering fluorescent tube. Doorways lead to the Conversation Hall, the Object Workshop, the combat lab and the Switch Lab, and a glowing teleporter hums against the wall on its way to the Teleportation Lab.",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_scene_8c51da45.jpg",
      "decorative_objects": [
        "stainless steel wall panel",
        "flickering fluorescent ceiling light",
        "hazard-striped floor marking",
        "frosted glass partition",
        "overhead cable tray",
        "scuffed concrete floor",
        "numbered wall placard"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The door seals behind you with a soft hiss. A wall placard reads: TEST SESSION IN PROGRESS \u2014 NO SCHEDULED END. Four corridors and one humming teleporter wait for you to choose where the testing starts.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "COMBAT_ARENA",
      "label": "Combat Arena (Combat Lab)",
      "description": "A spacious, padded training room built for combat and loot evaluation. White boundary lines mark the floor mats. Two distinct sparring opponents\u2014Training Guard Harlan and Spark Mage Ilya\u2014stand ready at opposite sides of the mat. Both remain passive until deliberately attacked and are willing to talk beforehand. A keyed door leads north to the Object Workshop, and a switch-controlled shortcut door leads northwest to the Conversation Hall.",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_a71b843f.jpg",
      "decorative_objects": [
        "padded floor mats",
        "white boundary lines",
        "padded wall bolsters",
        "empty weapon rack",
        "scoreboard chalk slate"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "LOCKED_ROOM",
      "label": "A locked room",
      "description": "Who knows what's in here?",
      "image_url": "assets/01a186c9-0a80-7d95-bc20-202984f42b50_scene_64d7792e.jpg",
      "decorative_objects": [],
      "on_enter_scene_script": "tw.story.direct(\"Give a funny explaination why this room ist still empty.\")\ntw.npcs.move_to_player(\"UNIT_SEVEN\", \"right in front of the player\")\ntw.npcs.say(\"UNIT_SEVEN\", \"Don't mind me. I am just here for the jump scare.\")",
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "SOCIAL_HALL",
      "label": "Conversation Hall (NPC Lab)",
      "description": "Ein hell erleuchteter Saal f\u00fcr Gesellschafts- und Dialoglabore. In der Mitte steht ein runder Eichentisch mit f\u00fcnf St\u00fchlen; vier sind besetzt \u2013 Nora Quill, Bram Ironhand, Vesper Glass und der Automat Unit Seven \u2013, w\u00e4hrend der f\u00fcnfte leer bleibt, seit Pip Fen ins Teleportationslabor abgewandert ist. An der Nordwand h\u00e4ngt ein deutlich beschriftetes Testpanel f\u00fcr deterministische Skript- und Statustests. Eine schlichte Werkstatt\u00fcr f\u00fchrt nach Osten in die Objektwerkstatt, und eine schaltergesteuerte Abk\u00fcrzung verbindet den Saal mit der Kampfarena, sobald sie mit Strom versorgt ist.",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_d6a5daa7.jpg",
      "decorative_objects": [
        "round oak table",
        "five wooden chairs",
        "overhead brass lamp",
        "acoustic wall panels",
        "mounted room placard"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "def on_choose_npc_action(answ):\n    # 0 = make them angry, 1 = make them happy, 2 = make them sing, 3 = leave unchanged\n    if answ == 0:\n        old_mood, new_mood = \"very happy\", \"very angry\"\n        text, direction = \"The round is getting very angry!\", \"says what they think about Alex\"\n    elif answ == 1:\n        old_mood, new_mood = \"very angry\", \"very happy\"\n        text, direction = \"The round is getting very happy!\", \"says what they think about Alex\"\n    elif answ == 2:\n        old_mood, new_mood = None, None\n        text, direction = \"The whole round bursts into song!\", \"sings a verse about Alex\"\n    else:\n        tw.story.narrate(\"You leave the panel untouched. Nothing changes at the table.\")\n        return\n\n    tw.story.narrate(text)\n    for npc in tw.scene.npcs:\n        if npc.is_defeated:\n            continue\n        if new_mood:\n            if npc.has_trait(old_mood):\n                npc.remove_trait(old_mood)\n            npc.add_trait(new_mood)\n            tw.log.info(f\"Trait '{new_mood}' set on NPC: {npc.id}\")\n        tw.npcs.say_directed(npc.id, direction)"
    },
    {
      "id": "TELEPORT_LAB",
      "label": "Teleportation Lab",
      "description": "Interdimensionales Teleportationslabor. Eine erh\u00f6hte Metallplattform summt in der Mitte, umringt von verkabelten Kabelkn\u00e4ueln und frostbedeckten K\u00fchlleitungen. Monitore flackern an den W\u00e4nden, baumelnde Elektrodenarme zucken \u00fcber verschmorte Bodenplatten. Professor Pip Fenwick tanzt zwischen den Konsolen, kritisiert die Kreideformeln an den K\u00fchlrohren und winkt jeden Besucher ungeduldig auf die markierte Platte.",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_scene_b32d2ba2.jpg",
      "decorative_objects": [
        "raised metal platform",
        "tangled cable coils",
        "flickering ceiling panels",
        "frost-covered coolant pipes",
        "scorched floor plating",
        "wall-mounted monitor bank",
        "dangling electrode arms"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "TV_ROOM",
      "label": "TV room (Switch Lab)",
      "description": "Cosy living room with a huge TV",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_8c42c2db.jpg",
      "decorative_objects": [
        "soft beige carpeting",
        "muted geometric wallpaper",
        "padded acoustic wall panels",
        "recessed ceiling lights",
        "framed abstract wall art",
        "painted circuit border",
        "decorative wooden ceiling beams"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "WORKSHOP",
      "label": "Object Workshop",
      "description": "A tidy, brightly lit room designed for testing item interactions, containers, locks, readable logs, crafting, and switch mechanics. A sturdy wooden workbench runs along the center of the room. Arranged around the bench are an unlocked Supply Crate, a locked Code Box with a keypad, a portable Bench Note, and a wall-mounted Shortcut Switch. A normal door leads west back to the Conversation Hall, while a heavy keyed door leads south to the Combat Arena.",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_5d9bfca0.jpg",
      "decorative_objects": [
        "sturdy wooden workbench",
        "tool pegboard",
        "overhead fluorescent fixture",
        "labeled floor tape",
        "steel stool",
        "Switch wiring label: ON sets SHORTCUT_POWERED; OFF clears SHORTCUT_POWERED."
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    }
  ],
