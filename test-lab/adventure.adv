  "start_scene_id": "ENTRY_HALL",
  "scenes": [
    {
      "id": "ENTRY_HALL",
      "label": "Test-Lab entry hall",
      "description": "Entry hall of the Test-Lab. A narrow room of stainless-steel panels, hazard-striped floor tape, and a flickering fluorescent tube. Behind a scratched reception desk sits Vera the Reception Bot next to a glowing FAQ Info Console. Doorways lead to the Conversation Hall, the Object Workshop, the Combat Arena, the Switch Lab, the Dusty Alchemy Lab, and the Time Machine Lab, while a glowing teleporter hums against the wall on its way to the Teleportation Lab.",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_scene_8c51da45.jpg",
      "decorative_objects": [
        "stainless steel wall panel",
        "flickering fluorescent ceiling light",
        "hazard-striped floor marking",
        "frosted glass partition",
        "overhead cable tray",
        "scuffed concrete floor",
        "numbered wall placard"
      ],
      "on_enter_scene_script": "greet_at_reception()",
      "on_enter_scene_text": "The door seals behind you with a soft hiss. A wall placard reads: TEST SESSION IN PROGRESS \u2014 NO SCHEDULED END. Four corridors and one humming teleporter wait for you to choose where the testing starts.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "ENTRY_FAQ_TREE = {\n    \"dialogue_id\": \"entry_faq_console\",\n    \"npc_id\": \"RECEPTION_BOT\",\n    \"initial_node\": \"root\",\n    \"nodes\": {\n        \"root\": {\n            \"npc_text\": \"WELCOME TO THE TEST-LAB AUTOMATED FAQ TERMINAL (v4.3 - 'Please Read This Instead Of Talking To Vera' Edition). Select a topic with your fleshy human finger:\",\n            \"responses\": [\n                {\"text\": \"What is the 'Test-Lab' and why am I here?\", \"next_node\": \"what_is_test_lab\"},\n                {\"text\": \"What rooms and experiments are in this facility?\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"How do I win or lose in the Test-Lab?\", \"next_node\": \"win_lose\"},\n                {\"text\": \"What is the deal with the humming teleporter in the corner?\", \"next_node\": \"faq_teleport\"},\n                {\"text\": \"Why is Vera the Reception Bot so annoyed?\", \"next_node\": \"faq_vera\", \"once\": True},\n                {\"text\": \"Log off. I am ready to start testing.\", \"next_node\": None},\n            ],\n        },\n        \"what_is_test_lab\": {\n            \"npc_text\": \"There is no ancient prophecy, no dark lord, and no missing princess. You are Alex Vale, a QA test operator hired for one afternoon to poke every mechanic in the TaleWeaver engine--dialogs, containers, locks, crafting, switches, riddles, teleporters, time management, and turn-based combat--until you are satisfied they work as advertised.\",\n            \"responses\": [\n                {\"text\": \"What rooms can I visit?\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n                {\"text\": \"Got it. Close terminal.\", \"next_node\": None},\n            ],\n        },\n        \"rooms_overview\": {\n            \"npc_text\": \"Six doors and one questionable teleporter branch off from this Entry Hall. Which department's liability waiver would you like to read?\",\n            \"responses\": [\n                {\"text\": \"Time Machine Lab\", \"next_node\": \"rooms_time_lab\"},\n                {\"text\": \"Conversation Hall & Object Workshop\", \"next_node\": \"rooms_social_workshop\"},\n                {\"text\": \"Switch Lab (TV Room) & Dusty Alchemy Lab\", \"next_node\": \"rooms_switch_alchemy\"},\n                {\"text\": \"Combat Arena\", \"next_node\": \"rooms_combat\"},\n                {\"text\": \"Teleportation Lab\", \"next_node\": \"faq_teleport\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n            ],\n        },\n        \"rooms_time_lab\": {\n            \"npc_text\": \"TIME MACHINE LAB: Headed by Professor Timothy Chronos. Dedicated to QA testing the in-game clock, turn pacing, pause states, and scheduled timers. Features the Chronos-5000 machine, Barnaby the Rooster (crows at 06:00), Schr\\u00f6dinger the Dusk Cat (meows at 18:00), a Paradox Hourglass, and The Tomorrow Chronicle.\",\n            \"responses\": [\n                {\"text\": \"Check the other rooms.\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n            ],\n        },\n        \"rooms_social_workshop\": {\n            \"npc_text\": \"CONVERSATION HALL: Four opinionated regulars sit around an oak table waiting for you to test free-form NPC chat, plus a wall panel that forces them to get angry, get happy, or burst into song. OBJECT WORKSHOP: Lockboxes, keypad codes (hint: read the note on the bench, it is literally 4217), crafting ingredients, and a locked room.\",\n            \"responses\": [\n                {\"text\": \"Check the other rooms.\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n            ],\n        },\n        \"rooms_switch_alchemy\": {\n            \"npc_text\": \"SWITCH LAB (TV ROOM): Repair a broken TV remote, make magic popcorn, and flip through LLM-powered TV channels. DUSTY ALCHEMY LAB: Five caskets, five trinkets, and Grimsby--an insufferable stone gargoyle who breathes poison gas on you if you botch his logic riddle.\",\n            \"responses\": [\n                {\"text\": \"Check the other rooms.\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n            ],\n        },\n        \"rooms_combat\": {\n            \"npc_text\": \"COMBAT ARENA: Home to Training Guard Harlan and Spark Mage Ilya. They are polite enough to wait until you swing first before beating you up in turn-based combat. Defeating them drops real loot, and no, you do not have to feel bad about it--they signed the form.\",\n            \"responses\": [\n                {\"text\": \"Check the other rooms.\", \"next_node\": \"rooms_overview\"},\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n            ],\n        },\n        \"win_lose\": {\n            \"npc_text\": \"LOSING: Let your HP hit zero in the Combat Arena or choke on Grimsby's riddle gas. WINNING: Nothing ends automatically. Explore in any order, break what you can, and tell the system whenever your QA session is complete.\",\n            \"responses\": [\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n                {\"text\": \"Fair enough. Close terminal.\", \"next_node\": None},\n            ],\n        },\n        \"faq_teleport\": {\n            \"npc_text\": \"Step onto the glowing teleporter pad in this hall to beam into the Teleportation Lab, where Professor Pip Fenwick is attempting to teleport Unit Seven out of the Conversation Hall. Spoiler alert: his targeting coil has a loose screw, so expect rodents and displaced senior citizens before he gets it right.\",\n            \"responses\": [\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n                {\"text\": \"I have to see this. Close terminal.\", \"next_node\": None},\n            ],\n        },\n        \"faq_vera\": {\n            \"npc_text\": \"Vera was built with a Class-9 Quantum Intelligence Core capable of calculating eleven-dimensional astrophysics, and management assigned her to hand out visitor badges and explain keypad code 4217 to QA testers. Frankly, it is a miracle she has not vented the hallway.\",\n            \"responses\": [\n                {\"text\": \"Back to the main FAQ menu.\", \"next_node\": \"root\"},\n                {\"text\": \"I will leave her in peace. Close terminal.\", \"next_node\": None},\n            ],\n        },\n    },\n}\n\n\ndef greet_at_reception():\n    if not tw.vars.get(\"vera_greeted\", False):\n        tw.vars.set(\"vera_greeted\", True)\n        tw.story.direct(\n            \"Narrate how Vera the Reception Bot--a thoroughly exhausted, sarcastic chrome android slumped behind the reception desk--lets out a loud, static-laced mechanical sigh as Alex Vale arrives in the Entry Hall, tapping her clipboard with a metallic finger.\"\n        )\n        tw.npcs.say_directed(\n            \"RECEPTION_BOT\",\n            \"in an extremely annoyed, deadpan sarcastic tone, welcomes Alex to the Test-Lab, briefly explains that this is not a dramatic fantasy quest but a modular QA testing facility where each room tests a different engine feature (NPC conversations, locks and crafting, switches, riddles, combat, teleporters, and time management), and tells Alex to click the FAQ Info Console on her desk for details instead of asking her questions\",\n        )\n        return\n\n    tw.story.direct(\n        \"Briefly mention Vera the Reception Bot barely looking up from her desk as Alex returns to the Entry Hall.\"\n    )\n    tw.npcs.say_directed(\n        \"RECEPTION_BOT\",\n        \"makes a short, dryly sarcastic remark about Alex still being in one piece and reminds them the FAQ Info Console is still right there\",\n    )"
    },
    {
      "id": "ALCHEMY_LAB",
      "label": "Dusty Alchemy Lab (Riddle Lab)",
      "description": "A cramped alchemist's laboratory under a layer of dust. A massive oak table holds five open caskets in a row, numbered 1 to 5 from left to right, each made of a different material. Beside them five strange trinkets lie on a velvet cloth, next to an open parchment diary. A brass lever juts from the table's edge. Above the far wall a stone gargoyle bust watches everything with open contempt.",
      "image_url": "assets/01a18e10-5de1-7ab0-8ec6-02838b4afff8_scene_16bc8366.jpg",
      "decorative_objects": [
        "massive oak table",
        "velvet cloth",
        "cobwebbed alembics",
        "shelves of cloudy jars",
        "soot-stained ceiling",
        "cracked stone wall"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Dust swirls in the lamplight. Somewhere above you, stone grinds against stone as the gargoyle turns its head to stare at you.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "# Helpers for the ALCHEMY_LAB casket puzzle (loaded on every script run).\n\nLAB_SOLUTION = {\n    \"BOX_OAK\": \"ART_CLOCKWORK_HEART\",\n    \"BOX_COPPER\": \"ART_GHOST_TEARS\",\n    \"BOX_BONE\": \"ART_GOLD_DIE\",\n    \"BOX_OBSIDIAN\": \"ART_NIGHTSHADE\",\n    \"BOX_SILVER\": \"ART_STONE_TOAD\",\n}\nLAB_ARTIFACTS = [\n    \"ART_CLOCKWORK_HEART\",\n    \"ART_GHOST_TEARS\",\n    \"ART_GOLD_DIE\",\n    \"ART_NIGHTSHADE\",\n    \"ART_STONE_TOAD\",\n]\nLAB_GARGOYLE = \"GARGOYLE_GRIMSBY\"\nLAB_GAS_DAMAGE = 15\nLAB_HINT_AFTER_FAILS = 3\nLAB_TAUNTS = [\n    \"Wrong. Breathe deeply, apprentice. It builds character.\",\n    \"Wrong again. I have seen moss with a better grasp of logic.\",\n    \"Still wrong. The guild master turned his last apprentice into a newt. The newt solved it.\",\n    \"Wrong. I am starting to enjoy this.\",\n]\n\nLAB_GARGOYLE_TALK = {\n    \"dialogue_id\": \"lab_gargoyle\",\n    \"npc_id\": \"GARGOYLE_GRIMSBY\",\n    \"initial_node\": \"root\",\n    \"nodes\": {\n        \"root\": {\n            \"npc_text\": \"Another apprentice. Marvellous. Five caskets, five trinkets, one lever. \"\n            \"Put every trinket into its proper casket, then pull. Get it wrong and I breathe on you. \"\n            \"I have had nothing but sulphur for breakfast for three hundred years.\",\n            \"responses\": [\n                {\"text\": \"Tell me the riddle.\", \"next_node\": \"riddle\"},\n                {\"text\": \"What are the caskets?\", \"next_node\": \"caskets\"},\n                {\"text\": \"What are the trinkets?\", \"next_node\": \"trinkets\"},\n                {\"text\": \"Give me a hint.\", \"next_node\": \"hint\", \"once\": True},\n                {\"text\": \"I will manage on my own.\", \"next_node\": None},\n            ],\n        },\n        \"riddle\": {\n            \"npc_text\": \"My master's rules, since you clearly cannot read: \"\n            \"One - the petrified toad fears fire; keep it as far from the charred oak as the table allows. \"\n            \"Two - the clockwork heart needs a place at the very edge of the table, or its ticking cracks the centrepiece. \"\n            \"Three - the gambler's gold die lies directly to the left of the nightshade. Gambling and a quick death belong together. \"\n            \"Four - the heart's old mechanism stalls the moment dried herbs or loaded gold lie right next to it. \"\n            \"Five - liquids rot charred oak and cloud obsidian; keep the ghost tears out of both. \"\n            \"There is exactly one way. Even you might find it.\",\n            \"responses\": [\n                {\"text\": \"Say that again.\", \"next_node\": \"riddle\"},\n                {\"text\": \"Back to the other questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Enough. I will solve it.\", \"next_node\": None},\n            ],\n        },\n        \"caskets\": {\n            \"npc_text\": \"From left to right, as any literate creature counts: \"\n            \"one, charred oak. Two, tarnished copper. Three, bleached bone, in the middle. \"\n            \"Four, black obsidian. Five, frosted silver, far right. \"\n            \"Each sits on a plate that weighs essence, not weight. One trinket per casket.\",\n            \"responses\": [\n                {\"text\": \"Back to the other questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Thanks, stone face.\", \"next_node\": None},\n            ],\n        },\n        \"trinkets\": {\n            \"npc_text\": \"On the velvet: a loaded gold die that smells of taverns and lies. \"\n            \"A vial of ghost tears, cold and faintly glowing. A clockwork heart that ticks loud enough to wake me. \"\n            \"A petrified toad, dry and blissfully silent. And a bundle of dried nightshade. Do not lick it.\",\n            \"responses\": [\n                {\"text\": \"Back to the other questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Thanks, stone face.\", \"next_node\": None},\n            ],\n        },\n        \"hint\": {\n            \"npc_text\": \"Fine. Start with whatever hates fire the most. Even a toad can count to five.\",\n            \"responses\": [\n                {\"text\": \"Back to the other questions.\", \"next_node\": \"root\"},\n                {\"text\": \"That will do.\", \"next_node\": None},\n            ],\n        },\n    },\n}\n\n\ndef lab_return_to_player(box_id, item_id, reason):\n    tw.objects.take_from_container(box_id, item_id, to=\"player\")\n    tw.narrate(reason)\n\n\ndef lab_box_added(box_id, added_ids):\n    # Each casket holds exactly one trinket from the velvet cloth.\n    added = [item_id.upper() for item_id in added_ids]\n    previous = [item_id for item_id in tw.objects.get(box_id).item_ids if item_id.upper() not in added]\n    kept = None\n    for item_id in added:\n        if item_id not in LAB_ARTIFACTS:\n            lab_return_to_player(box_id, item_id, \"The pressure plate shudders and pushes the object back out. It has no essence the casket recognises.\")\n            continue\n        if previous or kept:\n            lab_return_to_player(box_id, item_id, \"The casket is already occupied. The plate rejects the second trinket.\")\n            continue\n        kept = item_id\n    if kept:\n        tw.narrate(\"The pressure plate beneath the casket sinks with a soft click.\")\n\n\ndef lab_count_wrong():\n    wrong = 0\n    for box_id, item_id in LAB_SOLUTION.items():\n        if not tw.objects.get(box_id).contains(item_id):\n            wrong += 1\n    return wrong\n\n\ndef lab_solve():\n    tw.vars.set(\"lab_solved\", True)\n    tw.objects.reveal(\"GUILDMASTER_RING\")\n    tw.narrate(\n        \"Five plates click in unison. Behind the gargoyle, a section of the wall grinds aside \"\n        \"and reveals a narrow alcove. Something glints inside.\"\n    )\n    tw.npcs.say(LAB_GARGOYLE, \"Hm. Correct. Do not let it go to your head, it is the only thing in there.\")\n    tw.awards.grant(\"AWARD_BRASS_LEVER_WHISPERER\")\n\n\ndef lab_punish():\n    fails = tw.vars.get(\"lab_fails\", 0) + 1\n    tw.vars.set(\"lab_fails\", fails)\n    taunt = LAB_TAUNTS[min(fails, len(LAB_TAUNTS)) - 1]\n    if tw.player.hp > LAB_GAS_DAMAGE * 2:\n        tw.player.damage(LAB_GAS_DAMAGE)\n        tw.narrate(\"The gargoyle's jaws creak open and a cloud of green, bitter gas rolls over you. (-\" + str(LAB_GAS_DAMAGE) + \" HP)\")\n    else:\n        tw.narrate(\"The gargoyle's jaws creak open, but only a pitiful wheeze comes out. It looks embarrassed.\")\n    tw.npcs.say(LAB_GARGOYLE, taunt)\n    if fails < LAB_HINT_AFTER_FAILS:\n        return\n    right = len(LAB_SOLUTION) - lab_count_wrong()\n    tw.npcs.say(LAB_GARGOYLE, \"Out of pity: \" + str(right) + \" of 5 caskets are right. Do not tell my master.\")\n\n\ndef on_lab_lever(answ):\n    if answ != 0:\n        tw.narrate(\"You leave the lever alone. The gargoyle sounds disappointed.\")\n        return\n    if tw.vars.get(\"lab_solved\"):\n        tw.narrate(\"The lever swings loosely. Whatever it guarded is already open.\")\n        return\n    if lab_count_wrong() == 0:\n        lab_solve()\n        return\n    lab_punish()"
    },
    {
      "id": "COMBAT_ARENA",
      "label": "Combat Arena (Combat Lab)",
      "description": "A spacious, padded training room built for combat and loot evaluation. White boundary lines mark the floor mats. Two distinct sparring opponents\u2014Training Guard Harlan and Spark Mage Ilya\u2014stand ready at opposite sides of the mat. Both remain passive until deliberately attacked and are willing to talk beforehand. A keyed door leads north to the Object Workshop, and a switch-controlled shortcut door leads northwest to the Conversation Hall.",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_a71b843f.jpg",
      "decorative_objects": [
        "padded floor mats",
        "white boundary lines",
        "padded wall bolsters",
        "empty weapon rack",
        "scoreboard chalk slate"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "LOCKED_ROOM",
      "label": "A locked room",
      "description": "Who knows what's in here?",
      "image_url": "assets/01a186c9-0a80-7d95-bc20-202984f42b50_scene_64d7792e.jpg",
      "decorative_objects": [],
      "on_enter_scene_script": "tw.story.direct(\"Give a funny explaination why this room ist still empty.\")\ntw.npcs.move_to_player(\"UNIT_SEVEN\", \"right in front of the player\")\ntw.npcs.say(\"UNIT_SEVEN\", \"Don't mind me. I am just here for the jump scare.\")",
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "SOCIAL_HALL",
      "label": "Conversation Hall (NPC Lab)",
      "description": "A brightly lit hall for social and NPC scripting experiments. In the center stands a round oak table with five chairs; four are occupied by Nora Quill, Bram Ironhand, Vesper Glass, and the automaton Unit Seven, while the fifth sits empty since Pip Fenwick wandered off to the Teleportation Lab. Clipped to the edge of the table is a laminated QA Social Hall Guide. Mounted on the north wall is the labeled Test Panel for mood, song, ongoing poison, and healing tests, and beside it stands the Crate of Absurdities.",
      "image_url": "assets/01a1842e-91c4-75fc-8323-d42e64857464_scene_d6a5daa7.jpg",
      "decorative_objects": [
        "round oak table",
        "five wooden chairs",
        "overhead brass lamp",
        "acoustic wall panels",
        "mounted room placard"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "ABSURD_ITEMS = [\n    (\"RUBBER_CHICKEN\", \"Squeaky Rubber Chicken\"),\n    (\"TIN_FOIL_CROWN\", \"Tin-Foil Conspiracy Crown\"),\n    (\"SELF_STIRRING_TEACUP\", \"Clockwork Self-Stirring Teacup\"),\n    (\"PHILOSOPHICAL_PET_ROCK\", \"Googly-Eyed Pet Rock\"),\n]\n\nABSURD_GIFT_REACTIONS = {\n    \"NORA\": {\n        \"RUBBER_CHICKEN\": \"adjusts her spectacles in disbelief, records 'one vulcanized avian acoustic device' in her ledger, and asks what citation this could possibly support\",\n        \"TIN_FOIL_CROWN\": \"reluctantly accepts the Tin-Foil Conspiracy Crown, sets it beside her inkwell, and insists she is only keeping it to debunk its cranial-shielding claims\",\n        \"SELF_STIRRING_TEACUP\": \"holds the violently whirring teacup at arm's length and warns Alex that a single drop of tea on her archival parchment will be logged as sabotage\",\n        \"PHILOSOPHICAL_PET_ROCK\": \"accepts Sir Reginald the Googly-Eyed Pet Rock with unexpected fondness, noting that a silent stone makes an ideal research assistant\",\n    },\n    \"BRAM\": {\n        \"RUBBER_CHICKEN\": \"gives the Squeaky Rubber Chicken an experimental squeeze, laughs at the honk, and says he will use it to wake up apprentices in the workshop\",\n        \"TIN_FOIL_CROWN\": \"claps the Tin-Foil Conspiracy Crown onto his head over his braided beard and jokes that maybe now it will block out Nora's endless nitpicking\",\n        \"SELF_STIRRING_TEACUP\": \"grins approvingly at the over-torqued miniature turbine on the teacup and immediately starts planning how to weld a pressure gauge onto it\",\n        \"PHILOSOPHICAL_PET_ROCK\": \"hefts Sir Reginald the Pet Rock in his scarred palm, nods with respect at its solid ballast, and promises to build it a proper iron pedestal\",\n    },\n    \"VESPER\": {\n        \"RUBBER_CHICKEN\": \"accepts the Squeaky Rubber Chicken with a poised bow and suggests using it as a talking-stick to interrupt heated debates at the table\",\n        \"TIN_FOIL_CROWN\": \"accepts the Tin-Foil Conspiracy Crown with diplomatic grace, calling it an avant-garde symbol of transparency and open-minded inquiry\",\n        \"SELF_STIRRING_TEACUP\": \"cradles the vibrating Clockwork Self-Stirring Teacup with practiced composure, praising its enthusiasm while subtly shielding their coat from spray\",\n        \"PHILOSOPHICAL_PET_ROCK\": \"welcomes Sir Reginald the Googly-Eyed Pet Rock as an impartial fifth mediator whose neutrality at the table is beyond question\",\n    },\n    \"UNIT_SEVEN\": {\n        \"RUBBER_CHICKEN\": \"accepts the Squeaky Rubber Chicken, compresses it once to measure its decibel output, and asks whether it should be filed under 'musical instruments' or 'distress beacons'\",\n        \"TIN_FOIL_CROWN\": \"places the Tin-Foil Conspiracy Crown atop its brass chassis and reports a zero-percent change in electromagnetic shielding but a twelve-percent increase in flair\",\n        \"SELF_STIRRING_TEACUP\": \"synchronizes its optical lens with the spinning teacup turbine and compliments the device's admirable commitment to rotational efficiency\",\n        \"PHILOSOPHICAL_PET_ROCK\": \"cradles Sir Reginald the Googly-Eyed Pet Rock like a cherished younger sibling and promises to teach it advanced binary small talk\",\n    },\n}\n\n\ndef on_pickup_absurd_item(item_id):\n    if item_id == \"RUBBER_CHICKEN\":\n        tw.story.direct(\n            \"Narrate how pulling the Squeaky Rubber Chicken from the crate causes it to let out a long, tragic, ear-splitting rubber wheeze that makes the whole table turn and stare.\"\n        )\n        tw.npcs.say_directed(\n            \"BRAM\",\n            \"snorts with laughter and bluntly asks if that squeaky rubber bird is what QA calls a calibrated workshop tool\",\n        )\n        tw.npcs.say_directed(\n            \"UNIT_SEVEN\",\n            \"logs the acoustic anomaly and dryly asks for clarification on why a poultry specimen has been vulcanized\",\n        )\n        return\n\n    if item_id == \"TIN_FOIL_CROWN\":\n        tw.story.direct(\n            \"Narrate how the Tin-Foil Conspiracy Crown crinkles loudly as Alex lifts it from the crate, its bent copper antennae wobbling in the lamplight.\"\n        )\n        tw.npcs.say_directed(\n            \"NORA\",\n            \"adjusts her round spectacles and skeptically demands peer-reviewed sources for tin-foil thought-shielding\",\n        )\n        tw.npcs.say_directed(\n            \"VESPER\",\n            \"diplomatically compliments the bold, reflective silhouette of the tin-foil headgear\",\n        )\n        return\n\n    if item_id == \"SELF_STIRRING_TEACUP\":\n        tw.story.direct(\n            \"Narrate how the Clockwork Self-Stirring Teacup whirs to life in Alex's hand, its miniature turbine spinning with unnecessary mechanical fury.\"\n        )\n        tw.npcs.say_directed(\n            \"VESPER\",\n            \"winces politely at the mechanical violence being inflicted upon traditional tea etiquette\",\n        )\n        tw.npcs.say_directed(\n            \"BRAM\",\n            \"grumbles approvingly that whoever geared a teacup to three thousand RPM had more torque than sense\",\n        )\n        return\n\n    if item_id == \"PHILOSOPHICAL_PET_ROCK\":\n        tw.story.direct(\n            \"Narrate how Alex lifts the Googly-Eyed Pet Rock labeled 'SIR REGINALD', its oversized plastic eyes rattling in opposite directions.\"\n        )\n        tw.npcs.say_directed(\n            \"UNIT_SEVEN\",\n            \"respectfully greets Sir Reginald as a fellow non-biological entity of admirable stoicism\",\n        )\n        tw.npcs.say_directed(\n            \"NORA\",\n            \"dryly remarks that the pet rock's testimony about the workshop door is already more consistent than Bram's\",\n        )\n\n\ndef on_social_npc_receive_item(npc_id, item_ids):\n    npc = tw.npcs.get(npc_id)\n    if not item_ids:\n        return\n    for item_id in item_ids:\n        item_name = dict(ABSURD_ITEMS).get(item_id, item_id)\n        reaction = ABSURD_GIFT_REACTIONS.get(npc_id, {}).get(\n            item_id,\n            \"inspects the \" + item_name + \" with curious appreciation and offers an in-character comment on receiving it from Alex\",\n        )\n        tw.story.direct(\n            \"Narrate a funny, lively scene as \" + npc.name + \" receives the \" + item_name + \" from Alex at the table in the Conversation Hall.\"\n        )\n        tw.npcs.say_directed(npc_id, reaction)\n\n\ndef on_social_npc_interact(npc_id):\n    tw.npcs.say_directed(\n        npc_id,\n        \"greets Alex warmly at the round oak table in the Conversation Hall, shares their current thoughts on the ongoing experiments, and chats in character\",\n    )\n\n\ndef on_absurd_item_interact(item_id):\n    if item_id == \"RUBBER_CHICKEN\":\n        tw.story.narrate(\"You give the Squeaky Rubber Chicken an experimental squeeze. It emits a loud, mournful HONK that echoes through the Conversation Hall.\")\n        tw.story.direct(\"Narrate the seated testers briefly turning their heads at the rubber chicken honk.\")\n    elif item_id == \"TIN_FOIL_CROWN\":\n        tw.story.narrate(\"You adjust the Tin-Foil Conspiracy Crown on your head. Its copper antennae wobble as you scan the room for telepathic surveillance.\")\n    elif item_id == \"SELF_STIRRING_TEACUP\":\n        tw.story.narrate(\"You tap the rim of the Clockwork Teacup. The internal turbine whirs furiously for several seconds before clicking off.\")\n    elif item_id == \"PHILOSOPHICAL_PET_ROCK\":\n        tw.story.narrate(\"You gaze into Sir Reginald's googly plastic eyes. Sir Reginald stares back with ancient, immovable tranquility.\")\n\n\ndef on_choose_npc_action(answ):\n    # 0 = angry, 1 = happy, 2 = sing, 3 = ongoing poison, 4 = heal all, 5 = leave unchanged\n    if answ == 0:\n        old_mood, new_mood = \"very happy\", \"very angry\"\n        text, direction = \"The round is getting very angry!\", \"says what they think about Alex\"\n    elif answ == 1:\n        old_mood, new_mood = \"very angry\", \"very happy\"\n        text, direction = \"The round is getting very happy!\", \"says what they think about Alex\"\n    elif answ == 2:\n        old_mood, new_mood = None, None\n        text, direction = \"The whole round bursts into song!\", \"sings a verse about Alex\"\n    elif answ == 3:\n        tw.vars.set(\"social_hall_poison_active\", True)\n        tw.story.narrate(\n            \"A cloud of acrid green test-toxin hisses from the panel vents! Every NPC in the Conversation Hall is poisoned (-10 HP, ongoing poison active).\"\n        )\n        for npc in tw.scene.npcs:\n            if npc.is_defeated or npc.is_hidden:\n                continue\n            npc.damage(10)\n            if not npc.has_trait(\"poisoned\"):\n                npc.add_trait(\"poisoned\")\n            tw.npcs.say_directed(\n                npc.id,\n                \"coughs or sparks indignantly and comments in character on what they think of Alex unleashing ongoing poison gas in the Conversation Hall\",\n            )\n        return\n    elif answ == 4:\n        tw.vars.set(\"social_hall_poison_active\", False)\n        tw.story.narrate(\n            \"A warm golden restorative mist washes over the table, neutralizing all toxins and restoring every NPC in the Conversation Hall to full health!\"\n        )\n        for npc in tw.scene.npcs:\n            if npc.is_hidden:\n                continue\n            if npc.is_defeated:\n                npc.is_defeated = False\n            if npc.has_trait(\"poisoned\"):\n                npc.remove_trait(\"poisoned\")\n            npc.heal(100)\n            tw.npcs.say_directed(\n                npc.id,\n                \"reacts in character with relief and comments on what they think about finally being healed and cured of the test toxin\",\n            )\n        return\n    else:\n        tw.story.narrate(\"You leave the panel untouched. Nothing changes at the table.\")\n        return\n\n    tw.story.narrate(text)\n    for npc in tw.scene.npcs:\n        if npc.is_defeated or npc.is_hidden:\n            continue\n        if new_mood:\n            if npc.has_trait(old_mood):\n                npc.remove_trait(old_mood)\n            npc.add_trait(new_mood)\n            tw.log.info(f\"Trait '{new_mood}' set on NPC: {npc.id}\")\n        tw.npcs.say_directed(npc.id, direction)"
    },
    {
      "id": "TELEPORT_LAB",
      "label": "Teleportation Lab",
      "description": "Interdimensionales Teleportationslabor. Eine erh\u00f6hte Metallplattform summt in der Mitte, umringt von verkabelten Kabelkn\u00e4ueln und frostbedeckten K\u00fchlleitungen. Monitore flackern an den W\u00e4nden, baumelnde Elektrodenarme zucken \u00fcber verschmorte Bodenplatten. Professor Pip Fenwick tanzt zwischen den Konsolen, kritisiert die Kreideformeln an den K\u00fchlrohren und winkt jeden Besucher ungeduldig auf die markierte Platte.",
      "image_url": "assets/01a18b89-cd56-72bd-a393-2c2e53bb548c_scene_b32d2ba2.jpg",
      "decorative_objects": [
        "raised metal platform",
        "tangled cable coils",
        "flickering ceiling panels",
        "frost-covered coolant pipes",
        "scorched floor plating",
        "wall-mounted monitor bank",
        "dangling electrode arms"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "def teleport_unit_seven():\n    attempt = tw.vars.get(\"teleport_attempt\", 0)\n    if attempt == 0:\n        tw.vars.set(\"teleport_attempt\", 1)\n        tw.npcs.get(\"LAB_RAT\").set_hidden(False)\n        tw.story.direct(\n            \"Give a funny narration of the first teleportation attempt: the console whines, sparks fly, and with a tiny anticlimactic 'plop', a bewildered white Lab Rat materializes in the center of the raised metal platform instead of Unit Seven, while a loose brass screw rattles out of the console casing and rolls across the floor.\"\n        )\n        tw.npcs.say_directed(\n            \"LAB_RAT\",\n            \"lets out confused, indignant rat squeaks and rapid chittering noises while sniffing the scorched metal platform\",\n        )\n        tw.npcs.say_directed(\n            \"PIP\",\n            \"cheerfully and humorously blames the mishap on a single loose screw in the targeting coil, celebrating the Lab Rat's arrival as a triumphant proof of concept and promising that tightening that screw will bring Unit Seven on the next try\",\n        )\n        return\n\n    if attempt == 1:\n        tw.vars.set(\"teleport_attempt\", 2)\n        tw.npcs.get(\"GRANDMA\").set_hidden(False)\n        tw.story.direct(\n            \"Give a funny narration of the second teleportation attempt: the console crackles violently, ozone fills the room, and with a heavy thud a gnarly old grandmother sitting in her plush floral TV armchair materializes right on the raised metal platform beside the startled Lab Rat.\"\n        )\n        tw.npcs.say_directed(\n            \"LAB_RAT\",\n            \"squeaks in alarm and makes frantic rat noises while scurrying around the legs of the armchair\",\n        )\n        tw.npcs.say_directed(\n            \"GRANDMA\",\n            \"confusedly and grumpily scolds everyone in the lab, complaining loudly that she was just yanked out of her living room right at the most exciting moment of her favorite TV show\",\n        )\n        tw.npcs.say_directed(\n            \"PIP\",\n            \"nervously praises the armchair's mass-transfer stability, mutters about one more tiny dial adjustment, and swears the next attempt will definitely lock onto Unit Seven\",\n        )\n        return\n\n    if attempt == 2:\n        tw.vars.set(\"teleport_attempt\", 3)\n        tw.npcs.move(\"UNIT_SEVEN\", \"TELEPORT_LAB\", \"standing on the crowded raised metal platform\")\n        tw.story.direct(\n            \"Give a funny narration of the third teleportation attempt: with a blinding flash and a loud pneumatic pop, the brass-and-ceramic automaton Unit Seven finally materializes on the crowded raised metal platform right between the squeaking Lab Rat and Grandma Gertrude's TV armchair, still holding the exact posture it had at the table in the Conversation Hall.\"\n        )\n        tw.npcs.say_directed(\n            \"UNIT_SEVEN\",\n            \"confusedly and dryly comments on the sudden spatial jump, asking why in one moment it was still in the Conversation Hall and in the very next moment it is standing in the Teleportation Lab beside an agitated rodent and an occupied armchair\",\n        )\n        return\n\n    tw.story.direct(\n        \"Narrate humorously how the console sparks and briefly lifts Unit Seven, Grandma in her TV armchair, and the Lab Rat an inch off the raised metal platform before setting them right back down in the same spot.\"\n    )\n    tw.npcs.say_directed(\n        \"UNIT_SEVEN\",\n        \"dryly asks for clarification on the purpose of teleporting the entire platform crew to the exact coordinates they are already occupying\",\n    )"
    },
    {
      "id": "TIME_MACHINE_LAB",
      "label": "Time Machine Lab",
      "description": "A futuristic testing laboratory dedicated to chronological mechanics. Copper coils hum along the vaulted ceiling, chalkboards are dense with timeline paradox equations, and wall-mounted chronometers click in synchronized cadence. At the center of the chamber stands the gleaming Chronos-5000 Time Machine, flanked by an observation periscope, a high-precision wall chronometer, and Professor Timothy Chronos pacing beside a clockwork rooster and a very sleepy dusk cat.",
      "image_url": "assets/01a196a6-e74f-723b-9a86-eb3133d70ade_scene_bbfad113.jpg",
      "decorative_objects": [
        "humming copper temporal coil",
        "wall of ticking chronometers",
        "chalkboard filled with paradox equations",
        "flickering vacuum tube bank",
        "brass observation periscope",
        "cable bundle pulsing with blue tachyon light"
      ],
      "on_enter_scene_script": "if not tw.vars.get(\"time_lab_intro_seen\", False):\n    tw.vars.set(\"time_lab_intro_seen\", True)\n    tw.story.direct(\"Alex Vale enters the Time Machine Lab. Professor Timothy Chronos looks up from a table crowded with chronometers and warmly welcomes Alex.\")\n    tw.npcs.say_directed(\"PROF_CHRONOS\", \"enthusiastically welcomes Alex to the Time Machine Lab and invites them to ask questions or try out the Chronos-5000 console\")",
      "on_enter_scene_text": "A soft hum of tachyon coils greets you as you step into the Time Machine Lab. Clocks on the walls tick in rapid unison.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": "CHRONOS_DIALOG_TREE = {\n    \"dialogue_id\": \"chronos_qa_dialog\",\n    \"npc_id\": \"PROF_CHRONOS\",\n    \"initial_node\": \"root\",\n    \"nodes\": {\n        \"root\": {\n            \"npc_text\": \"Greetings, Alex! Welcome to the Time Machine Lab! Here we push TaleWeaver's chronological engine to its absolute limits. What temporal inquiry can I illuminate for you today?\",\n            \"responses\": [\n                {\"text\": \"How does the In-Game Clock work in TaleWeaver?\", \"next_node\": \"clock_info\"},\n                {\"text\": \"How do Timers and Time Events work?\", \"next_node\": \"timers_info\"},\n                {\"text\": \"What is the difference between Narration Ticks, GM Time, and Script Time Jumps?\", \"next_node\": \"flow_info\"},\n                {\"text\": \"Tell me about Barnaby the Rooster and Schr\\u00f6dinger the Cat.\", \"next_node\": \"animals_info\"},\n                {\"text\": \"How do I operate the Chronos-5000 Time Machine?\", \"next_node\": \"machine_info\"},\n                {\"text\": \"Thank you, Professor. I'll get back to testing.\", \"next_node\": None},\n            ],\n        },\n        \"clock_info\": {\n            \"npc_text\": \"The in-game clock tracks elapsed minutes since the adventure began. The engine computes the day, 24-hour time, and pacing. You can query tw.time.now, tw.time.day, tw.time.hour, and tw.time.minute at any point in any script!\",\n            \"responses\": [\n                {\"text\": \"Tell me more about timers.\", \"next_node\": \"timers_info\"},\n                {\"text\": \"Back to main questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Understood. (Exit)\", \"next_node\": None},\n            ],\n        },\n        \"timers_info\": {\n            \"npc_text\": \"Timers allow event scheduling! tw.time.at() fires once at a target minute, tw.time.after() fires after a relative delay like '10m', and tw.time.every() repeats at fixed intervals like '24h'. When time passes their trigger threshold, their handlers execute cleanly!\",\n            \"responses\": [\n                {\"text\": \"How does time flow during player turns?\", \"next_node\": \"flow_info\"},\n                {\"text\": \"Back to main questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Understood. (Exit)\", \"next_node\": None},\n            ],\n        },\n        \"flow_info\": {\n            \"npc_text\": \"Three mechanisms advance time: 1) Narration Ticks advance round pacing (e.g. 5 minutes) every turn. 2) The Game Master LLM can add extra time for long actions if GM Time Control is enabled. 3) Scripts and the Time Machine can advance or rewind time directly via tw.time.advance() or tw.time.rewind()!\",\n            \"responses\": [\n                {\"text\": \"What about the animals in the lab?\", \"next_node\": \"animals_info\"},\n                {\"text\": \"Back to main questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Understood. (Exit)\", \"next_node\": None},\n            ],\n        },\n        \"animals_info\": {\n            \"npc_text\": \"Barnaby is our brass-feathered chronometer rooster; his internal chime triggers at exactly 06:00 every dawn. Schr\\u00f6dinger, our dusk cat, sleeps on the warm tachyon coil until exactly 18:00, when her internal dinner alarm rings. Try using the Time Machine to jump to 06:00 or 18:00 and observe them!\",\n            \"responses\": [\n                {\"text\": \"How do I operate the machine?\", \"next_node\": \"machine_info\"},\n                {\"text\": \"Back to main questions.\", \"next_node\": \"root\"},\n                {\"text\": \"Understood. (Exit)\", \"next_node\": None},\n            ],\n        },\n        \"machine_info\": {\n            \"npc_text\": \"Simply interact with the Chronos-5000 console. You can leap directly to 06:00 or 18:00, fast-forward or rewind in 1-hour increments, pause or resume time entirely, cycle the round pacing between 1m, 5m, and 30m, or arm a 10-minute paradox alarm!\",\n            \"responses\": [\n                {\"text\": \"Back to main questions.\", \"next_node\": \"root\"},\n                {\"text\": \"I'm ready to pull some levers! (Exit)\", \"next_node\": None},\n            ],\n        },\n    },\n}\n\n\ndef time_lab_clock_str():\n    d = tw.time.day\n    h = str(tw.time.hour)\n    if len(h) < 2:\n        h = \"0\" + h\n    m = str(tw.time.minute)\n    if len(m) < 2:\n        m = \"0\" + m\n    return \"Day \" + str(d) + \", \" + h + \":\" + m\n\n\ndef on_time_machine_choice(idx):\n    h = tw.time.hour\n    m = tw.time.minute\n    if idx == 0:\n        delta = (6 - h) * 60 - m if h < 6 else (24 - h + 6) * 60 - m\n        tw.time.advance(delta)\n        tw.story.narrate(\"The Chronos-5000 hums with blinding blue tachyon light! The dials whirr forward to dawn: \" + time_lab_clock_str() + \"!\")\n        rooster_crow()\n        tw.awards.grant(\"AWARD_CHRONO_PIONEER\")\n    elif idx == 1:\n        delta = (18 - h) * 60 - m if h < 18 else (24 - h + 18) * 60 - m\n        tw.time.advance(delta)\n        tw.story.narrate(\"The Chronos-5000 emits a deep violet pulse! Time surges forward into dusk: \" + time_lab_clock_str() + \"!\")\n        cat_meow()\n        tw.awards.grant(\"AWARD_CHRONO_PIONEER\")\n    elif idx == 2:\n        tw.time.advance(60)\n        tw.story.narrate(\"Tachyon turbines spin up! Time advances by 60 minutes. Current time: \" + time_lab_clock_str())\n    elif idx == 3:\n        tw.time.rewind(60)\n        tw.story.narrate(\"Gears clatter in counter-clockwise reverse! Time rewinds by 60 minutes. Current time: \" + time_lab_clock_str())\n    elif idx == 4:\n        if tw.time.is_paused:\n            tw.time.resume()\n            tw.story.system(\"In-game clock RESUMED. Narration ticks and GM time changes will advance time normally.\")\n        else:\n            tw.time.pause()\n            tw.story.system(\"In-game clock PAUSED. Time is frozen; narration ticks and GM requests are locked.\")\n    elif idx == 5:\n        cur = tw.time.minutes_per_tick\n        if cur == 5:\n            tw.time.set_minutes_per_tick(1)\n            tw.story.system(\"Pacing changed: 1 minute per turn (Precision mode).\")\n        elif cur == 1:\n            tw.time.set_minutes_per_tick(30)\n            tw.story.system(\"Pacing changed: 30 minutes per turn (Hyper-speed mode).\")\n        else:\n            tw.time.reset_minutes_per_tick()\n            tw.story.system(\"Pacing reset to default: 5 minutes per turn.\")\n    elif idx == 6:\n        if tw.time.has_timer(\"PARADOX_ALARM\"):\n            tw.time.cancel(\"PARADOX_ALARM\")\n            tw.story.system(\"Active Paradox Alarm has been disarmed.\")\n        else:\n            tw.time.after(\"10m\", paradox_alarm, timer_id=\"PARADOX_ALARM\")\n            tw.story.system(\"Paradox countdown armed! The alarm will trigger in 10 in-game minutes.\")\n            tw.npcs.say_directed(\"PROF_CHRONOS\", \"warns Alex nervously that the 10-minute paradox countdown is now ticking down\")\n    else:\n        tw.story.narrate(\"You step back from the Chronos-5000 console.\")"
    },
