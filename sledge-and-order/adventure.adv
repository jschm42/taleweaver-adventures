  "sequences": [
    {
      "id": "SEQ_1_FRONT_OF_HOUSE",
      "order": 1,
      "title": "Chapter 1: Hash-House Slang & The Register Key",
      "description": "Detective Jack Steele begins in the Diner Entrance Vestibule and enters the Main Dining Room. He must figure out how to unlock Betty's Cash Register to get the Brass Kitchen Key.",
      "walkthrough": "1. Read the ##MATCHBOOK in your starting inventory to get Charlie's initial clue.\n2. Search/open the ##COAT_RACK in DINER_ENTRANCE and take the ##THICK_COAT and ##NOTEPAD_STUB. Read ##NOTEPAD_STUB to learn how the 3-digit Cash Register PIN is formed (First digit = number of red vinyl booths in MAIN_DINING_ROOM; Second & third digits = price of 'Adam & Eve on a Raft').\n3. Move to MAIN_DINING_ROOM. Count the decorative booths (there are 4 red vinyl booths) and read ##BETTYS_ORDER_PAD on the counter.\n4. Move via RESTROOM_HALLWAY to MEN_ROOM and read ##DINER_SLANG_DICTIONARY to learn that 'Adam & Eve on a Raft' is Two Poached Eggs on Toast (which costs 85 cents on Betty's order pad).\n5. Return to MAIN_DINING_ROOM, unlock ##CASH_REGISTER with code 485, and take ##KITCHEN_KEY and ##CRUMPLED_RECEIPT.",
      "end_condition": "",
      "required_item_id": "KITCHEN_KEY",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 1: Blend in at the counter and find a way into the locked kitchen.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the brass kitchen key in your pocket, the back of the house is now within reach."
    },
    {
      "id": "SEQ_2_KITCHEN_AND_LOCKERS",
      "order": 2,
      "title": "Chapter 2: Behind the Swinging Doors",
      "description": "Jack unlocks the kitchen door, explores the back areas, solves the staff locker riddle, and pieces together the 4-digit walk-in freezer keypad code.",
      "walkthrough": "1. Unlock the exit from MAIN_DINING_ROOM to KITCHEN using ##KITCHEN_KEY and enter KITCHEN.\n2. Open ##KITCHEN_CABINET in KITCHEN and take ##ENERGY_DRINK and ##SUPPLIER_NOTE. Read ##SUPPLIER_NOTE to learn the first two digits of the Walk-In Freezer code: 74.\n3. In RESTROOM_HALLWAY, read ##HALLWAY_SIGN to get the riddle for the Staff Locker ('I have cities, but no houses; mountains, but no trees; and water, but no fish. What am I?' -> Answer: MAP).\n4. Enter STAFF_LOCKER_ROOM from KITCHEN, unlock ##STAFF_LOCKER using code MAP, and take/read ##FREEZER_CODE_MEMO to learn the last two digits of the freezer code: 19 (making full code 7419).",
      "end_condition": "",
      "required_item_id": "FREEZER_CODE_MEMO",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 2: Search the kitchen and break room to piece together the walk-in freezer combination.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You now have both halves of the freezer code: 7419."
    },
    {
      "id": "SEQ_3_ICEBOX_RESCUE",
      "order": 3,
      "title": "Chapter 3: Cold Storage Rescue",
      "description": "Jack unlocks the walk-in freezer in the pantry, rescues Toothpick Charlie before he freezes, and recovers Charlie's hidden note with the second half of Vinny's safe code.",
      "walkthrough": "1. Make sure you have the ##THICK_COAT from the vestibule coat stand so the sub-zero cold in the freezer doesn't drain your health.\n2. Enter PANTRY from KITCHEN and unlock the exit to WALK_IN_FREEZER using code 7419.\n3. Enter WALK_IN_FREEZER, talk to TOOTHPICK_CHARLIE, open ##FREEZER_RACK_BIN, and take ##SECRET_MEMO. Taking possession of the memo in the freezer immediately frees Charlie and gets him safely out of the cold, completing this chapter and setting charlie_rescued to true. If you already carry the memo when you enter, the same rescue happens immediately on arrival. Reading is not required for the rescue.\n4. Read ##SECRET_MEMO to learn the second half of the Manager's Safe code (24), which combines with ##CRUMPLED_RECEIPT (36) to make 3624.",
      "end_condition": "",
      "required_item_id": "SECRET_MEMO",
      "required_scene_id": "WALK_IN_FREEZER",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 200,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 3: Unlock the walk-in freezer and get Toothpick Charlie out alive.",
      "on_end_sequence_script": "charlie_rescued = true;",
      "on_end_sequence_text": "Toothpick Charlie is safe, and you have the combination to Vinny's floor safe!"
    },
    {
      "id": "SEQ_4_SYNDICATE_LEDGER",
      "order": 4,
      "title": "Chapter 4: Cracking the Syndicate Safe",
      "description": "Jack finds the Manager's Office Key in the basement, uses the steam boiler valve to lure Vinny out of his office, unlocks the office and the floor safe, and seizes the Mob Ledger.",
      "walkthrough": "1. Go from KITCHEN down to BASEMENT_STAIRS. Open ##BASEMENT_CRATE, then open ##GREASY_LUNCHBOX inside it to take ##OFFICE_KEY.\n2. Flip/switch the ##BOILER_VALVE in BASEMENT_STAIRS from NORMAL to OVERLOAD. This triggers a steam racket that lures Manager Vinny out of MANAGER_OFFICE down to BASEMENT_STAIRS.\n3. Go up through KITCHEN and MAIN_DINING_ROOM to RESTROOM_HALLWAY. Unlock the exit to MANAGER_OFFICE using ##OFFICE_KEY.\n4. Enter MANAGER_OFFICE, unlock ##MANAGER_SAFE with code 3624, and pick up ##MOB_LEDGER to complete the mission.",
      "end_condition": "",
      "required_item_id": "MOB_LEDGER",
      "required_scene_id": "MANAGER_OFFICE",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 4: Lure Vinny out of his office, unlock his door, and crack the syndicate safe.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "Case closed! You have the Moretti Syndicate Payoff Ledger and Charlie is alive to testify."
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_FREEZER_CHILL",
      "name": "Sub-Zero Freezer Hazard",
      "trigger": "on_enter_scene",
      "target_id": "WALK_IN_FREEZER",
      "target": "WALK_IN_FREEZER",
      "code": "if not tw.player.has_item('THICK_COAT'):\n    tw.vars.set('freezer_frostbite', True)\n    tw.player.damage(15)\n    tw.story.show_message('Bitter sub-zero air cuts right through your thin trench coat! (-15 HP. You should grab the heavy coat from the entrance!)')\nelse:\n    tw.story.show_message('Your heavy fleece-lined parka keeps the brutal freezer cold at bay.')",
      "description": "Damages the player if they enter the walk-in freezer without carrying the thick coat."
    },
    {
      "id": "SCRIPT_OFFICE_INTRUSION_CHECK",
      "name": "Manager Office Intrusion Check",
      "trigger": "on_enter_scene",
      "target_id": "MANAGER_OFFICE",
      "target": "MANAGER_OFFICE",
      "code": "if not tw.vars.get('boiler_diverted', False):\n    tw.story.show_message('Vinny glares at you from behind his desk! You cannot crack his safe while he is standing right here—divert him with the basement boiler first!')\nelse:\n    tw.story.show_message('With Vinny downstairs tending to the clanging boiler, the office—and his floor safe—are all yours.')",
      "description": "Warns the player if Vinny is still in the office when they enter, or confirms the coast is clear if the boiler valve was overloaded."
    }
  ]
}