  "protagonist": {
    "name": "Detective Jack Steele",
    "role": "Undercover Detective",
    "description": "A hard-boiled city detective with a sharp eye and a rumpled trench coat, currently posing as a drifter looking for night-shift work at the mob-run Greasy Spoon diner.",
    "goal": "Find missing informant Toothpick Charlie before he freezes to death and gather hard evidence of the Moretti family's corruption.",
    "character": "Cynical, observant, quick-witted, and fiercely loyal to his informants.",
    "appearance": "rugged middle-aged detective, stubble, fedora hat, rumpled beige trench coat, sharp grey eyes",
    "profile_image": "assets/8aadeb2b-744f-4411-9f80-f97b18957e3b_protagonist_e384d470.jpg",
