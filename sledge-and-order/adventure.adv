  "scenes": [
    {
      "id": "DINER_ENTRANCE",
      "label": "Diner Entrance Vestibule",
      "description": "A cramped, drafty glass vestibule separating the rain-lashed street from the warm haze of the diner. Water pools on the checkered linoleum floor, and the buzz of the overhead neon tube is loud enough to set your teeth on edge.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_6d09d4a3.jpg",
      "decorative_objects": [
        "flickering red neon sign",
        "wet rubber floor mat",
        "umbrella stand",
        "steamed-up glass door",
        "vintage payphone with cut cord"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Rain rattles against the vestibule glass.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "MAIN_DINING_ROOM",
      "label": "Main Dining Room",
      "description": "A long, chrome-trimmed dining car smell of bacon grease and stale cigarette smoke. Red vinyl booths line the rain-streaked windows, while a scarred Formica counter runs the length of the room. A pass-through window behind the counter leads toward the kitchen, and a dim hallway branches off toward the restrooms.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_0502183a.jpg",
      "decorative_objects": [
        "red vinyl booth #1",
        "red vinyl booth #2",
        "red vinyl booth #3",
        "red vinyl booth #4",
        "silent Wurlitzer jukebox",
        "revolving pie display case"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The bell above the door jingles softly as Betty eyes you from behind the counter.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "RESTROOM_HALLWAY",
      "label": "Restroom Hallway",
      "description": "A narrow, yellowing corridor smelling faintly of pine disinfectant and damp plaster. The floorboards creak underfoot. Doors lead to the men's and women's restrooms, and a heavy service door with a brass keyhole stands at the far end.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_7a2d4de4.jpg",
      "decorative_objects": [
        "peeling wallpaper",
        "dim wall sconce",
        "fire extinguisher bracket",
        "scuffed baseboard"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "MEN_ROOM",
      "label": "Men's Restroom",
      "description": "A grimy tiled restroom lit by a single bare bulb. The mirror above the sink is cracked down the middle, and water drips rhythmically from a corroded faucet.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_307ef484.jpg",
      "decorative_objects": [
        "cracked wall mirror",
        "stained porcelain sink",
        "rusty paper towel dispenser",
        "graffiti-covered stall door"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "WOMEN_ROOM",
      "label": "Women's Restroom",
      "description": "Surprisingly cleaner than the men's room, though the pastel pink tiles are faded with age. A small Louvered vent high on the wall carries the muffled rumble of the kitchen exhaust.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_450762d8.jpg",
      "decorative_objects": [
        "faded pink wall tiles",
        "oval vanity mirror",
        "wicker wastebasket",
        "porcelain soap dish"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "KITCHEN",
      "label": "Diner Kitchen",
      "description": "Heat radiates from the massive flat-top grill where grease splatters and hisses. Stainless steel prep tables gleam under harsh fluorescent tubes. Passages lead to the dishwasher station, the dry pantry, the staff locker room, and down toward the basement.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_93b77d7f.jpg",
      "decorative_objects": [
        "sizzling flat-top grill",
        "hanging copper pots",
        "overhead exhaust hood",
        "magnetic knife strip",
        "order ticket wheel"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Gus bangs a spatula against the grill, sending up a shower of grease sparks.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "DISHWASHER_STATION",
      "label": "Dishwasher Alcove",
      "description": "A humid, steam-choked corner of the back kitchen dominated by an industrial conveyor dishwasher and deep aluminum sinks piled high with encrusted plates.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_9fb63be2.jpg",
      "decorative_objects": [
        "industrial dishwashing machine",
        "stacks of greasy plates",
        "coiled high-pressure sprayer",
        "slatted wooden duckboard floor"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "PANTRY",
      "label": "Dry Pantry",
      "description": "Wire shelves packed with #10 tin cans of tomatoes, sacks of flour, and gallons of fry oil crowd this narrow storage room. At the back stands the heavy insulated door of the walk-in freezer, its digital keypad glowing an ominous icy blue.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_fafa1a34.jpg",
      "decorative_objects": [
        "burlap flour sacks",
        "rows of #10 tomato cans",
        "plastic jugs of cooking oil",
        "hanging flypaper strip"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A faint, desperate tapping sound echoes from behind the thick insulated freezer door.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "WALK_IN_FREEZER",
      "label": "Walk-In Freezer",
      "description": "Bitter sub-zero air bites at any exposed skin. Frost coats the aluminum walls, and sides of beef hang from ceiling hooks like pale ghosts. Ice crystals swirl in the blast of the overhead evaporator fan.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_7936844f.jpg",
      "decorative_objects": [
        "hanging beef carcasses",
        "frost-covered evaporator fan",
        "icicles hanging from ceiling",
        "frozen cardboard meat boxes"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The freezing air hits your lungs like shattered glass.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "STAFF_LOCKER_ROOM",
      "label": "Staff Break & Locker Room",
      "description": "A cramped room with a wobbly card table, an ashtray overflowing with butts, and a row of dented grey metal lockers. A bulletin board on the wall is plastered with shift schedules and kitchen memos.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_b2eddb91.jpg",
      "decorative_objects": [
        "wobbly folding card table",
        "overflowing glass ashtray",
        "cork bulletin board",
        "scuffed folding chairs"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "MANAGER_OFFICE",
      "label": "Manager's Office",
      "description": "Wood-paneled walls and heavy velvet curtains try to give this cramped office some class, but the smell of cheap cigars ruins the effect. A mahogany desk dominates the room, flanked by a heavy steel safe and a filing cabinet.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_e9b8a6c9.jpg",
      "decorative_objects": [
        "mahogany executive desk",
        "green glass banker's lamp",
        "framed portrait of Don Moretti",
        "brass cigar humidor",
        "rotary desk telephone"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BASEMENT_STAIRS",
      "label": "Basement Boiler Room",
      "description": "Concrete steps descend into a cavernous cellar dominated by a wheezing cast-iron steam boiler and a web of insulated pipes. Shadows stretch across stacks of illicit liquor crates.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_41a2310b.jpg",
      "decorative_objects": [
        "cast-iron steam boiler",
        "hissing overhead steam pipes",
        "bare hanging light bulb",
        "coal shovel leaning on wall"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The old boiler groans and rattles in the damp underground heat.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BACK_ALLEY",
      "label": "Rainy Back Alley",
      "description": "A slick cobblestone alley hemmed in by brick walls and overflowing dumpsters. Rainwater gurgles down a clogged storm drain while steam vents from the diner's kitchen exhaust above.",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_scene_babd0d52.jpg",
      "decorative_objects": [
        "overflowing green dumpster",
        "rusty fire escape ladder",
        "clogged iron storm drain",
        "stacks of wet milk crates"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Cold rain lashes your face in the narrow alleyway.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
