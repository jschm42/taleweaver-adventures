    "language": "English",
    "original_prompt": "Detective Jack Steele goes undercover at the Greasy Spoon diner, a front for the mob. His informant, Toothpick Charlie, is missing. Steele must navigate the diner's suspicious staff, learn their slang, find keys, crack a safe, and unlock the walk-in freezer before Charlie freezes to death. Along the way, he uncovers evidence of mob corruption.",
    "image_url": "assets/sledge-and-order-argon-co-tmbfozio_cover_7f6c5fee.jpg",
    "rule_enforcement_mode": "story",
    "time_per_turn": 5,
    "pacing_minutes": 5,
    "max_time_per_turn": null,
