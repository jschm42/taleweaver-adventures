  "npcs": [
    {
      "id": "BETTY",
      "entity_type": "NPC",
      "name": "Waitress Betty",
      "description": "A sharp-tongued veteran waitress with a beehive hairdo, chewing gum at a mile a minute while wiping down the counter. She knows everyone who comes in and doesn't trust strangers who don't speak proper diner lingo.",
      "appearance": "middle-aged waitress, blonde beehive hair, pink diner uniform, white apron, cat-eye glasses",
      "current_scene_id": "MAIN_DINING_ROOM",
      "spatial_position": "standing behind the Formica counter near the cash register",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_betty_78d07792.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "If Jack studies the DINER_SLANG_DICTIONARY or orders using proper slang ('Adam and Eve on a raft, wreck em, with a cup of Joe'), she warms up and mentions the register lock riddle.",
      "goal": "Get through her double shift without crossing Vinny's mobsters, and keep nosy strangers out of the kitchen.",
      "character": "Sassy, observant, street-smart, softened only when someone speaks true old-school hash-house slang.",
      "hp": 60,
      "max_hp": 60,
      "mana": 0,
      "max_mana": 0,
      "stamina": 70,
      "max_stamina": 70,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Betty pops her gum. 'Take any booth you like, hon, long as you know how to order.'"
    },
    {
      "id": "GUS",
      "entity_type": "NPC",
      "name": "Short-Order Gus",
      "description": "A burly line cook in a grease-stained singlet with forearm tattoos from the merchant marine. He flips burgers with militant precision and guards his kitchen territory fiercely.",
      "appearance": "burly cook, bald head, sweatband, grease-stained white apron, anchor tattoo, holding metal spatula",
      "current_scene_id": "KITCHEN",
      "spatial_position": "flipping patties in front of the sizzling flat-top grill",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_gus_f5f4a1bc.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows that Vinny hid half of the freezer code in the staff locker room and half on a delivery invoice.",
      "goal": "Keep the grill hot, protect his secret spice stash, and stay out of Vinny's freezer business.",
      "character": "Grumpy, overworked, irritable, but respects hard workers and anyone who brings him a cold energy drink.",
      "hp": 85,
      "max_hp": 85,
      "mana": 0,
      "max_mana": 0,
      "stamina": 80,
      "max_stamina": 80,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Gus glares through the grill smoke. 'You the new relief help? Don't touch my knives.'"
    },
    {
      "id": "DAVE",
      "entity_type": "NPC",
      "name": "Dishwasher Dave",
      "description": "A nervous, lanky teenager soaked to the elbows in soapy dishwater. His eyes dart constantly toward the pantry door, clearly terrified of what Vinny locked inside the freezer.",
      "appearance": "skinny teenage dishwasher, messy brown hair, wet rubber apron, yellow dish gloves, wide nervous eyes",
      "current_scene_id": "DISHWASHER_STATION",
      "spatial_position": "hunched over the steaming aluminum scrub sink",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_dave_248dbbe4.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Saw Vinny drop the OFFICE_KEY inside the greasy lunchbox in the basement after locking Charlie in the freezer.",
      "goal": "Survive his shift without getting locked in the freezer like the guy in the trench coat earlier.",
      "character": "Jittery, exhausted, talkative once reassured, desperate for an energy boost.",
      "hp": 45,
      "max_hp": 45,
      "mana": 0,
      "max_mana": 0,
      "stamina": 50,
      "max_stamina": 50,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Dave nearly drops a stack of saucers. 'Man, tell me you're not with Vinny's crew...'"
    },
    {
      "id": "VINNY",
      "entity_type": "NPC",
      "name": "Manager Vinny",
      "description": "A slick, middle-aged mob associate in a pinstriped suit and silk tie, puffing on a cheap stogie. He runs the Greasy Spoon as Don Moretti's laundry mat and doesn't tolerate rats.",
      "appearance": "slick mob manager, slicked-back black hair, pinstripe suit, gold pinky ring, chewing a cigar",
      "current_scene_id": "MANAGER_OFFICE",
      "spatial_position": "leaning against the mahogany executive desk",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_vinny_13d23694.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "MOVABLE",
      "moveable": true,
      "allowed_scenes": [
        "MANAGER_OFFICE",
        "BASEMENT_STAIRS"
      ],
      "notes": "When the BOILER_VALVE in the basement is switched to OVERLOAD, Vinny rushes down to the basement to check the pipes, leaving the office unattended.",
      "goal": "Let Toothpick Charlie freeze until he's ready to talk, and protect the syndicate's ledger in his safe.",
      "character": "Arrogant, paranoid, calculating, easily panicked if the basement boiler starts acting up.",
      "hp": 75,
      "max_hp": 75,
      "mana": 0,
      "max_mana": 0,
      "stamina": 70,
      "max_stamina": 70,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Vinny narrows his eyes through a cloud of cigar smoke. 'Who let you back here, pal?'"
    },
    {
      "id": "ENFORCER",
      "entity_type": "NPC",
      "name": "Frankie 'The Brick' Moretti",
      "description": "A mountain of a man in a camel-hair overcoat, sheltering under the back alley awning while keeping watch over the rear delivery entrance.",
      "appearance": "hulking mob enforcer, scarred jaw, dark fedora, heavy camel-hair overcoat, leather gloves",
      "current_scene_id": "BACK_ALLEY",
      "spatial_position": "standing under the metal awning beside the dumpster",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_enforcer_5e540250.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Guarding the alley crate. Distracted if you talk about the matchbook or boiler noise.",
      "goal": "Make sure nobody sneaks out the back with the syndicate's books or rescues the rat in the freezer.",
      "character": "Stoic, intimidating, obsessed with horse racing tips and his missing lucky ##MATCHBOOK.",
      "hp": 100,
      "max_hp": 100,
      "mana": 0,
      "max_mana": 0,
      "stamina": 95,
      "max_stamina": 95,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Frankie cracks his knuckles in the rain. 'Alley's closed for deliveries, friend.'"
    },
    {
      "id": "TOOTHPICK_CHARLIE",
      "entity_type": "NPC",
      "name": "Toothpick Charlie",
      "description": "A wiry street informant shivering violently in a thin plaid jacket, his lips blue from the sub-zero cold and a signature wooden toothpick still clenched between his chattering teeth.",
      "appearance": "wiry shivering man, frost on eyebrows, thin plaid jacket, flat cap, toothpick in mouth",
      "current_scene_id": "WALK_IN_FREEZER",
      "spatial_position": "huddled between frozen cardboard meat boxes in the corner",
      "image_url": "assets/sledge-and-order-argon-co-tmbfozio_toothpick-charlie_5556c6ec.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Needs the THICK_COAT to warm up and survive. Once rescued, reveals the final safe clue.",
      "goal": "Get warmed up before hypothermia finishes him off and tell Detective Steele how to crack Vinny's safe.",
      "character": "Jittery, streetwise, grateful, sharp memory for numbers even when half-frozen.",
      "hp": 40,
      "max_hp": 40,
      "mana": 0,
      "max_mana": 0,
      "stamina": 50,
      "max_stamina": 50,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Charlie's teeth chatter violently. 'J-Jack? Thank God... I c-can't feel my fingers!'"
    }
