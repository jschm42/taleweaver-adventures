    {
      "id": "SUBJECT_ZERO",
      "entity_type": "NPC",
      "name": "Dr. Vance ('Subject Zero')",
      "description": "Once the lead xenobiologist of Outpost Tartarus, Dr. Vance's lower body has fused into the petrified mycelium floor. Copper wires pierced through his temples keep his mind his own. He knows the combination to his safe (7391) if you help him or trade salvaged tech, and carries a spare med-stim.",
      "appearance": "half-assimilated scientist fused with fungal roots, copper wires in skull, lab coat, glowing eyes",
      "current_scene_id": "SUBJECT_ZERO_NEST",
      "spatial_position": "fused into a throne of petrified mycelium behind the radio workbench",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_subject-zero_e78bf066.jpg",
      "is_hidden": false,
