  "scenes": [
    {
      "id": "CRASH_POD",
      "label": "Shattered Escape Pod",
      "description": "The cramped interior of the Icarus escape pod is a mangled cage of scorched titanium and sparking conduits. Thick ropes of violet alien sinew are already creeping through breaches in the hull, tasting the warm air. An emergency medical locker hangs half-off its hinges beside the buckled pilot seat.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_58f02c69.jpg",
      "decorative_objects": [
        "buckled pilot seat",
        "sparking overhead conduit",
        "cracked armored viewport",
        "creeping violet sinew",
        "scorched instrument panel"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The residual heat of atmospheric entry mingles with the coppery stench of alien tissue.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "EMERGENCY_RAMP",
      "label": "Collapsed Emergency Ramp",
      "description": "The deployment ramp of the pod has sheared into a jagged metal bridge resting atop a pulsing shelf of bruised red muscle. Steam hisses from ruptured coolant lines, and an orange supply pod lies wedged in the fleshy mire near the base of the ramp.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_9dbb8663.jpg",
      "decorative_objects": [
        "ruptured coolant line",
        "sheared hydraulic strut",
        "pulsing shelf of red muscle",
        "scorched warning stencil"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CRASH_PERIMETER",
      "label": "Fleshy Crash Crater",
      "description": "A wide impact crater where the planet's dermal layer was torn open by the crash. Lymphatic fluid pools in translucent amber puddles around smoldering hull plates. To the north rises the broken spine of the main cargo bay, while a canyon of white bone yawns to the east.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_925dfb14.jpg",
      "decorative_objects": [
        "amber lymphatic puddle",
        "smoldering hull plate",
        "twitching nerve cluster",
        "charred thruster nozzle"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The ground contracts beneath your boots like a vast diaphragm.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CARGO_SPINE",
      "label": "Broken Cargo Spine",
      "description": "The rib-like superstructure of the Icarus cargo hold juts from the crater floor like the carcass of a metallic whale. Alien tendrils have woven around the cargo racks, encapsulating most of the freight in hardened chitin, save for a reinforced wreckage lockbox and a flickering power node.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_ab49e423.jpg",
      "decorative_objects": [
        "bent titanium girder",
        "chitin-encased freight crate",
        "shattered cargo manifest screen",
        "dripping resin stalactite"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BONE_GULLY",
      "label": "Calcified Bone Gully",
      "description": "A narrow ravine walled by towering, fused ribs of calcium that grew upward to wall off the crash site. The air smells of ozone and marrow. Predator scratches score the pale bone walls, leading deeper toward a resin-choked hollow and a towering calcified gate.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_ff302b5f.jpg",
      "decorative_objects": [
        "towering fused bone rib",
        "deep predator claw marks",
        "porous marrow floor",
        "hollow wind-chimney"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Wind whistles mournfully through the porous bone ribs above.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "RESIN_SHELTER",
      "label": "Amber Resin Hollow",
      "description": "A cavernous pocket beneath an overhang of ossified plates, sealed against the wind by sheets of translucent amber resin. An earlier expedition left behind a field camp here; their gear is half-swallowed by hardened sap, including a locked field case. A preserved insectoid husk hangs in the resin wall, its six legs clearly visible beside an expedition tag reading 'CARRION LEAPER'.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_6216bcd4.jpg",
      "decorative_objects": [
        "translucent amber resin wall",
        "preserved insectoid husk",
        "collapsed thermal tent",
        "dead camp lantern"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "VEIN_SINK",
      "label": "Subterranean Vein Sink",
      "description": "A vertical sinkhole drops into a throbbing arterial tunnel beneath the planet's crust. Massive blue-violet vessels as thick as aqueducts pulse along the walls, circulating warm nutrient ichor. The tunnel branches northeast toward the forest roots, avoiding surface predators.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_190915df.jpg",
      "decorative_objects": [
        "throbbing arterial vessel",
        "warm bioluminescent mist",
        "calcified valve ring",
        "slick membrane floor"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A deafening lub-dub reverberates through the arterial walls.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CALCIFIED_GATE",
      "label": "The Calcified Gate",
      "description": "Where the bone gully meets the bioluminescent forest, the planet has erected a grotesque sphincter of interlocking bone teeth. Beside it stands an ancient human survey pylon wired directly into the nerve cluster of the bone arch.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_873e6371.jpg",
      "decorative_objects": [
        "interlocking bone teeth",
        "rusted survey pylon",
        "spliced neural cable",
        "bleached xenofauna skull"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "WHISPERING_FOREST_EDGE",
      "label": "Whispering Mycelium Edge",
      "description": "Towering stalks of pale blue fungi rise fifty feet into the purple gloom. Their gill-caps vibrate at resonant frequencies that sound unsettlingly like human whispers repeating old distress calls. Soft carpets of filter moss glow along the roots.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_5a09da6a.jpg",
      "decorative_objects": [
        "giant vibrating gill-cap",
        "pale blue fungal trunk",
        "drifting luminescent motes",
        "tangled root mat"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Faint, mimicked voices echo from the fungal caps: '...help us... quarantine...'",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "HUNTER_DEN",
      "label": "Chitinous Hunter Den",
      "description": "A hollowed-out fungal bole reeking of musk and dissolved bone. Multi-limbed predators lair here, dragging scavenged human equipment and prey into a central mound of cartilage and mucus.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_9b7b8c59.jpg",
      "decorative_objects": [
        "mucus-coated bone mound",
        "shed chitin carapace",
        "shredded hazard suit",
        "acid-etched helmet"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SUBJECT_ZERO_NEST",
      "label": "Subject Zero's Sanctuary",
      "description": "Tucked inside a dead hollow of petrified mycelium, someone has strung copper wire and radio repeaters to ward off the planetary hive-mind. Old medical notes, glass alembics, and blinking transceiver units surround a makeshift workbench.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_05ab08b9.jpg",
      "decorative_objects": [
        "copper Faraday webbing",
        "crackling radio repeater",
        "stained glass alembic",
        "scrawled anatomical chart"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Static crackles from a speaker, followed by a raspy, half-human voice.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SPORE_CHOKE",
      "label": "The Toxic Spore Choke",
      "description": "A low basin between the forest and Outpost Tartarus where dense clouds of crimson neuro-spores hang like blood fog. Blisters on the ground periodically burst, replenishing the lethal haze. Breathing this air without chemical suppression tears at the lungs.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_b5b3e3e3.jpg",
      "decorative_objects": [
        "bursting crimson spore-blister",
        "blood-red fog bank",
        "corroded warning beacon",
        "skeletonized survey rover"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Thick crimson spores swirl around your visor, burning your throat.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BIOLUMINESCENT_MARSH",
      "label": "Bioluminescent Bile Marsh",
      "description": "East of the spore basin lies a stagnant mire of neon-green digestive enzymes and floating bladder-kelp. Half-submerged in the glowing sludge sits an ejected orbital drop-pod from Outpost Tartarus, its hull hissing softly against the acid.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_93e5bf47.jpg",
      "decorative_objects": [
        "neon-green enzyme pool",
        "floating bladder-kelp",
        "corroded drop-pod hull",
        "bubbling gas vent"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "TARTARUS_PERIMETER",
      "label": "Outpost Tartarus Perimeter",
      "description": "A reinforced concrete apron where human engineering wages a losing war against planetary encroachment. Automated defense turrets lie twisted in coils of calcified tendon, and the massive blast doors of Outpost Tartarus loom ahead behind a quarantine security kiosk.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_b5f1de94.jpg",
      "decorative_objects": [
        "crushed automated turret",
        "razor-wire choked with tendon",
        "faded quarantine biohazard sign",
        "cracked ferrocrete apron"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Searchlights sweep erratically across the overgrown blast doors of Outpost Tartarus.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "QUARANTINE_AIRLOCK",
      "label": "Decontamination Airlock",
      "description": "The heavy entry chamber of Outpost Tartarus smells of stale chemical disinfectant and dried blood. Red emergency strobes bathe the stainless steel walls in crimson pulses. Nozzle arrays overhead drip harmless condensation onto the grated floor.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_8a3d5faa.jpg",
      "decorative_objects": [
        "red emergency strobe",
        "dry chemical shower nozzle",
        "steel floor grating",
        "claw-marked airlock window"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Automated speakers chime: 'WARNING. CLASS-X BIOLOGICAL CONTAMINATION DETECTED.'",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "TARTARUS_ATRIUM",
      "label": "Tartarus Central Atrium",
      "description": "The central hub of the xenobiology station is a cathedral of cold steel invaded by pulsing biomass. A massive central pillar houses the station's Caretaker AI core, while armored corridors branch off toward the Xenobiology Lab, the Auto-Doc Chamber, and the upper Subspace Comms Tower.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_95e6d2a6.jpg",
      "decorative_objects": [
        "holo-projector flickering with static",
        "overturned security barricade",
        "biomass-draped ceiling catwalk",
        "shattered station directory"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "XENO_LAB",
      "label": "Xenobiology Research Lab",
      "description": "Rows of shattered stasis cylinders line this laboratory, their specimen fluids long since spilled and congealed. High-grade surgical instruments, centrifuge racks, and the Chief Xenobiologist's secure vault remain intact at the far end of the room.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_675dfa2d.jpg",
      "decorative_objects": [
        "shattered glass stasis cylinder",
        "high-speed centrifuge",
        "autopsied alien specimen tray",
        "flickering electron microscope"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "AUTO_DOC_CHAMBER",
      "label": "Surgical Auto-Doc Chamber",
      "description": "A sterile surgical bay dominated by a gleaming Mark-VII Automated Surgical Pod ringed with robotic laser scalpels and biopsy arms. The pod's diagnostic monitor blinks in standby mode, awaiting a calibrated surgical laser cartridge to perform deep-tissue parasite extraction.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_68392f16.jpg",
      "decorative_objects": [
        "articulated robotic scalpel arm",
        "vitrine of surgical clamps",
        "biometric vital-signs monitor",
        "blood-stained operating table"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The Auto-Doc's optical sensors whir and lock onto the parasitic mass in your side.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "COMMS_TOWER",
      "label": "Subspace Comms Tower",
      "description": "At the apex of Outpost Tartarus, panoramic armored glass overlooks the writhing purple horizon of Proxima-9. The primary subspace transmitter console hums with reserve power, ready to beam a distress beacon into deep space once authorized.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_8f5292a0.jpg",
      "decorative_objects": [
        "panoramic armored window",
        "parabolic dish status holo",
        "banks of cooling capacitors",
        "captain's swivel chair"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CRYO_PANIC_ROOM",
      "label": "Armored Cryo Panic Room",
      "description": "An impenetrable bunker of triple-layered durasteel deep behind the surgical bay, completely isolated from the planet's biomass. A single emergency cryogenic stasis pod stands open in the center, misting with pale blue liquid nitrogen.",
      "image_url": "assets/crashed-on-proxima-9-argo-9e896erg_scene_905675cf.jpg",
      "decorative_objects": [
        "triple-layered durasteel wall",
        "liquid nitrogen manifold",
        "life-support telemetry bank",
        "thermal insulation seal"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Cold nitrogen mist curls around your boots inside the silent sanctuary.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
