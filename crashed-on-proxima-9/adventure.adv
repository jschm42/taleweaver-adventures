  "sequences": [
    {
      "id": "SEQ_1_WRECKAGE_SCAVENGE",
      "order": 1,
      "title": "Chapter 1: Blood in the Wreckage",
      "description": "Kaelen wakes in the shattered escape pod of the Icarus with a ravenous parasite draining his health every turn. Guide the player to scavenge immediate medical supplies, unlock the Wreckage Lockbox in the Broken Cargo Spine, and enter the Calcified Bone Gully.",
      "walkthrough": "1. In CRASH_POD, open ##ICARUS_MED_LOCKER to take ##FIELD_BANDAGE and ##PILOT_LOG_FRAGMENT. Read ##PILOT_LOG_FRAGMENT to learn about the Supply Pod.\n2. Move to EMERGENCY_RAMP and open ##SUPPLY_POD to get ##RATIONS_TUBE and ##WRECKAGE_ACCESS_CARD.\n3. Move to CRASH_PERIMETER and open ##CRATER_DEBRIS_POD to take ##BIOFUEL_NODE_1 and ##SALVAGE_PLAS.\n4. Move north to CARGO_SPINE and unlock ##WRECKAGE_LOCKBOX using ##WRECKAGE_ACCESS_CARD to obtain ##BIO_PLASMA_CUTTER and ##SURVIVAL_SYRINGE.\n5. Return to CRASH_PERIMETER and head east into BONE_GULLY to complete this sequence.",
      "end_condition": "",
      "required_item_id": "SURVIVAL_SYRINGE",
      "required_scene_id": "BONE_GULLY",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 1: Scavenge the Icarus wreckage for survival gear before the parasite drains your strength.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "Armed with scavenged gear from the Icarus, you press into the Calcified Bone Gully."
    },
    {
      "id": "SEQ_2_CALCIFIED_CANYONS",
      "order": 2,
      "title": "Chapter 2: The Calcified Canyons",
      "description": "Kaelen must survive the Antibody Stalker in the Bone Gully, solve the field case combination in the Amber Resin Hollow, and breach the Calcified Gate or navigate the subterranean Vein Sink into the Whispering Mycelium Forest.",
      "walkthrough": "1. In BONE_GULLY, defeat IMMUNE_SENTINEL_1 and take ##REGEN_GLAND_1 (optionally combine ##REGEN_GLAND_1 + ##SURVIVAL_SYRINGE to craft ##POTENT_REGEN_SALVE for +35 HP immediately and a 50 HP consumable).\n2. Enter RESIN_SHELTER and read ##SURVIVAL_MANUAL. It gives the 3-digit clue for ##LOCKED_FIELD_CASE: Planet number (9), decorative objects in RESIN_SHELTER (4), legs on a Carrion Leaper (6) -> Code: 946.\n3. Unlock ##LOCKED_FIELD_CASE with code 946 to obtain ##BIOFUEL_NODE_2 and ##VEIN_MAP.\n4. Choose either path to WHISPERING_FOREST_EDGE:\n   - Path A (Vein Shortcut): Go to VEIN_SINK, loot ##NUTRIENT_PASTE from ##VEIN_ARTERY_POD, and unlock the exit to WHISPERING_FOREST_EDGE using ##VEIN_MAP.\n   - Path B (Calcified Gate): Combine ##BIOFUEL_NODE_1 + ##BIOFUEL_NODE_2 to craft ##OVERCHARGED_BIO_CELL, go to CALCIFIED_GATE, and activate ##GATE_NERVE_SWITCH to unlock the gate to WHISPERING_FOREST_EDGE.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "WHISPERING_FOREST_EDGE",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 2: Find a way past the Calcified Canyons or through the subterranean Vein Sink.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You emerge beneath the towering, whispering stalks of the Mycelium Forest."
    },
    {
      "id": "SEQ_3_MYCELIUM_AND_SPORES",
      "order": 3,
      "title": "Chapter 3: Whispers in the Spores",
      "description": "In the Whispering Mycelium Forest, Kaelen must harvest reagents, coax or trade with Subject Zero (Dr. Vance) for his safe code, synthesize the Spore Suppressant, and cross the Toxic Spore Choke to reach Outpost Tartarus.",
      "walkthrough": "1. In WHISPERING_FOREST_EDGE, open ##GLAND_BASKET to collect ##FILTER_MOSS and ##CATALYST_VIAL.\n2. Optionally visit HUNTER_DEN, defeat CARRION_LEAPER_1 for ##REGEN_GLAND_2, and open ##DEN_CACHE for ##CHITIN_GRAFT_VEST and ##DEN_KEY.\n3. Enter SUBJECT_ZERO_NEST and talk to SUBJECT_ZERO (or trade him ##SALVAGE_PLAS). He reveals the 4-digit safe code: 7391. Also take ##BASIC_MEDSTIM_2.\n4. Unlock ##SUBJECT_ZERO_SAFE with code 7391 to get ##TARTARUS_KEYCARD and ##SPORE_FORMULA_NOTE.\n5. Combine ##FILTER_MOSS and ##CATALYST_VIAL to craft ##SPORE_SUPPRESSANT (which protects against the Spore Choke damage and unlocks the Parasitic Lash special attack).\n6. Cross SPORE_CHOKE (defeating SPORE_MITE_SWARM; optionally detour to BIOLUMINESCENT_MARSH to use ##DEN_KEY on ##SUNKEN_CAPSULE for ##CRYO_OVERRIDE_CHIP) and reach TARTARUS_PERIMETER.",
      "end_condition": "",
      "required_item_id": "TARTARUS_KEYCARD",
      "required_scene_id": "TARTARUS_PERIMETER",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 200,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 3: Seek out Subject Zero in the forest and synthesize a suppressant for the Toxic Spore Choke.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the Quarantine Keycard in hand, you stand before the blast doors of Outpost Tartarus."
    },
    {
      "id": "SEQ_4_BREACHING_TARTARUS",
      "order": 4,
      "title": "Chapter 4: The Caretaker's Quarantine",
      "description": "Kaelen must defeat the Assimilated Security Chief at the perimeter, cycle the decontamination airlock, and destroy the rogue M.O.T.H.E.R. Caretaker AI in the Central Atrium.",
      "walkthrough": "1. At TARTARUS_PERIMETER, defeat ASSIMILATED_BRUTE and take ##COMMS_CYPHER_PART_1 (reads '48--'). Open ##PERIMETER_GUARD_LOCKER to read ##GUARD_LOG_TABLET for the Xeno Lab Vault riddle hint.\n2. Unlock the outer blast door to QUARANTINE_AIRLOCK using ##TARTARUS_KEYCARD.\n3. In QUARANTINE_AIRLOCK, pull ##AIRLOCK_PURGE_SWITCH to unlock the inner bulkhead.\n4. Enter TARTARUS_ATRIUM and defeat ROGUE_CARETAKER_AI to complete this sequence.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "TARTARUS_ATRIUM",
      "required_defeated_npc_id": "ROGUE_CARETAKER_AI",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 4: Breach Outpost Tartarus and shut down the rogue M.O.T.H.E.R. Caretaker AI.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the Caretaker AI neutralized, the station's surgical and communications wings lie open."
    },
    {
      "id": "SEQ_5_EXTRACTION_AND_STASIS",
      "order": 5,
      "title": "Chapter 5: Surgical Extraction & SOS",
      "description": "In the final sequence, Kaelen unlocks the Xeno Lab Vault to get the Surgical Laser Cartridge, extracts the parasite in the Auto-Doc Chamber, broadcasts the SOS from the Comms Tower using the combined 4-digit cypher, and enters stasis in the Armored Cryo Panic Room.",
      "walkthrough": "1. In TARTARUS_ATRIUM, open ##ATRIUM_SUPPLY_CHEST to get ##COMMS_CYPHER_PART_2 (reads '--26'). Combined with Part 1 ('48--'), the Comms PIN is 4826.\n2. Enter XENO_LAB and unlock ##XENO_LAB_VAULT with the riddle answer password 'MYCELIUM' to obtain ##SURGICAL_LASER_CARTRIDGE and read ##XENO_RESEARCH_JOURNAL.\n3. Enter AUTO_DOC_CHAMBER, optionally open ##SURGICAL_CABINET for ##STEM_CELL_PACK, and activate ##AUTO_DOC_CONSOLE using ##SURGICAL_LASER_CARTRIDGE to extract the parasite and stop the HP drain.\n4. Go to COMMS_TOWER and activate ##SUBSPACE_TRANSMITTER_SWITCH with code 4826 to broadcast the SOS.\n5. Return to AUTO_DOC_CHAMBER, pass through the unlocked hatch into CRYO_PANIC_ROOM, and activate ##CRYO_STASIS_POD_SWITCH to win the adventure!",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "tw.vars.get('parasite_extracted', False) == True and tw.vars.get('sos_broadcasted', False) == True and tw.vars.get('entered_cryo', False) == True",
      "exp_reward": 350,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 5: Extract the parasite in the Auto-Doc, broadcast the SOS from the Comms Tower, and seal yourself in the Cryo Panic Room.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You have survived Proxima-9!"
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_PARASITIC_DRAIN",
      "name": "Relentless Parasitic Drain",
      "trigger": "on_turn_end",
      "target_id": null,
      "target": null,
      "code": "if not tw.vars.get('parasite_extracted', False):\n    tw.player.damage(2)\n    turns = tw.vars.get('infection_turns', 0) + 1\n    tw.vars.set('infection_turns', turns)\n    if turns % 3 == 0:\n        tw.story.show_message('The parasite in your side pulses hungrily, siphoning your vitality (-2 HP).')",
      "description": "Drains 2 HP at the end of every turn until the parasite is surgically extracted in the Auto-Doc Chamber."
    },
    {
      "id": "SCRIPT_SPORE_CHOKE_HAZARD",
      "name": "Toxic Spore Choke Hazard",
      "trigger": "on_enter_scene",
      "target_id": "SPORE_CHOKE",
      "target": "SPORE_CHOKE",
      "code": "if not tw.player.has_item('SPORE_SUPPRESSANT'):\n    tw.player.damage(8)\n    tw.story.show_message('CHOKING HAZARD! Without a Synthesized Spore Suppressant, the crimson neuro-spores sear your lungs (-8 HP)!')\nelse:\n    tw.story.show_message('Your Synthesized Spore Suppressant neutralizes the crimson neuro-spores as you breathe.')",
      "description": "Inflicts 8 HP spore damage when entering the Toxic Spore Choke without the Synthesized Spore Suppressant."
    },
    {
      "id": "SCRIPT_SUBJECT_ZERO_TRADE",
      "name": "Subject Zero Salvage-Plas Trade",
      "trigger": "on_interact",
      "target_id": "SUBJECT_ZERO",
      "target": "SUBJECT_ZERO",
      "code": "if tw.player.has_item('SALVAGE_PLAS') and not tw.vars.get('traded_with_zero', False):\n    tw.vars.set('traded_with_zero', True)\n    tw.player.remove_item('SALVAGE_PLAS')\n    tw.player.heal(20)\n    tw.story.show_message('Subject Zero eagerly weaves your Salvage-Plas into his Faraday cage, injects you with a stabilizer (+20 HP), and rasps: \"My lead safe code is 7391!\"')",
      "description": "When interacting with Subject Zero while carrying Salvage-Plas, trades it for a +20 HP stabilizer injection and reveals safe code 7391."
    }
  ]
}