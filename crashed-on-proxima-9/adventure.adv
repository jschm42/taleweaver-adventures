      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "If Kaelen talks to Subject Zero, persuades him, or offers SALVAGE_PLAS, Subject Zero reveals the code '7391' for SUBJECT_ZERO_SAFE (which holds TARTARUS_KEYCARD and SPORE_FORMULA_NOTE).",
      "goal": "Preserve his remaining human consciousness and help Kaelen purge the station's rogue AI.",
      "character": "Feverish, erratic, speaking through radio static and his own vocal cords at once, yet fiercely helpful.",
