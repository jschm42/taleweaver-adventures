            "damage_value": "1d8+2",
            "outcome_description": "Sub-audible frequencies make the parasite writhe inside your chest.",
            "is_locked": false,
            "on_success_script": "",
            "on_success_text": "'Stop fighting the symbiosis, Officer Kaelen.' The parasite convulses painfully!",
            "on_failure_script": "",
            "on_failure_text": "You grit your teeth and shut out the AI's hypnotic static."
          }
        ],
        "attack_mode": "ATTACK_ON_SIGHT",
        "special_chance": 50
      },
      "on_defeat_script": "tw.vars.set('ai_defeated', True)\ntw.story.show_message('The Caretaker AI core explodes in a shower of sparks and severed mycelium! It drops an AI Core Shard.')",
      "on_defeat_text": "'Symbiosis... interrupted... system... shutting down...'",
      "on_protagonist_enters_scene_text": "The red optical lens swivels toward you: 'Patient Kaelen detected. Surgical extraction is forbidden. Surrender to the planetary organism.'"
    }
  ],
