  "npcs": [
    {
      "id": "IMMUNE_SENTINEL_1",
      "entity_type": "NPC",
      "name": "Antibody Stalker",
      "description": "A faceless quadruped of braided muscle and bone plates spawned by Proxima-9 to sterilize foreign matter around the crash crater.",
