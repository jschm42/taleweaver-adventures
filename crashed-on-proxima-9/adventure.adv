  "adventure": {
    "origin_id": "336119af-f2b9-46ae-9035-8c0300bc4492",
    "title": "Crashed on Proxima-9",
    "teaser": "Infected by a ravenous alien parasite on a living world, every step toward the cure costs blood.",
    "cover_appearance": "shattered starship in fleshy purple crater, glowing bioluminescent veins, bone canyons, ominous",
    "version": "3.0.0",
    "creator": "Jean Schmitz",
