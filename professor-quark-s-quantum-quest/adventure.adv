    {
      "id": "SCRIPT_INIT_ENTROPY",
      "name": "Initialize Anomaly Telemetry",
      "trigger": "on_init",
      "target_id": null,
      "target": null,
      "code": "tw.vars.set('entropy_level', 10)\ntw.vars.set('spacetime_restored', False)",
      "description": "Initializes the starting entropy level and completion state flag."
    },
    {
      "id": "SCRIPT_ELECTRON_COIL_SYNC",
      "name": "Stabilize Ee the Electron",
      "trigger": "on_interact",
      "target_id": "ELECTRON_EE",
      "target": "ELECTRON_EE",
      "code": "if tw.player.has_item('CHARGED_COIL') and not tw.vars.get('electron_stabilized', False):\n    tw.vars.set('electron_stabilized', True)\n    tw.player.modify_xp(50)\n    tw.story.show_message('The Superconducting Solenoid Coil harmonizes Ee\\'s orbital spin! Ee cheers: \"Remember, my family is LEPTON!\" (+50 XP)')",
      "description": "Grants bonus XP and a helpful hint when interacting with Ee while holding the Charged Coil."
    },
    {
      "id": "SCRIPT_APEX_RESONATOR_CHECK",
      "name": "Apex Resonator Stabilization",
      "trigger": "on_enter_scene",
      "target_id": "OBSERVATORY_APEX",
      "target": "OBSERVATORY_APEX",
      "code": "if tw.player.has_item('GUT_STABILIZER') and not tw.vars.get('spacetime_restored', False):\n    tw.vars.set('spacetime_restored', True)\n    tw.story.show_message('You slot the Grand Unified Theory Stabilizer into the Apex Resonator! Professor Quark\\'s holograms merge back into flesh and blood as the university stabilizes!')\nelif not tw.player.has_item('GUT_STABILIZER'):\n    tw.story.show_message('The Resonator crackles wildly! You still need to combine the Quantum Badge, Gravity Badge, and Protostar Seeds into the GUT Stabilizer!')",
      "description": "Checks if the player brings the crafted GUT Stabilizer into the Observatory Apex to complete the adventure."
    }
  ]
