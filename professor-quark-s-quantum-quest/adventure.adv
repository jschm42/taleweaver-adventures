        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "'Time-is-relative-Novak! Check-the-four-grandfather-clocks-and-the-Timekeepers-Sign!'"
    },
    {
      "id": "MADAM_ENTROPY",
      "entity_type": "NPC",
      "name": "Madam Entropy",
      "description": "The tall, silver-haired head librarian wearing a shawl woven from shredded overdue notices, smiling serenely as books slide off shelves around her.",
      "appearance": "tall older woman, silver beehive hair, dark librarian dress, floating paper scraps, glasses",
      "current_scene_id": "ENTROPY_ARCHIVE",
      "spatial_position": "lounging beside a frost-covered filing cabinet",
      "image_url": "assets/npc_a9f75303_a1a8a8e8-0520-414b-83d7-69432f301c65_madam-entropy_85be30e6.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows the second half of the Entropy Strongbox code ('73') if spoken to or coaxed.",
      "goal": "Celebrate disorder while testing whether Alex truly understands the Second Law of Thermodynamics.",
      "character": "Snarky, theatrical, secretly helpful if entertained with a good snack or clever deduction.",
      "hp": 85,
      "max_hp": 85,
      "mana": 50,
      "max_mana": 50,
      "stamina": 80,
      "max_stamina": 80,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "'Why tidy up the universe, dear? Chaos requires so much less paperwork. Though if you want my strongbox suffix, just ask nicely about my favorite prime number: 73.'"
    },
    {
      "id": "ELECTRON_EE",
      "entity_type": "NPC",
      "name": "Ee the Lost Electron",
      "description": "A jittery, basketball-sized sphere of crackling blue charge wearing oversized safety goggles, buzzing anxiously around the synchrotron ring.",
      "appearance": "glowing blue energy sphere, cartoon safety goggles, crackling lightning arcs, floating",
      "current_scene_id": "PARTICLE_LAB",
      "spatial_position": "ricocheting softly between magnetic containment tubes",
      "image_url": "assets/npc_7d3d2759_a1a8a8e8-0520-414b-83d7-69432f301c65_electron-ee_b7565da7.jpg",
      "is_hidden": false,
      "npc_type": "BEING",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Provides the riddle answer 'spin' or 'lepton' hints for the Particle Cabinet.",
      "goal": "Regain magnetic stabilization via a Charged Coil so it can return to its valence shell.",
      "character": "Hyperactive, nervous, fiercely negative in outlook.",
      "hp": 60,
      "max_hp": 60,
      "mana": 120,
      "max_mana": 120,
      "stamina": 100,
      "max_stamina": 100,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "'Bzzzt! I'm so negative today! I have no internal structure, yet I belong to the family called LEPTON!'"
    },
