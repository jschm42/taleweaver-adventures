  "npcs": [
    {
      "id": "HOLOGRAM_QUARK_CORE",
      "entity_type": "NPC",
      "name": "Hologram Quark (Core Fragment)",
      "description": "A flickering blue-white hologram of Professor Quentin Quark wearing a tweed jacket and wild Einstein hair, gesturing frantically at floating equations.",
      "appearance": "older professor hologram, glowing blue translucent, wild white hair, tweed jacket, bow tie",
      "current_scene_id": "CENTRAL_ATRIUM",
      "spatial_position": "hovering above the central projector pedestal",
      "image_url": "assets/npc_d00e6499_a1a8a8e8-0520-414b-83d7-69432f301c65_hologram-quark-core_80589fe3.jpg",
      "is_hidden": false,
