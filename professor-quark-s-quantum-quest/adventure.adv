      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows how to combine the badges once collected.",
      "goal": "Guide Alex Novak to collect the Paradigm Badges and synthesize the GUT Stabilizer.",
      "character": "Eccentric, scatterbrained, enthusiastic, speaks in rapid-fire astrophysics metaphors.",
      "hp": 100,
      "max_hp": 100,
      "mana": 100,
      "max_mana": 100,
      "stamina": 100,
      "max_stamina": 100,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "'Remember, Novak: observation collapses wavefunctions, and coffee collapses sleep schedules!'"
    },
    {
      "id": "HOLOGRAM_QUARK_QUANTUM",
      "entity_type": "NPC",
      "name": "Hologram Quark (Quantum Mode)",
      "description": "A neon-cyan projection of Professor Quark that splits into two overlapping copies whenever he shrugs, holding an imaginary cat box.",
      "appearance": "cyan hologram professor, split double image, lab coat, glowing quantum orbitals",
      "current_scene_id": "SCHRODINGER_CAFETERIA",
      "spatial_position": "phasing in and out beside the espresso counter",
      "image_url": "assets/npc_5ba28121_a1a8a8e8-0520-414b-83d7-69432f301c65_hologram-quark-quantum_bbd45a55.jpg",
      "is_hidden": false,
      "npc_type": "BEING",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Explains the Cafeteria Menu Board riddle for the Lunch Crate.",
      "goal": "Test the student's grasp of wave-particle duality and uncertainty in the Cafeteria.",
      "character": "Playful, paradoxical, refuses to give a yes-or-no answer without probabilities.",
      "hp": 100,
      "max_hp": 100,
      "mana": 100,
      "max_mana": 100,
      "stamina": 100,
      "max_stamina": 100,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "'Am I hungry, or have I already eaten? Until you open the Lunch Crate, I am both!'"
    },
    {
      "id": "HOLOGRAM_QUARK_RELATIVITY",
      "entity_type": "NPC",
      "name": "Hologram Quark (Relativity Mode)",
      "description": "A crimson-tinted projection of Professor Quark moving in extreme slow motion while his voice chatters at chipmunk speed.",
      "appearance": "redshifted hologram professor, motion blur trails, pocket watch in hand, waistcoat",
      "current_scene_id": "RELATIVISTIC_LIBRARY",
