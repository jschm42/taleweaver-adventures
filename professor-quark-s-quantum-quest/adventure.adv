  "scenes": [
    {
      "id": "CENTRAL_ATRIUM",
      "label": "The Central Atrium",
      "description": "The grand rotunda of the Physics Building is caught in a gentle gravitational eddy. Loose syllabus sheets orbit a bronze bust of Isaac Newton like miniature planetary rings, while a shimmering holographic pedestal hums at the center of the mosaic floor. Hallways branch off toward the Cafeteria, the Library, the Particle Lab, and the Gravity Stairwell.",
      "image_url": "assets/scene_e96736d8_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_d852f93d.jpg",
      "decorative_objects": [
        "floating syllabus sheets",
        "bronze bust of Isaac Newton",
        "cracked marble mosaic floor",
        "holographic projector pedestal",
        "Suspended vending machine",
        "flickering neon banner"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The low hum of the fractured spacetime field vibrates in your molars.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SCHRODINGER_CAFETERIA",
      "label": "The Schrodinger Cafeteria",
      "description": "Every dining tray in this bright, tiled hall exists in a blurry superposition of Taco Tuesday and Mystery Meat Monday until you look directly at it. Stainless steel serving counters warp at the edges, and a massive quantum probability wave ripples across the linoleum floor.",
      "image_url": "assets/scene_c2956085_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_061e6f0c.jpg",
      "decorative_objects": [
        "flickering sneeze guard",
        "superimposed dining tables",
        "floating salt and pepper shakers",
        "glowing waveform floor tiles",
        "quantum espresso machine"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your stomach feels simultaneously full and completely empty as you cross the threshold.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "RELATIVISTIC_LIBRARY",
      "label": "The Relativistic Library",
      "description": "Towering mahogany bookshelves curve inward along warped geodesics, their upper shelves redshifted into a deep crimson glow while the reading desks near the entrance shimmer with blueshifted violet light. Four grandfather clocks stand in the corners, each ticking at a wildly different tempo.",
      "image_url": "assets/scene_019da5a8_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_b0aeca5a.jpg",
      "decorative_objects": [
        "four asynchronous grandfather clocks",
        "redshifted upper bookshelves",
        "blueshifted reading lamps",
        "curved oak study carrels",
        "floating card catalog drawers"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your footsteps echo before your shoes even touch the carpet.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "PARTICLE_LAB",
      "label": "The Standard Model Particle Lab",
      "description": "A sterile, circular chamber dominated by a miniature synchrotron ring that pulses with iridescent Cherenkov radiation. Magnetic containment tubes line the walls, and the air smells sharply of ozone and ionized copper.",
      "image_url": "assets/scene_573bb147_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_0e97c203.jpg",
      "decorative_objects": [
        "miniature synchrotron ring",
        "glowing Cherenkov coolant tubes",
        "stainless steel lab bench",
        "oscilloscope bank",
        "magnetic warning decals"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Tiny static sparks dance harmlessly across your knuckles.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "ENTROPY_ARCHIVE",
      "label": "The Entropy Archive",
      "description": "Beneath the library lies a labyrinth of filing cabinets slowly dissolving into unsorted piles of paper dust. Half the room is freezing cold while the other half shimmers with desert-like heat, violating equilibrium at every turn.",
      "image_url": "assets/scene_7688f746_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_3bd0dc31.jpg",
      "decorative_objects": [
        "frost-covered filing cabinets",
        "heat-warped metal shelving",
        "scattered punch cards",
        "brass barometer",
        "overflowing paper shredder"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A gust of warm and freezing air swirls around you in defiance of thermal equilibrium.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "DARK_MATTER_BOILER_ROOM",
      "label": "The Dark Matter Boiler Room",
      "description": "Massive cast-iron boilers and tangled copper pipes groan under unseen gravitational mass. Invisible currents of non-baryonic matter drift through the dim sub-basement, bending the light of the bare maintenance bulbs into strange Einstein rings.",
      "image_url": "assets/scene_8b810296_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_ca66f95e.jpg",
      "decorative_objects": [
        "cast-iron steam boiler",
        "lensing light bulbs",
        "heavy lead shielding plates",
        "hissing pressure gauges",
        "rusted catwalk grating"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your clothes suddenly feel three times heavier as unseen mass presses down on the room.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "GRAVITY_STAIRWELL",
      "label": "The Escher Gravity Stairwell",
      "description": "Staircases spiral along the walls, ceiling, and floor in impossible perspectives. Directional arrows painted on the concrete point upward, sideways, and diagonally, waiting for a local vector shift to align the path toward the upper floors.",
      "image_url": "assets/scene_fbd47e91_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_7be7f64b.jpg",
      "decorative_objects": [
        "inverted iron handrails",
        "sideways emergency exit sign",
        "floating dust motes",
        "spiral concrete landings",
        "painted vector arrows"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your inner ear spins as up and down argue over which way your feet should point.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "COSMIC_GARDEN",
      "label": "The Cosmic Greenhouse",
      "description": "An indoor botanical dome where luminescent nebulae bloom inside glass terrariums and miniature protostars hover above beds of hydroponic moss. Solar wind chimes tinkle softly in a vacuum breeze that shouldn't carry sound.",
      "image_url": "assets/scene_8c1f7246_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_806c3559.jpg",
      "decorative_objects": [
        "glass nebula terrariums",
        "hydroponic moss beds",
        "solar wind chimes",
        "uv grow lamps",
        "floating watering can"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The scent of ozone and night-blooming jasmine fills your lungs.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "DEANS_OFFICE",
      "label": "The Dean's Singularity Suite",
      "description": "Luxurious leather armchairs and framed diplomas orbit slowly around the center of the mahogany-paneled office, where a miniature event horizon hovers above the executive blotter. Time and academic bureaucracy move at a glacial crawl here.",
      "image_url": "assets/scene_7acc0fc0_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_d032fc20.jpg",
      "decorative_objects": [
        "mahogany executive desk",
        "orbiting framed diplomas",
        "tufted leather armchair",
        "miniature desk singularity",
        "brass pendulum clock"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The red tape of university administration exerts a literal gravitational pull here.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "OBSERVATION_WALKWAY",
      "label": "The Relativistic Skybridge",
      "description": "A glass-enclosed skybridge spanning the upper campus, offering a dizzying view of the purple space-time bubble encasing the university. Cosmic rays streak harmlessly past the reinforced panes like neon rain.",
      "image_url": "assets/scene_7fbec48f_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_43e6346f.jpg",
      "decorative_objects": [
        "reinforced glass floor panels",
        "glowing structural girders",
        "cosmic ray shutters",
        "emergency intercom box",
        "telescope mount"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Outside the glass, the stars of the night sky smear into brilliant streaks of light.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "TEMPORAL_OBSERVATORY",
      "label": "The Temporal Observatory",
      "description": "A domed chamber housing brass chronometers, star charts from epochs yet to come, and a massive astrolabe spinning backward. Ripples of causal energy shimmer around the base of the spiral ladder leading up to the Apex.",
      "image_url": "assets/scene_4197289d_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_97da96b6.jpg",
      "decorative_objects": [
        "spinning brass astrolabe",
        "future star charts",
        "chronometer console",
        "velvet rope barrier",
        "curved copper dome ribs"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "You catch a fleeting glimpse of yourself leaving the room five seconds ago.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "OBSERVATORY_APEX",
      "label": "The Observatory Apex",
      "description": "At the highest peak of the university, the roof dome stands open to a swirling maelstrom of raw cosmological equations. At the focal point of the main telescope sits the Grand Unified Theory Resonator, crackling with unstable energy as it awaits the final calibration.",
      "image_url": "assets/scene_3c328d75_a1a8a8e8-0520-414b-83d7-69432f301c65_scene_fec96e4e.jpg",
      "decorative_objects": [
        "Grand Unified Theory Resonator",
        "giant refracting telescope",
        "crackling Tesla coils",
        "floating chalkboards",
        "iris roof shutter"
      ],
      "on_enter_scene_script": "if tw.player.has_item('GUT_STABILIZER') and not tw.vars.get('spacetime_restored', False):\n    tw.vars.set('spacetime_restored', True)\n    tw.story.show_message('The GUT Stabilizer locks into the Resonator! A harmonic wave sweeps across the campus, knitting Professor Quark and spacetime back together!')",
      "on_enter_scene_text": "The roar of the collapsing anomaly vibrates through the steel deck beneath your boots.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
