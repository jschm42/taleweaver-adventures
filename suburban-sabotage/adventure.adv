  "npcs": [
    {
      "id": "CAT_WHISKERS",
      "entity_type": "NPC",
      "name": "Mr. Whiskers the Cat",
      "description": "A sleek, smug tuxedo cat lounging on the living room carpet, twitching his whiskers whenever he hears the crinkle of a catnip bag.",
      "appearance": "sleek black and white tuxedo cat, green eyes, long white whiskers, smug expression",
      "current_scene_id": "LIVING_ROOM",
      "spatial_position": "curled up near the living room coffee table",
      "image_url": "assets/73da4ef5_cat-whiskers.jpg",
      "is_hidden": false,
      "npc_type": "ANIMAL",
      "movement_type": "MOVABLE",
      "moveable": true,
      "allowed_scenes": [
        "LIVING_ROOM",
        "BACKYARD"
      ],
      "goal": "Nap in sunbeams and devour Crunchy Catnip Treats wherever they are scattered.",
      "character": "Aloof, greedy for catnip, and fast enough to outrun any bulldog.",
      "hp": 45,
      "max_hp": 45,
      "mana": 0,
      "max_mana": 0,
      "stamina": 90,
      "max_stamina": 90,
      "voice": "TX3LPaxmHKxFdv7VOQHJ",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_text": "Mr. Whiskers purrs lazily and sniffs the air for catnip.",
      "on_receive_item_script": "for item_id in received_item_ids:\n    tw.npcs.give_to_player('CAT_WHISKERS', item_id)\nif 'CAT_TREATS' in received_item_ids:\n    tw.story.narrate('Mr. Whiskers purrs greedily and eyes the bag of treats. If you drop the catnip treats out in the backyard, he will sprint right past Buster\\'s doghouse!')\nelse:\n    tw.story.narrate('Mr. Whiskers yawns arrogantly and ignores it.')"
    },
    {
      "id": "DAD",
      "entity_type": "NPC",
      "name": "Dad",
      "description": "A slightly chubby, sweating suburban father in a damp polo shirt, kneeling beside the flooded kitchen sink and panicking about his mother's impending visit.",
      "appearance": "chubby middle-aged man, sweating, glasses, stained polo shirt, khaki pants, kneeling by sink",
      "current_scene_id": "KITCHEN",
      "spatial_position": "kneeling under the leaking kitchen sink",
      "image_url": "assets/7030183b_dad.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Unscrew the clogged kitchen sink pipe with his golden wrench and keep his 'Sports Magazines' hidden.",
      "character": "Flustered, conflict-averse, desperate to please Grandma, and comically bad at lying.",
      "hp": 80,
      "max_hp": 80,
      "mana": 0,
      "max_mana": 0,
      "stamina": 70,
      "max_stamina": 70,
      "voice": "cPoqAvGWCPfCfyPMwe4z",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "if tw.flags.get('CASSEROLE_THAWED') and not tw.vars.get('casserole_baked', False):\n    tw.npcs.say('DAD', \"Remember, Jack: Grandma's casserole MUST be baked inside her precious Ming dish! Don't let her see it in anything else!\")\nelif tw.vars.get('sink_fixed', False):\n    tw.npcs.say('DAD', \"The sink is finally draining! Now figure out why your Grandpa's key and a mini hacksaw were jammed inside our drainpipe!\")\nelif not tw.vars.get('dad_locker_hint_given', False):\n    tw.vars.set('dad_locker_hint_given', True)\n    tw.npcs.say('DAD', 'Jack, I need my golden wrench from the Mancave! And whatever you do, stay away from my locker down there! Mom thinks the code is our anniversary, hah! Nope. It is the numbers I admire most on my Miss Fitness July poster... well, only the upper half of them. Do not tell your mother!')\nelse:\n    tw.npcs.say('DAD', 'Golden wrench, Jack! Mancave! And keep your sticky fingers off my locker, you hear me?')\n",
      "on_receive_item_script": "if 'GOLDEN_WRENCH' in received_item_ids:\n    tw.vars.set('sink_fixed', True)\n    tw.objects.reveal('BOX_KEY')\n    tw.objects.move_item('BOX_KEY', 'player')\n    tw.npcs.say('DAD', 'My golden wrench! Let me unscrew this U-bend... Wait a second! Why was there a mini hacksaw and a small brass key with a waterproof tag jammed inside our sink pipe?! Take this key, Jack!')\n    check_victory()\nelif 'SPORTS_MAGAZINES' in received_item_ids:\n    tw.npcs.give_to_player('DAD', 'SPORTS_MAGAZINES')\n    tw.npcs.say('DAD', 'ARE YOU OUT OF YOUR MIND, SON?! Hide those immediately! Uh... I mean, those are highly advanced orthopedic journals about beach calisthenics! If your mother or Grandma sees my \"Sports Magazines\", I am a dead man!')\nelse:\n    for item_id in received_item_ids:\n        tw.npcs.give_to_player('DAD', item_id)\n    tw.npcs.say('DAD', 'That won\\'t loosen this rusted pipe, buddy! I need my golden wrench!')"
    },
    {
      "id": "DOG_BUSTER",
      "entity_type": "NPC",
      "name": "Buster the Dog",
      "description": "A stocky, muscular English bulldog wearing a spiked collar, guarding a massive meaty bone in front of his backyard doghouse with low growls.",
      "appearance": "stocky English bulldog, brown and white coat, spiked collar, fierce scowl, guarding bone",
      "current_scene_id": "BACKYARD",
      "spatial_position": "crouched in front of the red wooden doghouse",
      "image_url": "assets/ef2e7b5c_dog-buster.jpg",
      "is_hidden": false,
      "npc_type": "ANIMAL",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Protect his juicy bone from little hands and chase Mr. Whiskers the cat on sight.",
      "character": "Stubborn, territorial about bones, and 100% obsessed with chasing cats.",
      "hp": 65,
      "max_hp": 65,
      "mana": 0,
      "max_mana": 0,
      "stamina": 85,
      "max_stamina": 85,
      "voice": "1BfrkuYXmEwp8AWqSLWk",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "tw.player.damage(5)\ntw.story.narrate('Buster growls menacingly in front of his doghouse and snaps at your hand (-5 HP)! Unless he is distracted by his arch-nemesis the cat, you will never get that bone.')",
      "on_receive_item_script": "for item_id in received_item_ids:\n    tw.npcs.give_to_player('DOG_BUSTER', item_id)\ntw.story.narrate('Buster ignores your offering and guards his meaty bone fiercely. Only chasing a cat in the backyard would make him abandon his post!')"
    },
    {
      "id": "GRANDMA",
      "entity_type": "NPC",
      "name": "Grandma",
      "description": "Dad's towering, aristocratic mother Evelyn in a fur-trimmed coat, pearl necklace, and white inspection gloves, clutching an eviction folder.",
      "appearance": "wealthy elderly woman, silver updo, pearl necklace, fur collar coat, white gloves, stern scowl",
      "current_scene_id": "KITCHEN",
      "spatial_position": "standing imperiously in the center of the kitchen",
      "image_url": "assets/5297d507_grandma.jpg",
      "is_hidden": true,
      "reveal_rule": "script",
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Find any excuse to evict the Millers at 18:00 and fund a luxury yacht for her poolboy Raul.",
      "character": "Imperious, hypocritical, icy, and secretly terrified of Paragraph 7 of her marriage contract.",
      "hp": 90,
      "max_hp": 90,
      "mana": 0,
      "max_mana": 0,
      "stamina": 75,
      "max_stamina": 75,
      "voice": "wGcFBfKz5yUQqhqr0mVy",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      }
    },
    {
      "id": "GRANDPA_JOE",
      "entity_type": "NPC",
      "name": "Grandpa Joe",
      "description": "Jack's mischievous grandfather sitting stiffly in his living room armchair with a heating pad behind his lower back, glaring at the dark TV screen.",
      "appearance": "elderly man, white mustache, plaid cardigan, suspenders, mischievous wink, sitting in armchair",
      "current_scene_id": "LIVING_ROOM",
      "spatial_position": "sitting stiffly in the plush armchair",
      "image_url": "assets/59357c95_grandpa-joe.webp",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Get his TV remote working and help Jack pull off the ultimate blackmail trap against Grandma Evelyn.",
      "character": "Cunning, grumpy, playful, and fiercely devoted to saving the family home from his greedy ex-wife.",
      "hp": 60,
      "max_hp": 60,
      "mana": 0,
      "max_mana": 0,
      "stamina": 55,
      "max_stamina": 55,
      "voice": "pqHfZKP75CvOlQylNhV4",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [
        "MANCAVE_KEY"
      ],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_text": "Grandpa Joe rubs his back: 'Ouch! Bring me my working TV remote, Jack, and remember\u2014Grandma Evelyn always plays dirty!'",
      "on_receive_item_script": "if 'WORKING_REMOTE' in received_item_ids:\n    tw.npcs.give_to_player('GRANDPA_JOE', 'MANCAVE_KEY')\n    tw.npcs.say('GRANDPA_JOE', 'Finally the TV works! Here, take the spare key to your Dad\\'s secret Mancave. Oh, and Jack... if my cursed back hadn\\'t given out in the kitchen earlier, I would have ruined your Grandma\\'s scheming tonight! Just don\\'t look under my bed!')\nelif 'BLACKMAIL_DOSSIER' in received_item_ids:\n    tw.vars.set('grandma_trapped', True)\n    tw.npcs.say('GRANDPA_JOE', 'Bwahaha! Paragraph 7 of our Marriage Contract paperclipped right onto the glossy photos of Grandma and Poolboy Raul! I will lay this right on the kitchen table for her 18:00 inspection. She is toast, my boy!')\n    check_victory()\nelif 'POOLBOY_PHOTOS' in received_item_ids or 'PRENUP_CONTRACT' in received_item_ids:\n    for item_id in received_item_ids:\n        tw.npcs.give_to_player('GRANDPA_JOE', item_id)\n    tw.npcs.say('GRANDPA_JOE', 'Close, my boy! But we need the complete trap: combine the Poolboy Photos with the Marriage Contract from your Mom\\'s office into one watertight Blackmail Dossier!')\nelif 'SPORTS_MAGAZINES' in received_item_ids:\n    tw.npcs.give_to_player('GRANDPA_JOE', 'SPORTS_MAGAZINES')\n    tw.npcs.say('GRANDPA_JOE', 'Haha, the October \\'98 Beach Aerobics issue! Tell your father the blonde on page 4 has definitely never held a volleyball in her life. Keep them away before my pacemaker acts up!')\nelse:\n    for item_id in received_item_ids:\n        tw.npcs.give_to_player('GRANDPA_JOE', item_id)\n    tw.npcs.say('GRANDPA_JOE', 'What am I supposed to do with that? Bring me my TV remote WITH working batteries!')"
    },
    {
      "id": "KEVIN",
      "entity_type": "NPC",
      "name": "Kevin",
      "description": "The neighborhood freeloader in a backwards baseball cap and cargo shorts, constantly sniffing around the kitchen ##OVEN and asking annoying questions.",
      "appearance": "chubby teenage neighbor boy, backwards red cap, freckles, braces, cargo shorts, grinning",
      "current_scene_id": "KITCHEN",
      "spatial_position": "hovering noses-first right in front of the kitchen ##OVEN",
      "image_url": "assets/40a71b25_kevin.jpg",
      "is_hidden": true,
      "reveal_rule": "script",
      "npc_type": "HUMANOID",
      "movement_type": "MOVABLE",
      "moveable": true,
      "allowed_scenes": [],
      "goal": "Raid the Miller kitchen for snacks or find something way more exciting to take home.",
      "character": "Nosy, hyperactive, oblivious to hints, and utterly fascinated by adult 'sports magazines'.",
      "hp": 70,
      "max_hp": 70,
      "mana": 0,
      "max_mana": 0,
      "stamina": 90,
      "max_stamina": 90,
      "voice": "loY1uopAz31XyhAEhNSa",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_text": "Kevin picks his nose: 'Whatcha cooking, Jack? Unless you give me something super cool to read at home, I'm staying right here by the oven all evening!'",
      "on_receive_item_script": "if 'SPORTS_MAGAZINES' in received_item_ids:\n    tw.vars.set('kevin_gone', True)\n    tw.vars.set('kevin_active', False)\n    tw.npcs.say('KEVIN', 'WHOA! Dude! Are those your Dad\\'s legendary \"Sports Magazines\" in the uncensored glossy edition?! Uh... I gotta go home right now! I need to... study for gym class tomorrow! See ya next week, Jack!')\n    tw.npcs.hide('KEVIN')\n    check_victory()\nelse:\n    for item_id in received_item_ids:\n        tw.npcs.give_to_player('KEVIN', item_id)\n    tw.npcs.say('KEVIN', 'Booooring! Don\\'t you have anything cooler or something to eat?')"
    },
    {
      "id": "MOM",
      "entity_type": "NPC",
      "name": "Mom",
      "description": "A stressed businesswoman wearing a tailored blazer and a Bluetooth headset, dabbing her eyes with tissues after discovering the shattered Ming dish.",
      "appearance": "middle-aged woman, blonde bob hair, business blazer, bluetooth earpiece, holding tissues, stressed",
      "current_scene_id": "MOMS_OFFICE",
      "spatial_position": "pacing anxiously near the desk",
      "image_url": "assets/b282f32b_mom.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "MOVABLE",
      "moveable": true,
      "allowed_scenes": [
        "MOMS_OFFICE",
        "HALLWAY"
      ],
      "goal": "Survive Grandma's 18:00 inspection without having a complete nervous breakdown.",
      "character": "High-strung, perfectionist, overwhelmed, and fiercely protective of her teenager Tina.",
      "hp": 75,
      "max_hp": 75,
      "mana": 0,
      "max_mana": 0,
      "stamina": 70,
      "max_stamina": 70,
      "voice": "Xb7hH8MSUJpSbSDYk0k2",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_text": "Mom fans herself with a tissue: 'First Grandma's Ming dish snaps in half, and now Tina's eyebrows nearly burned off!'",
      "on_receive_item_script": "for item_id in received_item_ids:\n    tw.npcs.give_to_player('MOM', item_id)\nif 'SPORTS_MAGAZINES' in received_item_ids:\n    tw.npcs.say('MOM', 'Not now, Jack! Put your father\\'s weird gymnastics brochures away before Grandma gets here!')\nelif 'BROKEN_DISH' in received_item_ids:\n    tw.npcs.say('MOM', 'Oh God, hide it! I barely touched Grandma\\'s sacred Ming casserole dish and it snapped right in half! Unless you find industrial super glue and bake the casserole inside it, we are doomed!')\nelse:\n    tw.npcs.say('MOM', 'Sweetheart, please, Mommy is having a nervous breakdown right now!')"
    },
    {
      "id": "TINA",
      "entity_type": "NPC",
      "name": "Tina",
      "description": "Jack's fifteen-year-old sister in a sparkly crop top and headphones, lounging dramatically on her bed and rolling her eyes at everyone.",
      "appearance": "teenage girl, long ponytail, pink sparkly top, ripped jeans, dramatic expression, holding pillow",
      "current_scene_id": "TINAS_ROOM",
      "spatial_position": "lounging on her pink canopy bed",
      "image_url": "assets/c0a7a3ff_tina.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "goal": "Get her hands on a Pink Glitter Energy Drink and milk an emergency for spa money.",
      "character": "Sassy, dramatic, theatrical, and an absolute genius at faking teenage crises for cash.",
      "hp": 65,
      "max_hp": 65,
      "mana": 0,
      "max_mana": 0,
      "stamina": 80,
      "max_stamina": 80,
      "voice": "4tRn1lSkEn13EVTuqb0g",
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_interact_script": "if not tw.vars.get('tina_bribed', False):\n    tw.dialog.choose(\n        'Tina glares at you annoyed: \"What are you doing in my room, squirt?!\"',\n        [\n            'Help me clean up, Grandma is coming!',\n            'Mom said you have to come downstairs right now!',\n            {'label': 'Here is your Pink Glitter Drink if you scream and lure Mom out of her office!', 'visible_if': \"tw.player.has_item('FIZZY_DRINK')\"}\n        ],\n        on_choice='on_tina_dialog',\n        speaker='Tina'\n    )\nelse:\n    tw.npcs.say('TINA', 'Leave me alone, I am busy convincing Mom that I need emergency spa money!')",
      "on_receive_item_script": "if 'FIZZY_DRINK' in received_item_ids and not tw.vars.get('tina_bribed', False):\n    # A can alone says nothing about the deal: Tina asks what Jack wants for it.\n    tw.dialog.choose(\n        'Tina snatches the can and hugs it to her chest: \"Pink Glitter Zero?! Okay, squirt. What do you want for it?\"',\n        [\n            'Scream so loud that Mom comes out of her office!',\n            'Uh... nothing. It is a gift.',\n        ],\n        on_choice='on_tina_drink_deal',\n        speaker='Tina'\n    )\nelse:\n    for item_id in received_item_ids:\n        tw.npcs.give_to_player('TINA', item_id)\n    if 'SPORTS_MAGAZINES' in received_item_ids:\n        tw.npcs.say('TINA', \"Ewww, gross! Get Dad's creepy 'Sports Magazines' away from me, you little weirdo!\")\n    else:\n        tw.npcs.say('TINA', 'Talk to me properly if you want to make a deal, dork!')"
    }
  ],
