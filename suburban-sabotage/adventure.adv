      "on_interact_script": "if not tw.vars.get('piranhas_fed', False):\n    tw.player.damage(8)\n    tw.story.narrate('You dip your fingers toward the water and SNAP! A ravenous piranha bites you (-8 HP). You need to put something meaty inside (Put In) to distract them!')",
      "on_items_added_script": "if 'MEATY_BONE' in added_item_ids and not tw.vars.get('piranhas_fed', False):\n    tw.vars.set('piranhas_fed', True)\n    tw.objects.destroy('MEATY_BONE')\n    # The wrench lies take-locked in the tank until the piranhas are busy.\n    tw.objects.unlock('GOLDEN_WRENCH')\n    tw.story.narrate(\"The piranhas go into a feeding frenzy over the meaty bone! For the moment nobody is guarding Dad's golden wrench at the bottom of the tank. Now is your chance to grab it!\")\nelse:\n    for item_id in added_item_ids:\n        tw.objects.take_from_container('PIRANHA_TANK', item_id, to='player')\n    tw.story.narrate('The piranhas ignore that completely. They want real meat on a bone!')"
