  "scenes": [
    {
      "id": "KITCHEN",
      "label": "Kitchen",
      "description": "The chaotic heart of the Miller residence smells of damp dishwater and looming panic. Pots and pans teeter on the countertops, while a steady trickle of murky water leaks from the U-bend of the kitchen sink onto a soaked bathmat. A large family refrigerator hums loudly in the corner beside a ##MICROWAVE and a built-in kitchen ##OVEN, and a broad dining table sits in the center of the linoleum floor.",
      "image_url": "assets/6ed1b865_scene.jpg",
      "audio_track_id": "SUBURBAN_CLOCKWORK",
      "decorative_objects": [
        "leaking sink U-bend",
        "soaked bathmat",
        "kitchen dining table",
        "piles of dirty plates"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "BACKYARD",
      "label": "Backyard",
      "description": "Afternoon sunlight filters into the fenced suburban backyard. Freshly cut grass leads up to a large wooden doghouse painted red near a gap in the thick privet hedge. Acharred barbecue grill sits in the corner as a silent monument to Dad's summer cooking.",
      "image_url": "assets/8d390422_scene.webp",
      "audio_track_id": "SUBURBAN_CLOCKWORK",
      "decorative_objects": [
        "red wooden doghouse",
        "thick privet hedge",
        "charred barbecue grill",
        "garden hose",
        "plastic lawn chair"
      ],
      "on_enter_scene_script": "if not tw.vars.get('buster_gone', False) and not tw.vars.get('backyard_cat_hint_shown', False):\n    tw.vars.set('backyard_cat_hint_shown', True)\n    tw.story.narrate(\"You step into the backyard. Buster sits stubbornly in front of his doghouse, gnawing on his prize bone and watching you with low, protective growls. Getting near him right now would be reckless... If only there were a way to lure Mr. Whiskers out into the yard to draw Buster's attention away!\")\n",
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "GRANDPAS_ROOM",
      "label": "Grandpa's Room",
      "description": "This ground-floor guest room smells strongly of peppermint lozenges, old cigars, and rebellion. A brass-framed bed with a checkered quilt stands against the wall, with just enough clearance underneath to spot a heavy iron-bound chest pushed deep into the shadows. A small wooden nightstand holds Grandpa's reading glasses and mail.",
      "image_url": "assets/2bddf7b3_scene.jpg",
      "audio_track_id": "SLY_SLUGGISH_GROOVE",
      "decorative_objects": [
        "brass-framed bed",
        "checkered quilt",
        "wooden nightstand",
        "pair of slippers",
        "vintage radio"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "HALLWAY",
      "label": "Downstairs Hallway",
      "description": "A narrow hallway behind the kitchen, lined with crooked family photos, an overflowing shoe rack and a row of coat hooks buried under jackets. At its far end, the door to Mom's office is shut tight; a strip of lamplight and the occasional sob leak out from underneath.",
      "image_url": "assets/d5f8b8eb_scene.webp",
      "audio_track_id": "SUBURBAN_CLOCKWORK",
      "decorative_objects": [
        "crooked family photos",
        "overflowing shoe rack",
        "coat hooks buried under jackets",
        "faded runner rug"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "LIVING_ROOM",
      "label": "Living Room",
      "description": "The family living room is a tangle of throw blankets, scattered coasters, and suburban comfort. A plush, deep-cushioned ##COUCH faces a massive dark television screen. On the wallpapered wall hangs a framed certificate from the local fire brigade, while a tall mahogany bookshelf stands suspiciously crooked against the far wall.",
      "image_url": "assets/433a493b_scene.jpg",
      "audio_track_id": "SUBURBAN_CLOCKWORK",
      "decorative_objects": [
        "dark widescreen television",
        "crooked mahogany bookshelf",
        "plush armchair",
        "shag carpet",
        "coffee table with coasters"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A cold draft slips through the crooked mahogany bookshelf \u2014 there is a hidden steel door behind it.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "MOMS_OFFICE",
      "label": "Mom's Office",
      "description": "Normally the most organized room in the house, Mom's home office now shows signs of a major meltdown. Crumpled tissues litter the carpet around a heavy oak desk equipped with a numeric keypad drawer. Shelves of color-coded legal binders line the walls.",
      "image_url": "assets/0420a702_scene.jpg",
      "audio_track_id": "TYPEWRITER_PULSE",
      "decorative_objects": [
        "shelves of legal binders",
        "crumpled tissues",
        "swivel leather chair",
        "potted fern",
        "desk lamp"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "SECRET_MANCAVE",
      "label": "Secret Mancave",
      "description": "Hidden behind the living room bookshelf lies Dad's top-secret subterranean sanctuary. Neon beer signs cast a warm glow over a green felt poker table, a heavy steel locker plastered with warning labels, and a large bubbling aquarium filled with very hungry Amazonian piranhas.",
      "image_url": "assets/0ef3deae_scene.jpg",
      "audio_track_id": "MURKY_SUSPENSE",
      "decorative_objects": [
        "neon signs",
        "green felt poker table",
        "mini bar",
        "dartboard",
        "velvet recliner"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    },
    {
      "id": "TINAS_ROOM",
      "label": "Tina's Room",
      "description": "Jack's teenage sister has turned her upstairs bedroom into a neon shrine to pop culture and teenage angst. Glossy boyband posters cover every inch of pink wallpaper, a glitter lava lamp bubbles on the nightstand, and a canopy bed piled high with decorative pillows dominates the room.",
      "image_url": "assets/992bcbe0_scene.jpg",
      "audio_track_id": "LAZY_EYE_LOOP",
      "decorative_objects": [
        "boyband wall posters",
        "pink canopy bed",
        "glitter lava lamp",
        "vanity mirror with lights",
        "fluffy pink rug"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null,
      "helpers_script": null
    }
  ],
