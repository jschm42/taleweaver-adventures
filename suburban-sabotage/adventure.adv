  "quests": [
    {
      "id": "SQ_PEACE_AND_QUIET",
      "title": "Peace and Quiet",
      "description": "Neighbor Kevin is stalking Jack around the house, wasting precious minutes and hovering right in front of the kitchen ##OVEN. Find something in Dad's secret stash that will send a teenage boy sprinting straight home.",
      "goal": "Permanently get rid of annoying neighbor Kevin using Dad's \"Sports Magazines\".",
      "impact": "Kevin leaves the Miller house immediately, freeing up the Kitchen ##OVEN and stopping his 3-minute time penalties.",
      "exp_reward": 50,
      "status": "open",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.vars.get('kevin_gone', False)"
    },
    {
      "id": "SQ_MING_RESTORATION",
      "title": "Ancient Chinese Secret",
      "description": "Mom is having a nervous breakdown over Grandma's shattered Ming porcelain casserole dish. Find industrial-grade adhesive and restore the heirloom before dinner.",
      "goal": "",
      "impact": "The Ming dish is seamlessly repaired and ready to hold the family casserole.",
      "exp_reward": 75,
      "status": "open",
      "required_item_id": "MING_DISH",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": ""
    },
    {
      "id": "SQ_GRANDPAS_CONSPIRACY",
