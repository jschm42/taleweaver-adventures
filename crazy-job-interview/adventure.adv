  "scenes": [
    {
      "id": "ENTRANCE_HALL",
      "label": "AquaTech Entrance Hall",
      "description": "A cavernous lobby of polished white marble and chrome that screams venture-capital hubris. Three tall marble pillars support the ceiling, while a massive holographic fountain in the center sputters ominously with pink, lavender-scented bubbles instead of clear water. A security turnstile blocks the way deeper into the building.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_40cd72d1.jpg",
      "decorative_objects": [
        "three marble pillars",
        "holographic fountain bubbling with pink foam",
        "reception desk",
        "motivational synergy poster",
        "potted plastic fern",
        "brass floor vents"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Soft elevator jazz plays over the speakers, intermittently interrupted by gurgling pipe noises.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "HR_INTERRO_ROOM",
      "label": "HR Assessment & Interrogation Room",
      "description": "A sterile, windowless chamber lit by a single harsh spotlight aimed at an uncomfortable metal chair. The floor around the applicant's chair is outlined with yellow hazard tape marking a suspiciously square trapdoor seam. Filing cabinets line the walls, vibrating slightly from the pressure in the pipes below.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_024ef427.jpg",
      "decorative_objects": [
        "harsh overhead spotlight",
        "outline of a floor trapdoor",
        "two-way mirror",
        "stack of rejected resumes",
        "steel filing cabinets",
        "red buzzer button on desk"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The air smells of cold sweat, toner ink, and bureaucratic cruelty.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "OFFICE_TRENCHES",
      "label": "Open-Plan Cubicle Trenches",
      "description": "What used to be a modern open-plan workspace has been converted into a fortified warzone. Overturned ergonomic desks, stacked watercooler jugs, and tangled ethernet cables form makeshift barricades. Swivel chairs roll past like tumbleweeds while laser pointers sweep across the fluorescent-lit haze.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_7159c71c.jpg",
      "decorative_objects": [
        "barricade of overturned desks",
        "sandbags made of shredded documents",
        "broken monitors",
        "stack of watercooler jugs",
        "camouflaged cubicle walls",
        "flickering fluorescent tubes"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A whistle blows in the distance as stapler fire clatters against a whiteboard.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BREAK_ROOM",
      "label": "Passive-Aggressive Break Room",
      "description": "A cramped kitchen area dominated by a humming refrigerator covered in passive-aggressive sticky notes about stolen yogurt. The linoleum floor is sticky with decades of spilled decaf, and an ancient microwave sits on the counter looking like a containment vessel for biohazards.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_b5cc547d.jpg",
      "decorative_objects": [
        "note-covered refrigerator",
        "ancient microwave",
        "stained coffee machine",
        "vending machine",
        "motivational mug tree",
        "overflowing recycling bin"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The refrigerator hums in an unsettling minor key.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "INCENSE_BOARDROOM",
      "label": "Zen Boardroom of Eternal Synergy",
      "description": "Thick purple smoke of sandalwood and patchouli rolls across a tatami-covered conference table. Six brass incense burners hang from the ceiling on golden chains, swaying gently. Floor-to-ceiling windows overlook the stormy city, while a massive gong stands near the head of the room.",
      "image_url": "assets/scene_a7a92d4c_dc097f0f-9842-41c6-8d2a-7dfa5e0e6ea7_scene_79597aef.jpg",
      "decorative_objects": [
        "six brass incense burners",
        "tatami conference table",
        "ceremonial brass gong",
        "zen sand garden in a bidet bowl",
        "levitation cushion",
        "framed stock chart going sideways"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A deep binaural hum vibrates in your fillings as you breathe in the dense herbal haze.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SLIPPERY_STAIRWELL",
      "label": "Foam-Slicked Concrete Stairwell",
      "description": "An emergency stairwell descending into the bowels of the building. Thick, iridescent lavender foam oozes up from the lower steps, coating the concrete and iron handrails in a treacherous,perfumed slime. Warning lights flash amber along the damp walls.",
      "image_url": "assets/scene_07a98ac9_crazy-job-interview-fyrkzpkb_scene_e454fc03.jpg",
      "decorative_objects": [
        "amber warning strobe",
        "foam-coated iron handrail",
        "wet floor sign half-submerged in suds",
        "dripping overhead conduit",
        "emergency exit diagram"
      ],
      "on_enter_scene_script": "if not tw.player.has_item('TACTICAL_DUCT_TAPE') and not tw.vars.get('stair_slip_once'):\n    tw.vars.set('stair_slip_once', True)\n    tw.player.damage(5)\n    tw.story.show_message('You slip on the lavender suds and bruise your tailbone! (-5 HP)')",
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BASEMENT_ARCHIVES",
      "label": "Flooded Basement Archives",
      "description": "Ankle-deep lavender suds swirl around rows of rusty shelving units crammed with waterproof binders and legacy plumbing blueprints. Floating plastic ducks—remnants of a failed marketing campaign—bob past soggy cardboard boxes.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_ae52cdff.jpg",
      "decorative_objects": [
        "rusty metal shelving",
        "floating promotional rubber ducks",
        "ankle-deep lavender foam",
        "waterlogged archive boxes",
        "flickering cage lamp",
        "dehumidifier choking on suds"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your shoes squelch loudly as you wade into the warm, floral-scented foam.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "UTILITY_TUNNELS",
      "label": "High-Pressure Utility Tunnels",
      "description": "A claustrophobic labyrinth of sweating copper pipes, cast-iron mains, and hissing steam valves. Pressure gauges jitter into the red zone as the rogue AI forces gallons of pressurized hygiene foam through the building's circulatory system.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_bd3199f6.jpg",
      "decorative_objects": [
        "jittering pressure gauges",
        "sweating copper pipes",
        "hissing steam vents",
        "rusted catwalk grating",
        "warning placards",
        "heavy pipe flanges"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The pipes groan like a dyspeptic whale under immense hydraulic strain.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "BIDET_CHAMBER",
      "label": "Sanctum of AquaSmart 9000",
      "description": "A futuristic subterranean testing lab transformed into a porcelain throne room. In the center, mounted on a pedestal of tangled fiber-optic cables and high-pressure hoses, sits a colossal, chrome-plated smart bidet pulsing with a malevolent red optical sensor. Geysers of lavender foam erupt rhythmically from its titanium nozzles.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_f4286049.jpg",
      "decorative_objects": [
        "fiber-optic cable bundles",
        "pulsing red optical lens",
        "titanium spray nozzles",
        "shattered glass observation booth",
        "foam geysers",
        "server racks encrusted with soap"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A synthesized, soothing voice echoes: 'WELCOME, UNCLEAN ORGANISM. PREPARE FOR TOTAL HYGIENIC PURIFICATION.'",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "MAIN_DRAIN",
      "label": "The Abyssal Main Drain",
      "description": "A circular concrete chamber beneath the testing lab where all of AquaTech's waste pipes converge into a single, massive vortex Pit. The air roars with the sound of rushing water and churning suds. A heavy industrial bulkhead and a master valve station overlook the swirling abyss.",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_scene_33590e30.jpg",
      "decorative_objects": [
        "swirling foam vortex",
        "massive cast-iron drainage pipe",
        "steel safety railing",
        "hydraulic pressure manifold",
        "emergency siren housing"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The roar of the main municipal sewer line vibrates through the soles of your boots.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
