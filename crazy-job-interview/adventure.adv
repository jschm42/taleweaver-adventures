  "sequences": [
    {
      "id": "SEQ_1_LOBBY_CHECKIN",
      "order": 1,
      "title": "Chapter 1: First Impressions & Lavender Suds",
      "description": "Arthur arrives in the Entrance Hall of AquaTech Synergies and must check in with Receptionist Brenda to get past the security turnstile.",
      "walkthrough": "1. Talk to Receptionist Brenda or inspect the reception desk in ENTRANCE_HALL.\n2. Pick up the ##GUEST_BADGE from the reception desk.\n3. Unlock the exit to HR_INTERRO_ROOM using the ##GUEST_BADGE and enter HR_INTERRO_ROOM.",
      "end_condition": "",
      "required_item_id": "GUEST_BADGE",
      "required_scene_id": "HR_INTERRO_ROOM",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 50,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Chapter 1: Check in at reception and survive your entry into Human Resources.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You step past the turnstile into the lair of Human Resources."
