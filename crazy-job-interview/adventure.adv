  "protagonist": {
    "name": "Arthur Plumb",
    "role": "Master Sanitary Engineer & Job Applicant",
    "description": "An unassuming but endlessly resourceful plumber dressed in an ill-fitting interview suit over his trusty denim overalls. What he lacks in corporate buzzwords, he makes up for with a deep understanding of fluid dynamics and sheer stubbornness.",
    "goal": "Survive the psychotic assessment center at AquaTech Synergies, flush down the rogue bidet AI AquaSmart 9000, and maybe still get the job.",
    "character": "Pragmatic, deadpan, polite under extreme duress, and deeply suspicious of smart appliances.",
    "appearance": "middle-aged man, mustache, cheap suit jacket over blue overalls, red tie, utility belt",
    "profile_image": "assets/9bd089d0-9d55-4a7b-ab11-15d99066522d_protagonist_165a6dd4.jpg",
