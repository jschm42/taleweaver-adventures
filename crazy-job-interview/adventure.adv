  "scripts": [
    {
      "id": "SCRIPT_INIT_CORPORATE_STATE",
      "name": "Initialize AquaTech Pressure Systems",
      "trigger": "on_init",
      "target_id": null,
      "target": null,
      "code": "tw.vars.set('foam_pressure', 1)\ntw.vars.set('aquasmart_flushed', False)",
      "description": "Initializes persistent foam pressure and story flags at session start."
    },
    {
      "id": "SCRIPT_DONUT_BRIoche_MILLER",
      "name": "Major Miller Pastry Recognition",
      "trigger": "on_interact",
      "target_id": "MAJOR_MILLER",
      "target": "MAJOR_MILLER",
      "code": "if tw.player.has_item('PETRIFIED_DONUT') and not tw.vars.get('miller_fed', False):\n    tw.vars.set('miller_fed', True)\n    tw.story.show_message('Major Miller salutes the Petrified Donut with tears in his eyes: \"42 days on the front line! That is the second half of my safe code, soldier: 4-2!\"')",
      "description": "When interacting with Major Miller while holding the Petrified Donut, he enthusiastically confirms the second half of his safe code (42)."
    },
    {
      "id": "SCRIPT_FOAM_PRESSURE_TRACKER",
      "name": "Basement Foam Surge Atmospheric Tracker",
      "trigger": "on_enter_scene",
      "target_id": "BIDET_CHAMBER",
      "target": "BIDET_CHAMBER",
      "code": "if not tw.vars.get('entered_bidet_chamber', False):\n    tw.vars.set('entered_bidet_chamber', True)\n    tw.story.show_message('WARNING: Lavender foam pressure at 98%! Reach the Main Drain and open the Main Valve Wheel before the building bursts!')",
      "description": "Fires a dramatic warning message the first time Arthur enters the Bidet Chamber."
    }
  ]
