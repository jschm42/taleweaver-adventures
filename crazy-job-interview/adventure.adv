    {
      "id": "CHRISTINA_BUTTERSWORTH",
      "entity_type": "NPC",
      "name": "Christina Buttersworth",
      "description": "The Vice President of Human Resources, clad in a razor-sharp pinstripe power suit. She holds a stopwatch in one hand and hovers her other hand over a red trapdoor release lever. She views empathy as a terminable offense.",
      "appearance": "stern woman, sharp glasses, dark pinstripe suit, holding stopwatch, sinister smirk",
      "current_scene_id": "HR_INTERRO_ROOM",
      "spatial_position": "looming behind the elevated interrogation desk",
      "image_url": "assets/crazy-job-interview-argon-7fviat1z_christina-buttersworth_400bf527.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows that the HR Lockbox code is calculated by multiplying the marble pillars in the Entrance Hall (3) by the brass incense burners in the Boardroom (6), then appending the number of letters in 'SYNERGY' (7) -> 187. She will drop a hint about pillars and synergy if flattered with corporate buzzwords.",
      "goal": "Weed out weak applicants and protect the HR Lockbox containing her employment contracts.",
      "character": "Cold, sadistic, speaks exclusively in toxic corporate jargon and performance metrics.",
      "hp": 75,
      "max_hp": 75,
      "mana": 0,
      "max_mana": 0,
      "stamina": 70,
      "max_stamina": 70,
      "is_attackable": false,
      "is_killable": false,
      "inventory": [],
      "metadata_json": {
        "special_actions": [],
        "attack_mode": "PASSIVE"
      },
      "on_protagonist_enters_scene_text": "Christina snaps: 'You're two seconds early, Plumb. Punctuality is a sign of desperation. Impress me or take the drop!'"
    },
