  "adventure": {
    "origin_id": "49508727-de94-4619-9c47-bf7810211a19",
    "title": "The Observer's Labyrinth",
    "teaser": "Wake nameless in a lethal research labyrinth. Outwit a rogue AI before its final purge begins.",
    "cover_appearance": "dark sci-fi laboratory corridor, glowing red AI camera eye, steel vault door, teal and crimson",
    "version": "3.0.0",
    "creator": "Jean Schmitz",
