    {
      "id": "NOTE_FINAL",
      "entity_type": "OBJECT",
      "name": "Director Vance's Final Testament",
      "description": "A scorched voice-transcription scroll lying beside the biometric pedestal at the AI Core Threshold. Despite the charred edges, its complete final message remains legible when examined: \"Final statement of Director Vance. The Observer has turned against us. It released the Chimera Serum into the ventilation system; what remains of our staff now stalks these halls. We called this place a research facility. For those we confined here, it was a prison. If any subject survives to read this, you owe us nothing. Survive. Let the truth leave this place with you. End transcription.\"",
      "appearance": "scorched digital transcription scroll, glowing amber lettering",
      "current_scene_id": "AI_CORE_THRESHOLD",
      "spatial_position": "lying at the base of the biometric scanner pedestal",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_note-final_96e15d97.jpg",
