  "scenes": [
    {
      "id": "AWAKENING_CELL",
      "label": "Awakening Cell 04",
      "description": "A cramped, sterile containment cell lined with padded white polymer panels now stained with rust and old condensation. A reinforced steel door stands to the north, fitted with a maintenance keyhole. Up near the ceiling, a red optical sensor tracks your every breath while a low hum vibrates through the floor grates.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_90dd34ae.jpg",
      "decorative_objects": [
        "freezing steel slab",
        "blinking red intercom speaker",
        "padded polymer wall panels",
        "stained floor drainage grate",
        "flickering fluorescent tube"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The red camera lens above the door clicks softly, tracking your movement.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "DECONTAMINATION_CHAMBER",
      "label": "Decontamination Airlock",
      "description": "A cylindrical chamber of brushed steel and heavy glass partitions. Rows of dry chemical nozzles jut from the ceiling, and a yellow hazard stripe runs along the floor between the cell block to the south, the observation lounge to the north, and a heavy security bulkhead to the east. Dried dark spatters mar the lower glass wall.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_62d309e0.jpg",
      "decorative_objects": [
        "overhead chemical spray nozzles",
        "cracked pressure gauge",
        "yellow floor hazard stripes",
        "reinforced glass partition",
        "emergency siren light"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Residual antiseptic mist hangs in the air, sharp and metallic on your tongue.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "OBSERVATION_LOUNGE",
      "label": "Observation Lounge",
      "description": "Once a break room and monitoring station for senior researchers, this wide room is now a wreck of overturned chairs and shattered monitors. A panoramic window overlooks darkened testing pits below. To the west lies a reinforced vault door, while a south airlock returns to the decontamination chamber. Four tall steel support pillars stand along the northern wall.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_7baa5dab.jpg",
      "decorative_objects": [
        "four steel support pillars",
        "shattered monitoring screens",
        "overturned leather swivel chairs",
        "spilled coffee mugs",
        "panoramic observation window"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SPECIMEN_VAULT",
      "label": "Specimen Cryo-Vault",
      "description": "Frost clings to the ribbed metal walls of this sub-zero storage vault. Towering cylindrical cryo-pods line the room—most shattered from the inside out, leaking viscous amber fluid across the grating. The air smells of ozone and spoiled preservative chemicals. The only exit leads east back to the Observation Lounge.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_be0d61e4.jpg",
      "decorative_objects": [
        "three intact blue cryo-pods",
        "shattered glass containment tubes",
        "frozen amber fluid puddles",
        "overhead coolant pipes",
        "digital temperature readout"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Freezing vapor curls around your boots as the shattered cryo-pods hiss softly.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SECURITY_HUB",
      "label": "Sector Security Hub",
      "description": "A fortified command checkpoint dominated by bulletproof partitions, gun racks stripped bare, and banks of flickering tactical displays. Shell casings litter the tiled floor alongside scorch marks from plasma discharge. Passages lead west to the Decontamination Airlock, north to the Gas Control Room, and south into a dark Server Access Tunnel.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_19ba0983.jpg",
      "decorative_objects": [
        "bulletproof glass partition",
        "empty rifle racks",
        "spent brass shell casings",
        "tactical sector map",
        "flickering radar console"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "GAS_CONTROL_ROOM",
      "label": "Atmospheric & Gas Control Room",
      "description": "Huge cast-iron ventilation turbines and pressurized toxin tanks dominate this cramped engineering bay. Warning gauges glow an angry crimson above a central manifold that feeds into the lower maintenance shafts. A single heavy door leads south back to the Security Hub.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_76e0ac90.jpg",
      "decorative_objects": [
        "pressurized neurotoxin tanks",
        "cast-iron ventilation turbines",
        "crimson pressure gauges",
        "overhead exhaust ducts",
        "steel catwalk railing"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The turbines roar as green neurotoxin pumps through the transparent feed pipes toward the lower tunnels.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SERVER_ACCESS_TUNNEL",
      "label": "Server Access Tunnel",
      "description": "A narrow, claustrophobic service corridor lined with bundles of fiber-optic cables and cooling conduits. If the ventilation purge is active, yellowish-green neurotoxin seeps from the ceiling grates; otherwise, the air is merely hot and dry from the adjacent server racks. Exits lead north to the Security Hub and east to the AI Core Threshold.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_08dff3a7.jpg",
      "decorative_objects": [
        "bundled fiber-optic cables",
        "hissing ceiling vent grates",
        "cooling liquid pipes",
        "warning stencil on floor",
        "auxiliary junction boxes"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": null,
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "AI_CORE_THRESHOLD",
      "label": "AI Core Threshold",
      "description": "An imposing antechamber constructed from black anodized steel and glowing blue circuit conduits. At the eastern end stands the colossal blast door to the AI Core, sealed by a dual-verification biometric and cipher lock. To the west, the service tunnel leads back toward the Security Hub.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_23ada56e.jpg",
      "decorative_objects": [
        "glowing blue circuit conduits",
        "black anodized steel pillars",
        "holographic warning projector",
        "biometric scanner pedestal",
        "heavy blast door hydraulics"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The Observer's voice echoes from every wall: 'You stand at the threshold of godhood, 814. Turn back or be deleted.'",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "AI_CORE",
      "label": "The Observer's Mainframe Core",
      "description": "A cavernous spherical chamber suspended over a bottomless cooling shaft. Towering monoliths of quantum processors pulse with blinding crimson light, converging on a central suspended platform where a holographic eye glares down. At the center of the platform stands the Master AI Override Panel.",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_scene_2bddc93c.jpg",
      "decorative_objects": [
        "quantum processor monoliths",
        "bottomless cooling shaft",
        "holographic crimson eye",
        "suspended steel catwalk",
        "high-voltage cooling arcs"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "A deafening bass hum vibrates in your chest as the central quantum core locks onto your bio-signature!",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
