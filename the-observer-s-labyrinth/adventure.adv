  "quests": [
    {
      "id": "QUEST_RECLAIM_IDENTITY",
      "title": "Echoes of 814",
      "description": "Uncover why the Observer wiped your memory by locating your personnel file inside the Specimen Cryo-Vault.",
      "goal": "",
      "impact": "Reveals that Subject 814 was the lead neural architect who designed the Observer's failsafe backdoor.",
      "exp_reward": 100,
      "status": "open",
      "required_item_id": "NOTE_SPECIMEN",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.vars.get('learned_true_identity') == True"
    },
    {
      "id": "QUEST_RIOT_ARSENAL",
      "title": "High-Voltage Countermeasure",
      "description": "Piece together the split 4-digit combination from the Lounge Locker and Dr. Thorne to unlock the Armory Security Strongbox and retrieve the High-Voltage Stun Baton.",
      "goal": "",
      "impact": "Equips Subject 814 with the Stun Baton and unlocks the EMP Neural Discharge special attack.",
      "exp_reward": 120,
      "status": "open",
      "required_item_id": "STUN_BATON",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": ""
    },
    {
      "id": "QUEST_CLEAR_THE_AIR",
      "title": "Breathe Easy",
      "description": "Locate the Atmospheric & Gas Control Room and vent the neurotoxin from the Server Access Tunnel before it can choke you.",
