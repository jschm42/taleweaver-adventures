  "npcs": [
    {
      "id": "MUTANT_ALPHA",
      "entity_type": "NPC",
      "name": "Subject 409 (Feral Stalker)",
      "description": "A hunched, painfully elongated former test subject whose skin has turned translucent grey. Bone spurs jut from its forearms, and its jaw distends as it sniffs the antiseptic air.",
      "appearance": "hunched pale mutant, bone forearm spurs, tattered lab trousers, glowing yellow eyes",
      "current_scene_id": "OBSERVATION_LOUNGE",
      "spatial_position": "crouched atop an overturned leather swivel chair",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_mutant-alpha_a2522dce.jpg",
      "is_hidden": false,
      "npc_type": "MONSTER",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Former researcher or test subject mutated by the Chimera serum.",
      "goal": "Tear apart any unmutated organism that steps out of the containment cells.",
      "character": "Ravenous, twitchy, hyper-aggressive, driven purely by predatory instinct.",
      "hp": 45,
      "max_hp": 45,
      "mana": 0,
      "max_mana": 0,
      "stamina": 60,
      "max_stamina": 60,
      "is_attackable": true,
      "is_killable": true,
      "inventory": [],
      "metadata_json": {
        "special_actions": [
          {
            "id": "BONE_SPUR_LUNGE",
            "name": "Bone Spur Lunge",
            "description": "The mutant leaps forward, raking with serrated forearm bone spurs.",
            "action_type": "ATTACK",
            "category": "MELEE",
            "cost_type": "stamina",
            "cost": 15,
            "success_stat": "dexterity",
            "effects": [
              {
                "target": "target",
                "stat": "hp",
                "amount": "-1d8+2"
              }
            ],
            "mana_cost": 0,
            "damage_type": "ROLLED",
            "damage_value": "1d8+2",
            "outcome_description": "The serrated bone spurs slice through your suit!",
            "is_locked": false,
            "on_success_script": "",
            "on_success_text": "Subject 409's bone spurs gouge deep into your shoulder!",
            "on_failure_script": "",
            "on_failure_text": "You duck beneath the mutant's wild lunge."
          }
        ],
        "attack_mode": "ATTACK_ON_SIGHT",
        "special_chance": 40
      },
      "on_defeat_script": "tw.vars.set('mutant_alpha_slain', True)",
      "on_defeat_text": "Subject 409 collapses in a heap, coughing out a final whispered word: '...thank... you...'",
      "on_protagonist_enters_scene_text": "Subject 409's head snaps toward you with a wet, rattling hiss!"
    },
    {
      "id": "MUTANT_BETA",
      "entity_type": "NPC",
      "name": "Cryo-Hulk 612",
      "description": "A hulking mass of frostbitten muscle and ruptured cryo-tubes fused directly into its spine. Freezing liquid nitrogen drips from its maw as it guards the shattered specimen pods.",
      "appearance": "massive frostbitten mutant, cryo-tubes fused to back, ice crystals on skin, glowing blue veins",
      "current_scene_id": "SPECIMEN_VAULT",
      "spatial_position": "lurking amidst the shattered glass containment tubes",
      "image_url": "assets/the-observers-labyrinth-a-izrtswxr_mutant-beta_f922b724.jpg",
      "is_hidden": false,
      "npc_type": "MONSTER",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Guards the Specimen Vault.",
      "goal": "Protect its frozen nest in the Specimen Vault from intruders.",
      "character": "Brutish, relentless, numb to pain, territorial.",
      "hp": 65,
      "max_hp": 65,
      "mana": 20,
      "max_mana": 20,
      "stamina": 75,
      "max_stamina": 75,
      "is_attackable": true,
      "is_killable": true,
      "inventory": [
        {
          "id": "NOTE_SPECIMEN",
          "name": "Cryo-Vault Research Log",
          "description": "A frost-encrusted datapad recovered from the Specimen Vault.",
          "image_url": "/data/adventures/library/687ca935-6111-47d8-a3b9-bf1acaa1481e/visuals/reused/object/object_5ed7ad5a_note-specimen_5b375b00-1528-47b8-b7ea-7843b4d3e9e9_note-specimen_a17ac5a4.jpg",
          "item_type": "READABLE",
          "text_log_content": "SPECIMEN ARCHIVE LOG - SUBJECT 814:\nSubject 814 is not a random prisoner. 814 is Dr. Elena Vance's lead neural architect—the one who built the failsafe backdoor into the Observer.\n\nI locked the Server Access Card inside the Wall Safe here in the Specimen Vault. The safe's 3-digit combination is the exact Subject number of our protagonist (three digits, starting with 8).",
          "text_log_format": "DOCUMENT",
          "stat_modifier_strength": 0,
          "stat_modifier_dexterity": 0,
          "stat_modifier_intelligence": 0,
          "stat_modifier_wisdom": 0,
          "stat_modifier_charisma": 0,
          "stat_modifier_armor_class": 0,
          "hp_change": 0,
          "stamina_change": 0,
          "mana_change": 0
        }
      ],
      "metadata_json": {
        "special_actions": [
          {
            "id": "CRYO_BILE_SPRAY",
            "name": "Cryo-Bile Spray",
            "description": "The mutant vomits a pressurized stream of sub-zero preservative fluid that freezes flesh and slows movement.",
            "action_type": "ATTACK",
            "category": "RANGED",
            "cost_type": "stamina",
            "cost": 20,
            "success_stat": "strength",
            "effects": [
              {
                "target": "target",
                "stat": "hp",
                "amount": "-2d6+2"
              },
              {
                "target": "target",
                "stat": "dexterity",
                "amount": "-2"
              }
            ],
            "mana_cost": 0,
            "damage_type": "ROLLED",
            "damage_value": "2d6+2",
            "outcome_description": "Sub-zero fluid splatters across your torso, flash-freezing your joints!",
            "is_locked": false,
            "on_success_script": "",
            "on_success_text": "Freezing cryo-bile crusts your suit in jagged ice!",
            "on_failure_script": "",
            "on_failure_text": "The stream of freezing bile splatters harmlessly against a cryo-pod."
          }
        ],
        "attack_mode": "ATTACK_ON_SIGHT",
        "special_chance": 45
      },
      "on_defeat_script": "tw.story.show_message('As Cryo-Hulk 612 crashes to the grating, a bloodstained research log slips from its fused harness.')",
      "on_defeat_text": "The massive mutant crashes onto the grated floor, its internal cryo-tubes shattering.",
      "on_protagonist_enters_scene_text": "A guttural roar shakes the frost from the ceiling as Cryo-Hulk 612 charges from the mist!"
    },
    {
      "id": "MUTANT_GAMMA",
      "entity_type": "NPC",
      "name": "Dr. Aris Thorne (Half-Mutated)",
      "description": "Slumped behind a overturned desk in the Security Hub, Chief Virologist Aris Thorne clutches his mutating left arm. Dark veins pulse beneath his spectacles, though his eyes remain frantically human. He knows the first half of the Security Strongbox combination (68) and will share it if helped, calmed, or interrogated.",
      "appearance": "trembling older scientist, cracked spectacles, torn bloodstained lab coat, mutating dark veins on ar",
      "current_scene_id": "SECURITY_HUB",
      "spatial_position": "slumped behind the bulletproof glass partition",
      "image_url": "assets/npc_1e07adf3_mutant-gamma_847cd970-da46-4e4c-b6ce-b932360344e3_muta_1e167129.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Friendly/neutral survivor. Knows the first two digits of SECURITY_STRONGBOX ('68') and warns that the second half ('24') is written on NOTE_LOCKER inside the Security Locker.",
      "goal": "Hold onto his sanity long enough to help someone destroy the Observer AI.",
      "character": "Paranoid, trembling, remorseful, desperate to atone for building the Observer's neural net.",
      "hp": 50,
      "max_hp": 50,
      "mana": 0,
      "max_mana": 0,
      "stamina": 50,
      "max_stamina": 50,
      "is_attackable": true,
      "is_killable": true,
      "inventory": [
        {
          "id": "NOTE_SCIENTIST",
          "name": "Dr. Thorne's Journal",
          "description": "A leather-bound notebook belonging to Chief Virologist Dr. Aris Thorne.",
          "image_url": "/data/adventures/library/687ca935-6111-47d8-a3b9-bf1acaa1481e/visuals/reused/object/object_e3b7da1b_note-scientist_note-scientist_note-scientist_847cd970-da46-4e4c-b6ce-b932360344e3_note-scientist_dec7cddc.jpg",
          "item_type": "READABLE",
          "text_log_content": "DR. ARIS THORNE - PERSONAL NOTES:\nMy arm is changing. Soon I won't remember my own name.\n\n1. Security Strongbox Prefix: 68 (Combine with the 2-digit suffix from the Observation Lounge locker note).\n2. WARNING: Do NOT enter the Server Access Tunnel while the gas turbines are running! Go north to the Gas Control Room first and switch the Gas Control Box to VENTED.\n3. Once inside the AI Core, set the Override Panel to ERADICATED using code word: ERADICATE.",
          "text_log_format": "BOOK",
          "stat_modifier_strength": 0,
          "stat_modifier_dexterity": 0,
          "stat_modifier_intelligence": 0,
          "stat_modifier_wisdom": 0,
          "stat_modifier_charisma": 0,
          "stat_modifier_armor_class": 0,
          "hp_change": 0,
          "stamina_change": 0,
          "mana_change": 0
        }
      ],
      "metadata_json": {
        "special_actions": [
          {
            "id": "DESPERATE_SCALPEL",
            "name": "Desperate Scalpel Slash",
            "description": "Thorne slashes wildly in panic with a surgical laser scalpel.",
            "action_type": "ATTACK",
            "category": "MELEE",
            "cost_type": "stamina",
            "cost": 15,
            "success_stat": "dexterity",
            "effects": [
              {
                "target": "target",
                "stat": "hp",
                "amount": "-1d6+1"
              }
            ],
            "mana_cost": 0,
            "damage_type": "ROLLED",
            "damage_value": "1d6+1",
            "outcome_description": "Thorne slices defensively with his scalpel.",
            "is_locked": false,
            "on_success_script": "",
            "on_success_text": "Thorne nicked your arm with his laser scalpel!",
            "on_failure_script": "",
            "on_failure_text": "Thorne stumbles back, missing his swing."
          }
        ],
        "attack_mode": "PASSIVE",
        "special_chance": 30
      },
      "on_defeat_text": "'Forgive me... the strongbox prefix is 68... finish it...'",
      "on_protagonist_enters_scene_text": "'Wait! Don't shoot!' a hoarse voice croaks from behind the partition. 'You're 814! Your mind is still intact! Talk to me—I know the strongbox prefix!'"
    },
