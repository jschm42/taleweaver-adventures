    {
      "id": "SERVER_TERMINAL",
      "entity_type": "OBJECT",
      "name": "Sub-Level Server Terminal",
      "description": "A glowing maintenance terminal humming amidst the fiber-optic racks. Its screen displays the first half of the AI Core Blast Door override sequence.",
