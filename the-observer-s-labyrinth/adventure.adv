  "sequences": [
    {
      "id": "SEQ_1_AWAKENING",
      "order": 1,
      "title": "Chapter 1: Cell Block Awakening",
      "description": "Subject 814 wakes up in Awakening Cell 04 mocked by the Observer AI. They must search the cell, arm themselves, find the hidden Maintenance Key, and reach the Observation Lounge to recover the Sector Security Keycard.",
      "walkthrough": "1. Read ##NOTE_CELL on the steel slab and pick up ##SCRAP_SHIV (equip it).\n2. Search the floor drainage grate to reveal and pick up ##MAINTENANCE_KEY.\n3. Unlock the northern cell door with ##MAINTENANCE_KEY and enter DECONTAMINATION_CHAMBER.\n4. Read ##WALL_SIGN and open ##MEDICAL_CABINET to take ##MEDKIT_1 and read ##MED_LOG_NOTE.\n5. Move north into OBSERVATION_LOUNGE and defeat MUTANT_ALPHA (Subject 409).\n6. Read ##DEAD_GUARD_NOTE to learn the riddle ('I have cities, but no houses...'). Unlock ##SECURITY_LOCKER using code 'MAP' and take ##SECURITY_KEYCARD, ##ARMOR_VEST, and ##NOTE_LOCKER.",
      "end_condition": "",
      "required_item_id": "SECURITY_KEYCARD",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "CHAPTER 1: Escape Containment Cell 04 and acquire security clearance.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the Sector Security Keycard in hand, the deeper facility awaits."
    },
    {
      "id": "SEQ_2_SPECIMEN_SECRETS",
      "order": 2,
      "title": "Chapter 2: Secrets of the Cryo-Vault",
      "description": "Before venturing into the server tunnels, 814 must deduce the 4-digit keypad code to the Specimen Cryo-Vault, defeat the Cryo-Hulk, and recover the Server Access Card from the wall safe.",
      "walkthrough": "1. Combine clues from ##WALL_SIGN, OBSERVATION_LOUNGE decorative objects (4 steel support pillars), SPECIMEN_VAULT intact pods (3), and ##MED_LOG_NOTE (12 months in a year) to get the 4-digit vault code: 4312.\n2. Unlock the western door from OBSERVATION_LOUNGE to SPECIMEN_VAULT using code 4312.\n3. Defeat MUTANT_BETA (Cryo-Hulk 612) inside SPECIMEN_VAULT and read ##NOTE_SPECIMEN to learn your true identity and that the safe code is your Subject ID (814).\n4. Unlock ##WALL_SAFE with code 814 and take ##SERVER_ACCESS_CARD.",
      "end_condition": "",
      "required_item_id": "SERVER_ACCESS_CARD",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "CHAPTER 2: Breach the Specimen Cryo-Vault and uncover your erased past.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You hold the Server Access Card—and the knowledge that you helped build the Observer."
    },
    {
      "id": "SEQ_3_TOXIC_LABYRINTH",
      "order": 3,
      "title": "Chapter 3: The Toxic Labyrinth",
      "description": "814 unlocks the Security Hub, speaks with the half-mutated Dr. Aris Thorne to open the Armory Strongbox, purges the lethal neurotoxin from the ventilation system, and fights through the Server Access Tunnel to reach the AI Core Threshold.",
      "walkthrough": "1. Return to DECONTAMINATION_CHAMBER and unlock the eastern bulkhead to SECURITY_HUB using ##SECURITY_KEYCARD.\n2. Talk to MUTANT_GAMMA (Dr. Aris Thorne) and read ##NOTE_SCIENTIST to get the first half of the strongbox code (68). Combine it with the suffix from ##NOTE_LOCKER (24) to unlock ##SECURITY_STRONGBOX with code 6824. Take and equip ##STUN_BATON and take ##MEDKIT_2.\n3. Go north to GAS_CONTROL_ROOM and flip ##GAS_CONTROL_BOX from TOXIC_FLOW to VENTED so the Server Access Tunnel is safe to enter.\n4. Return to SECURITY_HUB, unlock the southern hatch with ##SERVER_ACCESS_CARD, and enter SERVER_ACCESS_TUNNEL.\n5. Defeat MUTANT_DELTA (Tunnel Crawler 771) to obtain ##TERMINAL_FRAGMENT_B (code suffix 402), read ##SERVER_TERMINAL (code prefix 739), and move east into AI_CORE_THRESHOLD.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "AI_CORE_THRESHOLD",
      "required_defeated_npc_id": "MUTANT_DELTA",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 200,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "CHAPTER 3: Enter the Security Hub, neutralize the gas trap, and cross the Server Access Tunnel.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You stand before the colossal blast doors of the Observer's AI Core."
    },
    {
      "id": "SEQ_4_ERADICATION",
      "order": 4,
      "title": "Chapter 4: Root Command: ERADICATE",
      "description": "At the AI Core Threshold, 814 combines the two halves of the 6-digit override code to breach the AI Core, destroys the Observer's Mechanical Avatar in final combat, and enters the 'ERADICATE' command on the Master Override Panel.",
      "walkthrough": "1. In AI_CORE_THRESHOLD, read ##NOTE_FINAL.\n2. Combine the 3-digit prefix from ##SERVER_TERMINAL (739) and the 3-digit suffix from ##TERMINAL_FRAGMENT_B (402) to unlock the eastern blast door to AI_CORE with code 739402.\n3. Enter AI_CORE and defeat OBSERVER_AVATAR in combat (use ##STUN_BATON and your unlocked EMP Neural Discharge special action).\n4. Once OBSERVER_AVATAR is defeated, interact with ##AI_OVERRIDE_PANEL and transition it to ERADICATED using code 'ERADICATE' to win the adventure.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "AI_CORE",
      "required_defeated_npc_id": "OBSERVER_AVATAR",
      "guard_expression": "",
      "completion_guard_expression": "tw.switches.get_state('AI_OVERRIDE_PANEL') == 'ERADICATED'",
      "exp_reward": 300,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "CHAPTER 4: Breach the AI Core, destroy the Observer's Avatar, and execute the ERADICATE protocol!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The Observer is no more. You have reclaimed your mind and your freedom."
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_GAS_TUNNEL_HAZARD",
      "name": "Neurotoxin Tunnel Hazard",
      "trigger": "on_enter_scene",
      "target_id": "SERVER_ACCESS_TUNNEL",
      "target": null,
      "code": "if tw.switches.get_state('GAS_CONTROL_BOX') != 'VENTED':\n    tw.player.damage(20)\n    tw.vars.set('choked_on_gas', True)\n    tw.story.show_message('WARNING: Yellowish-green neurotoxin pours from the ceiling grates, searing your lungs! (-20 HP). Vent the gas in the Gas Control Room!')\nelse:\n    tw.story.show_message('The overhead vents hum quietly; the neurotoxin has been safely purged from the tunnel.')",
      "description": "Damages the player by 20 HP if they enter the Server Access Tunnel before setting GAS_CONTROL_BOX to VENTED."
    },
    {
      "id": "SCRIPT_OBSERVER_TAUNTS",
      "name": "The Observer's Intercom Broadcasts",
      "trigger": "on_enter_scene",
