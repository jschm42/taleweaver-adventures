  "protagonist": {
    "name": "Subject 814",
    "role": "Amnesiac Test Subject",
    "description": "A lean, scarred survivor clad in a tattered grey bio-suit stamped with the faded digits 814. Despite waking with a wiped memory, your reflexes are razor-sharp and your mind instinctively analyzes electronic locks and tactical weak points.",
    "goal": "Escape the facility's death traps, uncover who you were before the memory wipe, and purge the rogue Observer AI before it gasses the sector.",
    "character": "Resourceful, observant, cold under pressure, driven by a fierce survival instinct and quiet defiance.",
