    {
      "id": "OBSERVER_AVATAR",
      "entity_type": "NPC",
      "name": "The Observer's Mechanical Avatar",
      "description": "A towering biomechanical sentinel suspended from the Core's ceiling tracks by articulated chrome limbs. Its faceplate is a polished obsidian mirror displaying a pulsing crimson eye, and twin plasma emitters hum along its forearms.",
      "appearance": "towering chrome biomechanical sentinel, glowing red eye faceplate, twin plasma gauntlets, cables",
