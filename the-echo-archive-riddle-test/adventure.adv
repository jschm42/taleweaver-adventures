  "sequences": [
    {
      "id": "SEQ_1_BREACH_AND_RESONANCE",
      "order": 1,
      "title": "Chapter 1: The Harmonic Threshold",
      "description": "Elara begins in the Sealed Antechamber and must gather initial clues, enter the Hall of Resonance, solve the Harmonic Gear Lockbox puzzle, and obtain the First Chronos Key and Brass Service Key.",
      "walkthrough": "1. In the ANTECHAMBER, read the ##WARNING_SIGN to learn the first two digits of the Acid Relay crate code (5 letters in VANCE * 9 = 45). Open the ##SATCHEL_CACHE and take the ##SOUND_INDEX_CARD and ##OXYGEN_CANISTER.\n2. Read the ##SOUND_INDEX_CARD to learn the formula for the three-digit ##GEAR_LOCKBOX in the Hall of Resonance.\n3. Move north to RESONANCE_HALL. Read the ##RESONANCE_TABLET (which also unlocks the Harmonic Shatter special attack). Count the 7 bronze tuning pillars in the room (1st digit = 7), note the 4 marble ear-trumpet statues mentioned on the tablet (2nd digit = 4), and calculate 7 + 4 - 2 = 9 (3rd digit = 9).\n4. Unlock the ##GEAR_LOCKBOX with code 749 and take ##CHRONOS_KEY_1 and ##BRASS_SERVICE_KEY (taking ##CHRONOS_KEY_1 triggers CLOCKWORK_SENTINEL_1 if not already defeated).",
      "end_condition": "",
      "required_item_id": "CHRONOS_KEY_1",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "The archive's outer doors are sealed. Search the Antechamber and decipher the harmonic locks of the Hall of Resonance.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the First Chronos Key and Brass Service Key in hand, the deeper maintenance passages of the archive await."
    },
    {
      "id": "SEQ_2_PIPES_AND_ACID",
      "order": 2,
      "title": "Chapter 2: The Lower Relays",
      "description": "Elara explores the Library of Wax Cylinders, the Service Crawlspace, and the Acid Battery Relay to power the northern harmonic gate and recover the Second and Third Chronos Keys.",
      "walkthrough": "1. From RESONANCE_HALL, go west into LIBRARY_CYLINDERS. Open the open ##PARTS_CRATE and take the ##COPPER_BATTERY.\n2. Solve the riddle on the ##PHONOGRAPH_SAFE ('I speak without a mouth and hear without ears... What am I?') by entering the code 'echo'. Take ##CHRONOS_KEY_3 from inside.\n3. Return to RESONANCE_HALL and unlock the eastern maintenance hatch using ##BRASS_SERVICE_KEY to enter SERVICE_CRAWLSPACE.\n4. Talk to TINBEARD (or coax/trade with him) to obtain ##VANCE_DIARY_FRAGMENT, which reveals the second half of the Sealed Crate code (89). Optionally search behind the bulkhead under the workbench to reveal ##SECRET_STRONGBOX and take ##LOST_WAX_CYLINDER.\n5. Head northeast into ACID_RELAY and defeat ACID_DRONE_1. Unlock ##SEALED_CRATE using the combined 4-digit code 4589 (45 from Antechamber sign + 89 from Vance's Diary Fragment) and take ##CHRONOS_KEY_2.\n6. Activate the ##ACOUSTIC_LEVER (requires ##COPPER_BATTERY in inventory) to unlock the northern harmonic gate in RESONANCE_HALL.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.player.has_item('CHRONOS_KEY_2') and tw.player.has_item('CHRONOS_KEY_3') and tw.switches.is_state('ACOUSTIC_LEVER', 'ENGAGED')",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "You must power the Acoustic Lever in the Acid Relay and track down the next Chronos Keys.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The northern harmonic gate in the Hall of Resonance has unsealed, and three Chronos Keys hum in your pack."
    },
    {
      "id": "SEQ_3_FORGE_THE_CORE",
      "order": 3,
      "title": "Chapter 3: The Fragile Word & The Chronos Forge",
      "description": "Elara enters the Whispering Gallery, solves Vance's Reliquary riddle for the Fourth Chronos Key, and synthesizes the Master Chronos Core in the Chronos Forge.",
      "walkthrough": "1. From RESONANCE_HALL, go north through the newly unlocked harmonic gate into WHISPER_GALLERY.\n2. Read the ##MURAL_PLACARD ('What is so fragile that merely speaking its name breaks it?') and speak with GHOST_MARA if desired.\n3. Unlock ##VANCE_RELIQUARY with the code 'silence' and take ##CHRONOS_KEY_4.\n4. Go west into CHRONOS_FORGE, read ##FORGE_INSTRUCTIONS, and combine ##CHRONOS_KEY_1, ##CHRONOS_KEY_2, ##CHRONOS_KEY_3, and ##CHRONOS_KEY_4 to craft and pick up the ##MASTER_CHRONOS_CORE.",
      "end_condition": "",
      "required_item_id": "MASTER_CHRONOS_CORE",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 200,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Ascend into the Whispering Gallery to claim the final key and ignite the Chronos Forge.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The Master Chronos Core blazes with four-part harmonic energy in your grasp!"
    },
    {
      "id": "SEQ_4_VAULT_ESCAPE",
      "order": 4,
      "title": "Chapter 4: The Master Blueprint",
      "description": "Elara unlocks the Chronos Vault, claims the Master Blueprint, survives the Chronos Vault Warden, and activates the Surface Escape Lift.",
      "walkthrough": "1. Return east to WHISPER_GALLERY and unlock the northern exit to CHRONOS_VAULT using ##MASTER_CHRONOS_CORE.\n2. Enter CHRONOS_VAULT and pick up the ##MASTER_BLUEPRINT from the drafting pedestal.\n3. Defeat CLOCKWORK_SENTINEL_2 (the Chronos Vault Warden), which awakens when the blueprint is taken.\n4. Operate the ##SURFACE_LIFT_LEVER (requires ##MASTER_BLUEPRINT) to switch it to ASCENDING and win the adventure.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.player.has_item('MASTER_BLUEPRINT') and tw.vars.get('lift_activated') == True",
      "completion_guard_expression": "",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "The Great Chronos Vault Door stands before you. Claim the Master Blueprint and reach the Surface Escape Lift!",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The Surface Lift rockets toward the night sky as the Echo Archive seals behind you forever!"
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_INIT_OXYGEN",
      "name": "Initialize Oxygen Reserves",
      "trigger": "on_init",
      "target_id": null,
      "target": null,
      "code": "tw.vars.set('oxygen_ticks', 45)\ntw.vars.set('oxygen_depleted', False)",
      "description": "Initializes the protagonist's generous 45-turn oxygen counter when the session starts."
    },
    {
      "id": "SCRIPT_OXYGEN_TICK",
      "name": "Archive Atmospheric Depletion",
      "trigger": "on_turn_end",
      "target_id": null,
      "target": null,
      "code": "if not tw.vars.get('lift_activated', False):\n    ticks = tw.vars.get('oxygen_ticks', 45)\n    if tw.vars.get('bonus_oxygen', False) and not tw.vars.get('bonus_applied', False):\n        ticks = ticks + 20\n        tw.vars.set('bonus_applied', True)\n    ticks = ticks - 1\n    tw.vars.set('oxygen_ticks', ticks)\n    if ticks == 15:\n        tw.story.show_message('WARNING: Your Breath Mask gauge chimes softly—oxygen reserves at one-third capacity.')\n    elif ticks == 5:\n        tw.story.show_message('CRITICAL WARNING: Your respirator filters are nearly spent! Reach the Surface Lift immediately!')\n    elif ticks <= 0:\n        tw.vars.set('oxygen_depleted', True)\n        tw.story.show_message('Your respirator wheezes its final breath of scrubbed air as darkness closes in.')",
      "description": "Tracks the remaining oxygen in the sealed archive and adds +20 turns when the spare Oxygen Canister is found."
    },
    {
      "id": "SCRIPT_TINBEARD_COAX",
      "name": "Tinbeard Trade & Assistance",
      "trigger": "on_interact",
      "target_id": "TINBEARD",
      "target": null,
      "code": "if not tw.player.has_item('VANCE_DIARY_FRAGMENT') and not tw.vars.get('tinbeard_helped', False):\n    tw.vars.set('tinbeard_helped', True)\n    tw.player.give_item('VANCE_DIARY_FRAGMENT')\n    tw.story.show_message('Tinbeard cackles softly and presses Silas Vance\\'s oil-stained Diary Fragment into your palm: \"Here, guild-rat! Use this to crack the Acid Relay crate and get us both out of this tomb!\"')",
      "description": "Interacting with Tinbeard in the Service Crawlspace coaxes him into handing over Vance's Diary Fragment."
    }
  ]
}