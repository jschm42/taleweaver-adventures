    "title": "The Echo Archive (Riddle-Test)",
    "teaser": "In a self-sealing tomb of echoes, breath and timing matter more than steel.",
    "cover_appearance": "subterranean brass clockwork vault, glowing acoustic chimes, green mist, mysterious",
    "version": "3.0.0",
    "creator": "Jean Schmitz",
