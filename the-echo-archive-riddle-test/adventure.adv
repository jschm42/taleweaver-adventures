    {
      "id": "TINBEARD",
      "entity_type": "NPC",
      "name": "Barnaby 'Tinbeard' Grik",
      "description": "A grizzled, half-deaf former maintenance engineer who got locked inside the archive weeks ago. He wears a makeshift copper-coil beard protector and survives on condensed steam and ration tins.",
      "appearance": "elderly scavenger engineer, copper wire beard cage, grease-stained coveralls, brass goggles",
      "current_scene_id": "SERVICE_CRAWLSPACE",
      "spatial_position": "huddled beside a warm pneumatic pipe near the workbench",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_tinbeard_ebe63dab.jpg",
      "is_hidden": false,
      "npc_type": "HUMANOID",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [],
      "notes": "Knows the second half of the Sealed Crate code (89) or will gladly point Elara to his hidden strongbox if treated kindly or helped.",
      "goal": "Trade useful archive secrets for a spare Filter Canister or a Copper Battery to keep his heater running.",
      "character": "Eccentric, paranoid, raspy-voiced, yet grateful for polite company.",
      "hp": 55,
      "max_hp": 55,
      "mana": 0,
      "max_mana": 0,
      "stamina": 60,
      "max_stamina": 60,
      "is_attackable": true,
      "is_killable": false,
      "inventory": [
        {
          "id": "VANCE_DIARY_FRAGMENT",
          "name": "Silas Vance's Diary Fragment",
          "description": "A torn vellum page stained with machine oil, kept by Tinbeard in the Service Crawlspace.",
          "image_url": "/data/adventures/library/f525b72c-ba6d-4387-9e43-aa81bba74d88/visuals/reused/object/object_346ff0f4_vance-diary-frag_vance-diary-frag_vance-diary-frag_vance-diary-frag_556b0d31-7427-4c99-9138-3d7a5e7c03d2_vance-diary-frag_1783ee8f.jpg",
          "item_type": "READABLE",
          "text_log_content": "OCTOBER 14: The Guild spies think they can breach my tomb! I have split the Sealed Crate code in the Acid Relay into two halves. The first two digits are recorded on the Antechamber warning plaque; the final two digits are the year of my greatest patent: 89.\n\nAs for the Phonograph Safe in the Library, Mara loved that old riddle: what speaks without a mouth, hears without ears, and comes alive with wind? Only a single four-letter word spoken into the horn will open it.",
          "text_log_format": "DOCUMENT",
          "stat_modifier_strength": 0,
          "stat_modifier_dexterity": 0,
          "stat_modifier_intelligence": 0,
          "stat_modifier_wisdom": 0,
          "stat_modifier_charisma": 0,
          "stat_modifier_armor_class": 0,
          "hp_change": 0,
          "stamina_change": 0,
          "mana_change": 0
        }
      ],
      "metadata_json": {
        "special_actions": [
          {
            "id": "WRENCH_TOSS",
            "name": "Heavy Wrench Toss",
            "description": "Tinbeard hurls a heavy spanner at your head while cursing.",
            "action_type": "ATTACK",
            "category": "RANGED",
            "cost_type": "stamina",
            "cost": 15,
            "success_stat": "dexterity",
            "effects": [
              {
                "target": "target",
                "stat": "hp",
                "amount": "-1d8+2"
              }
            ],
            "mana_cost": 0,
            "damage_type": "ROLLED",
            "damage_value": "1d8+2",
            "outcome_description": "The heavy iron spanner clangs off your shoulder.",
            "is_locked": false,
            "on_success_script": "",
            "on_success_text": "",
            "on_failure_script": "",
            "on_failure_text": ""
          }
        ],
        "attack_mode": "PASSIVE",
        "special_chance": 30
      },
      "on_defeat_text": "'Alright, alright! Don't break my respirator! Take old Vance's diary scrap!'",
      "on_protagonist_enters_scene_text": "'Shh! Keep your voice down in the pipes, guild-rat, or the sentinels will hear your lungs!' whispers Tinbeard."
    },
