  "scenes": [
    {
      "id": "ANTECHAMBER",
      "label": "Sealed Antechamber",
      "description": "A stark octagonal stone chamber dominated by the massive, hermetically sealed blast door overhead. Brass pressure pipes snake along the walls, converging toward a heavy northern archway. The air tastes metallic and thin, and every footstep produces a crisp, lingering echo that seems to measure your weight.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_0b66b806.jpg",
      "decorative_objects": [
        "sealed overhead blast door",
        "brass pressure gauges",
        "cracked stone flagstones",
        "flickering argon wall sconce",
        "rusted drainage grate"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The pressure gauges along the wall click softly, reminding you that the archive remains sealed.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "RESONANCE_HALL",
      "label": "Hall of Resonance",
      "description": "A grand, vaulted gallery where seven towering bronze tuning pillars rise from the polished obsidian floor to the ceiling. Whenever air currents shift through the room, the pillars emit a low, haunting chord. Doorways branch off to the west, east, and north, while a narrow maintenance hatch sits low near the eastern base.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_86168cc8.jpg",
      "decorative_objects": [
        "seven towering bronze tuning pillars",
        "polished obsidian floor",
        "acoustic parabolic ceiling",
        "suspended brass chimes",
        "carved soundwave frieze"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The seven bronze tuning pillars hum in sympathetic vibration with your breathing rig.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "LIBRARY_CYLINDERS",
      "label": "Library of Wax Cylinders",
      "description": "Floor-to-ceiling brass racks hold thousands of cataloged wax phonograph cylinders in this circular archive. The scent of beeswax and machine oil is thick here. In the center stands a porcelain listening desk fitted with horn amplifiers, while shadows pool between the towering shelves.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_b94038b4.jpg",
      "decorative_objects": [
        "towering brass cylinder racks",
        "porcelain listening desk",
        "brass horn amplifiers",
        "broken wax shards",
        "rolling iron ladder"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Faint whispers seem to curl out from the thousands of wax cylinders lining the walls.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "SERVICE_CRAWLSPACE",
      "label": "Acoustic Service Crawlspace",
      "description": "A cramped, low-ceilinged maintenance tunnel running behind the main acoustic walls of the archive. Bundles of copper speaking-tubes and pneumatic pipes hiss and clatter overhead. It smells of damp rust, grease, and old solder, offering a makeshift refuge for anyone hiding from the main hall patrols.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_067b19b4.jpg",
      "decorative_objects": [
        "bundles of copper speaking-tubes",
        "hissing pneumatic pipes",
        "grease-stained workbench",
        "hanging oil lantern",
        "riveted iron bulkheads"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Steam hisses from a pipe joint as you duck into the cramped maintenance passage.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "ACID_RELAY",
      "label": "Acid Battery Relay",
      "description": "Rows of massive glass carboys filled with bubbling green electrolyte solution power the archive's acousticlocks from this chamber. Copper busbars crackle with pale arcs of static electricity above a grated catwalk, and acrid fumes curl lazily toward the ceiling vents.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_53623a5b.jpg",
      "decorative_objects": [
        "bubbling green acid carboys",
        "crackling copper busbars",
        "corroded iron catwalk",
        "emergency neutralizing shower",
        "high-voltage ceramic insulators"
      ],
      "on_enter_scene_script": "if not tw.vars.get('acid_fumes_warned', False):\n    tw.vars.set('acid_fumes_warned', True)\n    tw.story.show_message('Acrid fumes sting your eyes through the visor; your respirator filters work overtime here.')",
      "on_enter_scene_text": "Green electrolyte bubbles violently inside the glass vats around the catwalk.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "WHISPER_GALLERY",
      "label": "The Whispering Gallery",
      "description": "An elliptical dome of pale alabaster engineered so that the faintest murmur at one focal point rings clear as a bell at the other. Intricate murals depicting Silas Vance's obsession with eternal sound cover the curved walls, watching over a sunken dais in the center.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_955a7dd0.jpg",
      "decorative_objects": [
        "elliptical alabaster dome",
        "sunken acoustic dais",
        "mural of the Perpetual Engine",
        "four marble ear-Trumpet statues",
        "inlaid brass focal rings"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Your own heartbeat echoes back to you from the opposite side of the alabaster dome.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CHRONOS_FORGE",
      "label": "The Chronos Forge",
      "description": "A sweltering, copper-lined workshop where harmonic energy is bound into solid metal. At the heart of the room stands the Chronos Forge itself—an intricate induction anvil ringed by four tuning-fork slots and glowing induction coils.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_dcfd062b.jpg",
      "decorative_objects": [
        "harmonic induction coils",
        "copper-lined blast walls",
        "overhead cooling bellows",
        "quench tank of mercury-oil",
        "rack of calibration hammers"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The induction coils of the Chronos Forge thrum with dormant harmonic power.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "CHRONOS_VAULT",
      "label": "The Chronos Vault",
      "description": "The sanctum sanctorum of Silas Vance's archive. Giant pendulum blades swing in slow, hypnotic arcs behind glass walls. In the center rests a pristine glass-and-brass drafting pedestal, while at the far north end stands the caged platform of the Surface Escape Lift.",
      "image_url": "assets/the-echo-archive-riddle-t-e6xvqrpl_scene_521ce97e.jpg",
      "decorative_objects": [
        "giant swinging brass pendulums",
        "illuminated drafting pedestal",
        "caged surface escape lift",
        "vaulted celestial clockwork ceiling",
        "engraved marble seal of Silas Vance"
      ],
      "on_enter_scene_script": "tw.vars.set('reached_vault', True)",
      "on_enter_scene_text": "The great pendulums of the Chronos Vault swing with solemn, timeless precision.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
