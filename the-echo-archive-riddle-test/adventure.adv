  "protagonist": {
    "name": "Elara Vane",
    "role": "Guild Acoustic Infiltrator",
    "description": "A sharp-eyed operative of the Whisper Guild, clad in sound-dampening leather and brass-fitted filtration gear. Trained to read mechanical vibrations through her fingertips and crack arcane-clockwork vaults before the air runs thin.",
    "goal": "Retrieve Silas Vance's Master Blueprint from the Chronos Vault and escape via the surface lift before the sealed archive consumes her remaining oxygen.",
    "character": "Methodical, observant, calm under suffocating pressure, and darkly pragmatic.",
    "appearance": "lithe female infiltrator, dark braided hair, brass respirator mask, padded dark leather coat",
