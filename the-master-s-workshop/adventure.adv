  "sequences": [
    {
      "id": "SEQ_1_SCAVENGE_AND_REPAIR",
      "order": 1,
      "title": "Chapter 1: Tools of the Trade",
      "description": "Kaelen begins in the Central Workbench Hall. He must inspect the Master's Blueprints, hone his weapon if desired, venture into the Storage Closet to defeat the Haywire Drill-Rat, repair his Broken Transmitter, and recover the Tiny Brass Key.",
      "walkthrough": "1. In CENTRAL_WORKBENCH, read ##MASTER_BLUEPRINTS to unlock the Harmonic Resonance Pulse special attack and learn the Overseer Drawer riddle. Optionally pick up ##WHETSTONE and combine it with ##RUSTY_HAMMER to craft ##BALANCED_STEEL_HAMMER.\n2. Go east into STORAGE_CLOSET. Defeat HAYWIRE_DRILL_RAT_1 and pick up ##TINY_BRASS_KEY from its remains.\n3. Pick up ##SPARE_ANTENNA from the shelf and combine it with ##BROKEN_TRANSMITTER to craft ##FIXED_TRANSMITTER (completing Sequence 1).",
      "end_condition": "Complete only after Kaelen has defeated Drill-Rat Alpha (HAYWIRE_DRILL_RAT_1), explicitly recovered the physical Tiny Brass Key from its remains, and possesses the Fixed Transmitter. The initial TINY_BRASS_KEY inventory entry is only a Guild requisition record; its presence alone does not establish physical recovery.",
      "required_item_id": "TINY_BRASS_KEY",
      "required_scene_id": "",
      "required_defeated_npc_id": "HAYWIRE_DRILL_RAT_1",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Begin your investigation of the Central Workbench Hall and scavenge the Storage Closet for parts.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "With the Tiny Brass Key in hand, the stairway to the Overseer's Office is within reach."
    },
    {
      "id": "SEQ_2_OVERSEER_SECRETS",
      "order": 2,
      "title": "Chapter 2: The Overseer's Cipher",
      "description": "Kaelen unlocks the Overseer's Office, solves the three-digit combination to the Locked Overseer's Drawer using clues from the environment and blueprints, and prepares the Prototype Chamber.",
      "walkthrough": "1. Return to CENTRAL_WORKBENCH and unlock the north exit to OVERSEER_OFFICE using ##TINY_BRASS_KEY.\n2. Enter OVERSEER_OFFICE. To unlock ##LOCKED_OVERSEER_DRAWER, follow the clue from ##MASTER_BLUEPRINTS: First digit = number of copper induction coils in Central Workbench Hall (3). Second digit = number of framed guild patents in Overseer's Office (5). Third digit = sum of the first two (3 + 5 = 8). Enter code 358.\n3. Take ##SECURITY_KEYCARD, ##POWER_CORE_CASING, and ##MASTER_NOTE from the drawer. Read ##MASTER_NOTE.\n4. Flip ##CHAMBER_CONTROL_SWITCH from SURGE to SAFE to weaken the security drone in the next room.",
      "end_condition": "",
      "required_item_id": "SECURITY_KEYCARD",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "",
      "exp_reward": 150,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Ascend to the Overseer's Office and decipher the Master's security lock.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "You have recovered the Prototype Chamber Keycard and the Empty Power Core Casing!"
    },
    {
      "id": "SEQ_3_PROTOTYPE_IGNITION",
      "order": 3,
      "title": "Chapter 3: Heart of the Machine",
      "description": "Kaelen unlocks the western blast door into the Prototype Chamber, defeats the Aegis-IV Security Automaton, crafts the Calibrated Prototype Core, and activates the Master Prototype Station with his repaired transmitter ready.",
      "walkthrough": "1. Ensure you have crafted ##FIXED_TRANSMITTER (combine ##BROKEN_TRANSMITTER + ##SPARE_ANTENNA from STORAGE_CLOSET).\n2. From CENTRAL_WORKBENCH, unlock the west exit to PROTOTYPE_CHAMBER using ##SECURITY_KEYCARD and enter.\n3. Defeat SECURITY_DRONE (if ##CHAMBER_CONTROL_SWITCH was set to SAFE, the script reduces the drone's HP upon entry) and loot ##RAW_CORE_LATTICE.\n4. Combine ##POWER_CORE_CASING and ##RAW_CORE_LATTICE to craft ##CALIBRATED_PROTOTYPE_CORE.\n5. Switch ##MASTER_PROTOTYPE_STATION from DORMANT to ACTIVE using ##CALIBRATED_PROTOTYPE_CORE to complete the adventure!",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "tw.player.has_item('FIXED_TRANSMITTER')",
      "completion_guard_expression": "tw.vars.get('prototype_activated') == True and tw.player.has_item('FIXED_TRANSMITTER')",
      "exp_reward": 250,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "Breach the Prototype Chamber, claim the Raw Core Lattice, and bring the Master's invention to life.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The Master Prototype Station hums at full power as your repaired transmitter sends the telemetry to the Guild—keeping Master Corvus's secret safe!"
    }
  ],
  "scripts": [
    {
      "id": "SCRIPT_CHAMBER_SURGE_CHECK",
      "name": "Prototype Chamber Containment Surge Logic",
      "trigger": "on_enter_scene",
      "target_id": "PROTOTYPE_CHAMBER",
      "target": "PROTOTYPE_CHAMBER",
      "code": "if tw.vars.get('chamber_safe_mode', False) and not tw.vars.get('drone_weakened', False):\n    tw.vars.set('drone_weakened', True)\n    drone = tw.npcs.get('SECURITY_DRONE')\n    if drone and not drone.is_defeated:\n        drone.hp = 45\n        tw.story.show_message('Because the Chamber Containment Switch was set to SAFE, the Aegis-IV Automaton\\'s overcharged shields collapse! (Drone HP reduced to 45)')\nelif not tw.vars.get('chamber_safe_mode', False) and not tw.vars.get('surge_shocked', False):\n    tw.vars.set('surge_shocked', True)\n    tw.player.damage(10)\n    tw.story.show_message('Arc-lightning leaps from the unvented SURGE grid as you step inside! (-10 HP)')",
      "description": "Rewards the player for setting the Overseer's Chamber Containment Switch to SAFE by weakening the Security Drone, or shocks the player once if left on SURGE."
    },
    {
      "id": "SCRIPT_WORKBENCH_HINT",
      "name": "Workbench Inspection Diagnostic",
      "trigger": "on_interact",
      "target_id": "MAIN_WORKBENCH",
      "target": "MAIN_WORKBENCH",
      "code": "if not tw.vars.get('inspected_workbench', False):\n    tw.vars.set('inspected_workbench', True)\n    tw.player.modify_xp(25)\n    tw.story.show_message('You align the precision calipers on the workbench, gaining insight into the workshop\\'s assembly tolerances. (+25 XP)')",
      "description": "Grants a one-time XP bonus and narrative feedback when Kaelen inspects the Master's Central Workbench."
    }
  ]
}