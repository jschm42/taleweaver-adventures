    "title": "The Master's Workshop",
    "teaser": "A vanished inventor, a silent machine, and a workshop full of dangerous clockwork answers.",
    "cover_appearance": "steampunk arcane workshop, dormant brass prototype core, glowing blue tubes, dim amber lighting",
    "version": "3.0.0",
    "creator": "Jean Schmitz",
