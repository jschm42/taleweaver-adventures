  "scenes": [
    {
      "id": "CENTRAL_WORKBENCH",
      "label": "Central Workbench Hall",
      "description": "The heart of Master Corvus's workshop is a vaulted chamber of soot-stained brick and riveted iron beams. A massive oak workbench dominates the center of the floor, surrounded by articulated magnifying arms, vices, and scattered blueprints. To the east, a narrow sheet-metal door leads into the supply closet; to the north, a reinforced archway opens toward the Overseer's elevated office; and to the west, a heavy blast door with a card reader guards the Prototype Chamber.",
      "image_url": "assets/23676590-e88e-4e70-a42b-8adcf2d79957_scene_e49263e5.jpg",
      "decorative_objects": [
        "three tall copper induction coils along the north wall",
        "overhead brass crane rail",
        "oil-stained stone floor",
        "wall-mounted pressure gauges",
        "coolingforge basin"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The ambient hum of the three copper induction coils vibrates through the soles of your boots.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "STORAGE_CLOSET",
      "label": "Parts & Storage Closet",
      "description": "Cramped floor-to-ceiling iron shelving units pack this utilitarian room, overflowing with spare cogs, copper tubing, and glass jars of luminescent lubricant. Gnawed metal shavings litter the floorboards where malfunctioning maintenance constructs have been nesting among the crates. A heavy iron strongbox sits bolted to the lower steel shelf in the rear corner.",
      "image_url": "assets/23676590-e88e-4e70-a42b-8adcf2d79957_scene_69045966.jpg",
      "decorative_objects": [
        "floor-to-ceiling iron shelving",
        "spilled crate of brass rivets",
        "flickering cage lantern",
        "gnawed cable bundles"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "Metallic scratching echoes from behind the lower supply crates.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "OVERSEER_OFFICE",
      "label": "Overseer's Office",
      "description": "Perched half a level above the shop floor, the Overseer's office combines scholarly clutter with industrial fortification. Wide interior windows overlook the Central Workbench, while a mahogany desk with a reinforced brass drawer occupies the center of the room. Mounted beside the western bulkhead is a heavy industrial breaker console wired directly to the Prototype Chamber's containment seals.",
      "image_url": "assets/23676590-e88e-4e70-a42b-8adcf2d79957_scene_7fce647d.jpg",
      "decorative_objects": [
        "five framed guild patents on the east wall",
        "interior observation window",
        "mahogany drafting desk",
        "cold brass tea samovar",
        "Pneumatic tube terminal"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "From the elevated window, you can see the entire layout of the workshop below.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    },
    {
      "id": "PROTOTYPE_CHAMBER",
      "label": "The Prototype Chamber",
      "description": "A circular containment vault sheathed in lead-lined copper plates. At its center rises the Master Prototype Station, an intricate spire of interlocking gyroscopic rings and quartz conduits awaiting a calibrated power core. Thick power cables snake across the floor toward a recessed maintenance alcove where an autonomous security drone patrols. A brass fabrication notice reads: 'The Raw Core Lattice remains secured within the security drone. Any starting inventory entry for it is a Guild requisition record, not a usable component. Assembly of the Calibrated Prototype Core, here or elsewhere, is forbidden until the drone has been defeated and the physical lattice explicitly salvaged from its remains. The record cannot satisfy the recipe's lattice requirement.'",
      "image_url": "assets/23676590-e88e-4e70-a42b-8adcf2d79957_scene_b4ceaa82.jpg",
      "decorative_objects": [
        "interlocking brass gyroscopic rings",
        "lead-lined copper containment walls",
        "overhead arc-discharge rods",
        "floor-mounted cooling vents"
      ],
      "on_enter_scene_script": null,
      "on_enter_scene_text": "The air inside the containment vault crackles with static electricity.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
