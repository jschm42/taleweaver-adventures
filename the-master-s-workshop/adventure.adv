  "protagonist": {
    "name": "Kaelen Voss",
    "role": "Guild Artificer-Investigator",
    "description": "A sharp-eyed investigator and field artificer of the High Guild, dispatched to uncover the fate of Master Corvus and secure his dormant final invention before rival factions or malfunctioning machinery claim it.",
