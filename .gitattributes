# Normalise line endings for text files (adventure blueprints, docs, JSON).
* text=auto

# Always LF, also on Windows checkouts: library.json records the byte size of each
# adventure as the app downloads it from GitHub, and that must not depend on the OS.
*.adv text eol=lf
*.json text eol=lf

# Adventure bundles are binary ZIP containers; never diff, merge or eol-convert them.
*.adz binary -diff -merge

# Scene/portrait artwork is binary; keep git out of it.
*.jpg binary
*.jpeg binary
*.png binary
